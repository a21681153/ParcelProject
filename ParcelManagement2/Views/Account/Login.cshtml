@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>系統登入 - 社區包裹管理系統</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* ✅ CSS變數定義 - 比照Packages色系 */
        :root {
            --admin-primary: #2c3e50;
            --admin-secondary: #34495e;
            --admin-primary-dark: #1a252f;
            --admin-accent: #3498db;
            --admin-light: #7f8c8d;
            --border-color: #bdc3c7;
            --card-radius: 12px;
            --status-pending: #e74c3c;
            --status-collected: #27ae60;
        }

        /* ✅ 重置所有邊距和填充 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ✅ HTML 和 Body 充滿全螢幕 */
        html, body {
            height: 100%;
            width: 100%;
            overflow-x: hidden;
        }

        /* ✅ Body 背景和佈局 - 使用深色主題 */
        body {
            background: linear-gradient(135deg, var(--admin-primary) 0%, var(--admin-secondary) 100%);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
        }

        /* ✅ 登入容器 - 深色主題風格 */
        #LoginApp {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(15px);
            border-radius: var(--card-radius);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            padding: 40px;
            width: 100%;
            max-width: 420px;
            margin: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            z-index: 2;
        }

        /* ✅ 標題優化 - 使用主色調 */
        .login-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--admin-primary);
            margin-bottom: 8px;
            text-align: center;
        }

        .login-subtitle {
            color: var(--admin-light);
            font-size: 0.9rem;
            font-weight: 500;
            text-align: center;
            margin-bottom: 30px;
        }

        /* ✅ 表單標籤優化 */
        .form-label {
            font-weight: 600;
            color: var(--admin-primary);
            font-size: 14px;
            margin-bottom: 8px;
        }

        /* ✅ 輸入框優化 - 深色主題風格 */
        .form-control {
            padding: 12px 16px;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: white;
            color: var(--admin-primary);
        }

            .form-control:focus {
                border-color: var(--admin-accent);
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.15);
                transform: translateY(-1px);
                outline: none;
            }

            .form-control::placeholder {
                color: var(--admin-light);
                font-weight: 400;
            }

        /* ✅ 表單組間距 */
        .mb-3 {
            margin-bottom: 20px;
        }

        /* ✅ 登入按鈕優化 - 使用主色系 */
        .btn-login {
            background: linear-gradient(135deg, var(--admin-primary) 0%, var(--admin-secondary) 100%);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            padding: 14px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .btn-login:hover {
                background: linear-gradient(135deg, var(--admin-primary-dark) 0%, var(--admin-primary) 100%);
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(44, 62, 80, 0.3);
            }

            .btn-login:active {
                transform: translateY(0);
            }

            .btn-login:focus {
                box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.3);
                outline: none;
            }

            /* ✅ 載入按鈕狀態 */
            .btn-login:disabled {
                background: var(--admin-light);
                cursor: not-allowed;
                transform: none;
            }

        /* ✅ 載入 spinner 優化 */
        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
        }

        /* ✅ 錯誤訊息優化 - 使用主色系 */
        .alert-danger {
            background: rgba(231, 76, 60, 0.1);
            border: 1px solid var(--status-pending);
            color: #c0392b;
            border-radius: 8px;
            font-size: 14px;
            padding: 12px 16px;
        }

        /* ✅ 帳號提示優化 - 使用主色系 */
        .login-hint {
            text-align: center;
            margin-top: 25px;
            padding: 15px;
            background: rgba(52, 152, 219, 0.1);
            border-radius: 8px;
            border-left: 4px solid var(--admin-accent);
        }

            .login-hint small {
                color: var(--admin-accent);
                font-weight: 500;
            }

        /* ✅ 版權資訊 - 深色主題 */
        .copyright {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255, 255, 255, 0.9);
            font-size: 12px;
            text-align: center;
            z-index: 1;
            font-weight: 500;
        }

        /* ✅ 裝飾性背景元素 - 深色主題 */
        .bg-decoration {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            z-index: 1;
        }

            .bg-decoration.top-left {
                top: -100px;
                left: -100px;
                width: 200px;
                height: 200px;
                background: rgba(52, 152, 219, 0.1);
            }

            .bg-decoration.bottom-right {
                bottom: -100px;
                right: -100px;
                width: 150px;
                height: 150px;
                background: rgba(255, 255, 255, 0.05);
            }

            /* ✅ 添加更多裝飾元素 */
            .bg-decoration.middle-left {
                top: 50%;
                left: -50px;
                width: 100px;
                height: 100px;
                background: rgba(52, 62, 80, 0.1);
                transform: translateY(-50%);
            }

            .bg-decoration.top-right {
                top: -50px;
                right: -50px;
                width: 120px;
                height: 120px;
                background: rgba(52, 152, 219, 0.08);
            }

        /* ✅ 輸入框聚焦效果增強 */
        .form-control:hover {
            border-color: var(--admin-secondary);
        }

        /* ✅ 按鈕載入狀態動畫 */
        .btn-login .spinner-border {
            color: rgba(255, 255, 255, 0.8);
        }

        /* ✅ 表單容器陰影效果 */
        #LoginApp::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(45deg, var(--admin-accent), var(--admin-primary), var(--admin-secondary));
            border-radius: calc(var(--card-radius) + 2px);
            z-index: -1;
            opacity: 0.1;
        }

        /* ✅ 響應式設計 */
        .mobile-responsive #LoginApp {
            padding: 30px 25px;
            margin: 15px;
            border-radius: 10px;
        }

        .mobile-responsive .login-title {
            font-size: 1.5rem;
        }

        .mobile-responsive .form-control {
            padding: 10px 14px;
            font-size: 14px;
        }

        .mobile-responsive .btn-login {
            padding: 12px;
            font-size: 15px;
        }

        .small-responsive #LoginApp {
            padding: 25px 20px;
            margin: 10px;
            border-radius: 8px;
        }

        .small-responsive .login-title {
            font-size: 1.3rem;
        }

        .small-responsive .form-control {
            padding: 8px 12px;
            font-size: 13px;
        }

        .small-responsive .btn-login {
            padding: 10px;
            font-size: 14px;
        }

        /* ✅ 動畫效果 - 優化 */
        .fade-in {
            animation: fadeInUp 0.8s ease-out;
        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .animated-fade {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

            .animated-fade.show {
                opacity: 1;
                transform: translateY(0);
            }

        /* ✅ 輸入框圖標效果 */
        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--admin-light);
            z-index: 3;
            font-size: 16px;
        }

        .form-control.with-icon {
            padding-left: 45px;
        }

        /* ✅ 登入按鈕懸浮效果 */
        .btn-login::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.5s;
        }

        .btn-login:hover::before {
            left: 100%;
        }

        /* ✅ 標題下劃線效果 */
        .login-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 3px;
            background: var(--admin-accent);
            margin: 10px auto;
            border-radius: 2px;
        }
    </style>
</head>
<body>
    <!-- ✅ 裝飾性背景元素 -->
    <div class="bg-decoration top-left"></div>
    <div class="bg-decoration bottom-right"></div>
    <div class="bg-decoration middle-left"></div>
    <div class="bg-decoration top-right"></div>

    <!-- ✅ 登入應用容器 -->
    <div id="LoginApp" class="animated-fade">
        <!-- ✅ 系統標題 -->
        <h1 class="login-title">系統登入</h1>
        <p class="login-subtitle">社區包裹管理系統</p>

        @Html.AntiForgeryToken()

        <form id="loginForm">
            <div class="mb-3">
                <label for="username" class="form-label">帳號</label>
                <div class="input-group">
                    <input id="username"
                           v-model="form.username"
                           class="form-control"
                           type="text"
                           placeholder="請輸入帳號"
                           autocomplete="username"
                           required>
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">密碼</label>
                <div class="input-group">
                    <input id="password"
                           v-model="form.password"
                           class="form-control"
                           type="password"
                           placeholder="請輸入密碼"
                           autocomplete="current-password"
                           required>
                </div>
            </div>

            <div v-if="errorMessage" class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                {{ errorMessage }}
            </div>

            <button type="submit"
                    class="btn btn-primary btn-login w-100"
                    id="loginButton"
                    v-bind:disabled="isLoading">
                <span id="loginSpinner" class="spinner-border spinner-border-sm me-2" v-show="isLoading"></span>
                <span id="loginText">{{ isLoading ? '登入中...' : '登入' }}</span>
            </button>
        </form>

        <!-- ✅ 帳號提示區域 -->
        <div class="login-hint">
            <small class="text-muted">請使用您的系統帳號登入</small>
        </div>
    </div>

    <!-- ✅ 版權資訊 -->
    <div class="copyright">
        © 2025 社區包裹管理系統. All rights reserved.
    </div>

    <!-- ✅ JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script>
        // ✅ 響應式處理
        function handleResponsive() {
            const body = document.body;
            const width = window.innerWidth;

            body.classList.remove('mobile-responsive', 'small-responsive');

            if (width <= 480) {
                body.classList.add('small-responsive');
            } else if (width <= 768) {
                body.classList.add('mobile-responsive');
            }
        }

        // ✅ 頁面載入動畫
        document.addEventListener('DOMContentLoaded', function() {
            handleResponsive();
            window.addEventListener('resize', handleResponsive);

            // 顯示淡入動畫
            setTimeout(function() {
                document.getElementById('LoginApp').classList.add('show');
            }, 200);
        });
    </script>
    <script src="~/Scripts/login.js"></script>
</body>
</html>
