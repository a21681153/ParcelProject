@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>系統登入 - 社區包裹管理系統</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #B4CAFA;
            --primary-dark: #8BB0F7;
            --primary-light: #D6E5FD;
            --secondary: #A8E6CF;
            --accent: #FFD93D;
            --text-primary: #2C3E50;
            --text-secondary: #5A6C7D;
            --border-color: #A0BDF8;
            --card-radius: 16px;
            --status-pending: #e74c3c;
            --status-collected: #27ae60;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            width: 100%;
            overflow-x: hidden;
        }

        body {
            background: linear-gradient(135deg, #E8F4FD 0%, #F0F9FF 25%, #FEFCBF 50%, #E8F5E8 75%, #F8F0FF 100% );
            background-attachment: fixed;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            animation: backgroundShift 20s ease-in-out infinite;
        }

        @@keyframes backgroundShift {
            0%, 100%

        {
            background: linear-gradient(135deg, #E8F4FD 0%, #F0F9FF 25%, #FEFCBF 50%, #E8F5E8 75%, #F8F0FF 100%);
        }

        50% {
            background: linear-gradient(135deg, #F8F0FF 0%, #E8F5E8 25%, #E8F4FD 50%, #FEFCBF 75%, #F0F9FF 100%);
        }

        }
        .big-bubble {
            position: absolute;
            border-radius: 50%;
            pointer-events: auto;
            z-index: 1;
            cursor: pointer;
            transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

            .big-bubble:nth-child(1) {
                width: 200px;
                height: 200px;
                background: radial-gradient(circle at 30% 30%, rgba(180, 202, 250, 0.4), rgba(180, 202, 250, 0.1));
                top: 15%;
                left: 10%;
                animation: floatBig 12s ease-in-out infinite;
                backdrop-filter: blur(2px);
            }

            .big-bubble:nth-child(2) {
                width: 150px;
                height: 150px;
                background: radial-gradient(circle at 30% 30%, rgba(168, 230, 207, 0.35), rgba(168, 230, 207, 0.1));
                top: 20%;
                right: 15%;
                animation: floatBig 15s ease-in-out infinite reverse;
                backdrop-filter: blur(2px);
            }

            .big-bubble:nth-child(3) {
                width: 180px;
                height: 180px;
                background: radial-gradient(circle at 30% 30%, rgba(255, 217, 61, 0.3), rgba(255, 217, 61, 0.08));
                bottom: 25%;
                left: 15%;
                animation: floatBig 18s ease-in-out infinite;
                backdrop-filter: blur(2px);
            }

            .big-bubble:nth-child(4) {
                width: 120px;
                height: 120px;
                background: radial-gradient(circle at 30% 30%, rgba(255, 182, 193, 0.4), rgba(255, 182, 193, 0.1));
                bottom: 15%;
                right: 20%;
                animation: floatBig 14s ease-in-out infinite reverse;
                backdrop-filter: blur(2px);
            }

            .big-bubble:hover {
                transform: scale(1.3) translateY(-20px);
                filter: brightness(1.2);
                box-shadow: 0 20px 40px rgba(180, 202, 250, 0.3), inset 0 0 20px rgba(255, 255, 255, 0.3);
            }

            .big-bubble:active {
                transform: scale(0.9);
            }

        @@keyframes floatBig {
            0%, 100%

        {
            transform: translate(0, 0) scale(1);
            opacity: 0.7;
        }

        25% {
            transform: translate(30px, -40px) scale(1.1);
            opacity: 0.9;
        }

        50% {
            transform: translate(-20px, -30px) scale(0.9);
            opacity: 0.6;
        }

        75% {
            transform: translate(15px, -50px) scale(1.05);
            opacity: 0.8;
        }

        }

        #LoginApp {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(25px);
            border-radius: var(--card-radius);
            box-shadow: 0 25px 50px rgba(139, 176, 247, 0.25), 0 10px 25px rgba(168, 230, 207, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.3);
            padding: 45px;
            width: 100%;
            max-width: 450px;
            margin: 20px;
            position: relative;
            z-index: 10;
            border: 2px solid rgba(180, 202, 250, 0.2);
        }

        .login-title {
            font-size: 2rem;
            font-weight: 800;
            color: var(--primary-dark);
            margin-bottom: 12px;
            text-align: center;
            text-shadow: 0 2px 8px rgba(139, 176, 247, 0.3);
            letter-spacing: -0.5px;
        }

        .login-subtitle {
            color: var(--text-secondary);
            font-size: 1rem;
            font-weight: 500;
            text-align: center;
            margin-bottom: 35px;
            opacity: 0.8;
        }

        .form-label {
            font-weight: 700;
            color: var(--text-primary);
            font-size: 15px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .form-label::before {
                content: '●';
                color: var(--primary);
                font-size: 12px;
            }

        .form-control {
            padding: 16px 20px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.4s ease;
            background: rgba(255, 255, 255, 0.95);
            color: var(--text-primary);
            backdrop-filter: blur(10px);
            box-shadow: inset 0 2px 4px rgba(180, 202, 250, 0.1);
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(180, 202, 250, 0.2), 0 8px 25px rgba(139, 176, 247, 0.15), inset 0 2px 4px rgba(180, 202, 250, 0.1);
                transform: translateY(-2px);
                outline: none;
                background: rgba(255, 255, 255, 0.98);
            }

            .form-control::placeholder {
                color: var(--text-secondary);
                font-weight: 400;
                opacity: 0.7;
            }

            .form-control:hover {
                border-color: var(--primary-dark);
                background: rgba(255, 255, 255, 0.98);
                transform: translateY(-1px);
                box-shadow: 0 4px 15px rgba(139, 176, 247, 0.1), inset 0 2px 4px rgba(180, 202, 250, 0.1);
            }

        .mb-3 {
            margin-bottom: 25px;
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 50%, var(--secondary) 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 17px;
            font-weight: 700;
            padding: 16px;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(139, 176, 247, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .btn-login:hover {
                background: linear-gradient(135deg, var(--primary-dark) 0%, #6B8FF7 50%, var(--secondary) 100%);
                transform: translateY(-3px) scale(1.02);
                box-shadow: 0 12px 35px rgba(139, 176, 247, 0.5), 0 6px 20px rgba(168, 230, 207, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.4);
            }

            .btn-login:active {
                transform: translateY(-1px) scale(1.01);
            }

            .btn-login:focus {
                box-shadow: 0 0 0 4px rgba(180, 202, 250, 0.3), 0 12px 35px rgba(139, 176, 247, 0.5);
                outline: none;
            }

            .btn-login:disabled {
                background: linear-gradient(135deg, #9CA3AF, #6B7280);
                cursor: not-allowed;
                transform: none;
            }

        .spinner-border-sm {
            width: 1.2rem;
            height: 1.2rem;
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            border: 2px solid #FCA5A5;
            color: #DC2626;
            border-radius: 12px;
            font-size: 14px;
            padding: 16px 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.1);
        }

        .login-hint {
            text-align: center;
            margin-top: 30px;
            padding: 20px;
            background: linear-gradient(135deg, rgba(180, 202, 250, 0.15), rgba(168, 230, 207, 0.1));
            border-radius: 12px;
            border: 2px solid rgba(180, 202, 250, 0.2);
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

            .login-hint::before {
                content: '💡';
                position: absolute;
                top: 10px;
                right: 15px;
                font-size: 18px;
                opacity: 0.7;
            }

            .login-hint small {
                color: var(--primary-dark);
                font-weight: 600;
                font-size: 14px;
            }

        .copyright {
            position: absolute;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--text-primary);
            font-size: 13px;
            text-align: center;
            z-index: 5;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(255, 255, 255, 0.8);
            opacity: 0.8;
        }

        #LoginApp::before {
            content: '';
            position: absolute;
            top: -3px;
            left: -3px;
            right: -3px;
            bottom: -3px;
            background: linear-gradient(45deg, var(--primary), var(--secondary), var(--accent), var(--primary-light));
            border-radius: calc(var(--card-radius) + 3px);
            z-index: -1;
            opacity: 0.1;
            filter: blur(1px);
        }

        .fade-in {
            animation: fadeInUp 1s ease-out;
        }

        @@media (max-width: 768px) {
            .big-bubble:nth-child(1)

        {
            width: 120px;
            height: 120px;
        }

        .big-bubble:nth-child(2) {
            width: 100px;
            height: 100px;
        }

        .big-bubble:nth-child(3) {
            width: 110px;
            height: 110px;
        }

        .big-bubble:nth-child(4) {
            width: 80px;
            height: 80px;
        }

        }

        @@media (max-width: 480px) {
            #LoginApp

        {
            padding: 35px 30px;
            margin: 15px;
            border-radius: 14px;
        }

        .login-title {
            font-size: 1.7rem;
        }

        .form-control {
            padding: 14px 18px;
            font-size: 15px;
        }

        .btn-login {
            padding: 14px;
            font-size: 16px;
        }

        .big-bubble {
            display: none;
        }

        }

        @@media (max-width: 320px) {
            #LoginApp

        {
            padding: 30px 25px;
            margin: 10px;
            border-radius: 12px;
        }

        .login-title {
            font-size: 1.5rem;
        }

        .form-control {
            padding: 12px 16px;
            font-size: 14px;
        }

        .btn-login {
            padding: 12px;
            font-size: 15px;
        }

        }
    </style>



</head>
<body>
    <div class="big-bubble"></div>
    <div class="big-bubble"></div>
    <div class="big-bubble"></div>
    <div class="big-bubble"></div>


    <div id="LoginApp" class="animated-fade">

        <h1 class="login-title">系統登入</h1>
        <p class="login-subtitle">社區包裹管理系統</p>

        @Html.AntiForgeryToken()

        <form id="loginForm">
            <div class="mb-3">
                <label for="username" class="form-label">帳號</label>
                <div class="input-group">
                    <input id="username"
                           v-model="form.username"
                           class="form-control"
                           type="text"
                           placeholder="請輸入帳號"
                           autocomplete="username"
                           required>
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">密碼</label>
                <div class="input-group">
                    <input id="password"
                           v-model="form.password"
                           class="form-control"
                           type="password"
                           placeholder="請輸入密碼"
                           autocomplete="current-password"
                           required>
                </div>
            </div>

            <div v-if="errorMessage" class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                {{ errorMessage }}
            </div>

            <button type="submit"
                    class="btn btn-primary btn-login w-100"
                    id="loginButton"
                    v-bind:disabled="isLoading">
                <span id="loginSpinner" class="spinner-border spinner-border-sm me-2" v-show="isLoading"></span>
                <span id="loginText">{{ isLoading ? '登入中...' : '登入' }}</span>
            </button>
        </form>

        <!-- 帳號提示區域 -->
        <div class="login-hint">
            <small class="text-muted">請使用您的系統帳號登入</small>
        </div>
    </div>

    <!-- 版權資訊 -->
    <div class="copyright">
        © 2025 社區包裹管理系統. All rights reserved.
    </div>

    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script>
        function handleResponsive() {
            const body = document.body;
            const width = window.innerWidth;

            body.classList.remove('mobile-responsive', 'small-responsive');

            if (width <= 480) {
                body.classList.add('small-responsive');
            } else if (width <= 768) {
                body.classList.add('mobile-responsive');
            }
        }

        // 頁面載入動畫
        document.addEventListener('DOMContentLoaded', function() {
            handleResponsive();
            window.addEventListener('resize', handleResponsive);
            // 顯示淡入動畫
            setTimeout(function() {
                document.getElementById('LoginApp').classList.add('show');
            }, 200);
        });
    </script>
    <script src="~/Scripts/login.js"></script>
</body>
</html>
