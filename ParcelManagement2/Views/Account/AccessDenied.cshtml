@{
    ViewData["Title"] = ViewBag.Title;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> 存取被拒絕
                    </h4>
                </div>
                <div class="card-body text-center">
                    <p class="card-text">@ViewBag.Message</p>
                    <p class="text-muted">您沒有拜訪此網頁的權限，請重新登入。</p>
                    <div class="mt-3">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt"></i> 重新登入
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary ml-2">
                            <i class="fas fa-home"></i> 回到首頁
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
