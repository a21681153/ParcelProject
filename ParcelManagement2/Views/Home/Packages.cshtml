<!-- 互動/動畫-->
<script>
    // Ripple effect（套用到 .btn 與 .status-pill）
    (function () {
      function addRipple(e, targetEl) {
        const target = targetEl;
        if (!target || typeof target.getBoundingClientRect !== 'function') return;

        const rect = target.getBoundingClientRect();
        const ink = document.createElement('span');
        ink.className = 'ripple-ink';

        const size = Math.max(rect.width, rect.height);
        ink.style.width = ink.style.height = size + 'px';

        const x = e.clientX - rect.left - size / 2;
        const y = e.clientY - rect.top - size / 2;
        ink.style.left = x + 'px';
        ink.style.top = y + 'px';

        // 確保容器有相對定位
        const prevPos = getComputedStyle(target).position;
        if (prevPos === 'static') target.style.position = 'relative';

        target.appendChild(ink);
        setTimeout(() => {
          if (prevPos === 'static') target.style.position = '';
          ink.remove();
        }, 650);
      }
      // 點擊 .btn 與 .status-pill 時觸發 ripple
      document.addEventListener('click', function (e) {
        const el = e.target.closest('.btn, .status-pill');
        if (!el) return;
        if (el.classList.contains('disabled') || el.getAttribute('aria-disabled') === 'true') return;
        addRipple(e, el);
      });
    })();
    // 觀察表格更新，重新套用列動畫延遲
    (function () {
      const tableBody = document.querySelector('.admin-table-container tbody');
      if (!tableBody) return;
      const observer = new MutationObserver(() => {
        document.querySelectorAll('tbody tr.row-pop').forEach((tr, i) => {
          tr.style.animationDelay = (i * 40) + 'ms';
        });
      });
      observer.observe(tableBody, { childList: true });
    })();
</script>