@{
    var date = DateTime.Now.ToString("MMdd");
}

<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
        --admin-primary: #3F9E95;
        --admin-secondary: #7FCFC3;
        --admin-primary-dark: #2F847C;
        --admin-accent: #CFC7BB;
        --admin-light: #9FB1B1;
        --border-color: #E7E3DA;
        --card-radius: 16px;
        --status-pending: #E74C3C;
        --status-collected: #2ECC71;
        --label-h: 26px;
        --ctl-h: 44px;
        --cream: #FFF7E6;
        --cream-border: #F0E6D6;
    }

    body {
        font-size: 16px
    }

    .page-title {
        font-size: 1.4rem;
        color: var(--admin-primary)
    }

        .page-title i {
            color: var(--admin-accent)
        }

    .table th, .table td {
        font-size: 15px;
        text-align: center
    }

    .form-label, .form-select, .btn, .pickup-time, .resident-name, .package-id,
    .package-type-badge, .package-status-pending, .package-status-collected,
    .status-badge-pending, .status-badge-collected {
        font-size: 15px;
        text-align: center
    }

    /* 清單容器與表頭 */
    .admin-table-container {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: var(--card-radius);
        box-shadow: 0 8px 24px rgba(63,158,149,.08);
        overflow: hidden;
        position: relative
    }

    .table-responsive {
        max-height: calc(100vh - 260px);
        overflow: auto;
        -webkit-overflow-scrolling: touch;
        position: relative
    }

    .table thead {
        position: relative;
        z-index: 5
    }

        .table thead th {
            position: sticky;
            top: 0;
            z-index: 5;
            background: linear-gradient(180deg,var(--admin-primary),#388F87);
            color: #fff;
            border-color: var(--admin-primary);
            white-space: nowrap;
            box-shadow: 0 2px 0 rgba(0,0,0,.05)
        }

            .table thead th i {
                margin-right: 10px;
                color: #E6F6F4;
                font-size: 13px;
                vertical-align: middle
            }

            .table thead th:first-child {
                border-top-left-radius: calc(var(--card-radius) - 2px)
            }

            .table thead th:last-child {
                border-top-right-radius: calc(var(--card-radius) - 2px)
            }

    .table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0
    }

        .table th, .table td {
            border: 1px solid var(--border-color);
            color: #1E2A2A;
            background: #fff;
            vertical-align: middle
        }

        .table tbody tr:hover {
            background: rgba(127,207,195,.12)
        }

            .table tbody tr:hover td:first-child {
                border-top-left-radius: 10px;
                border-bottom-left-radius: 10px
            }

            .table tbody tr:hover td:last-child {
                border-top-right-radius: 10px;
                border-bottom-right-radius: 10px
            }

    /* 導覽列 */
    .admin-tabs .nav-link {
        background: var(--admin-primary);
        border-color: var(--admin-primary);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .admin-tabs .nav-link:not(.active) {
            background: var(--admin-secondary);
            border-color: var(--admin-secondary);
            color: #0E2523
        }

        .admin-tabs .nav-link:hover, .admin-tabs .nav-link:focus {
            background: var(--admin-primary-dark);
            border-color: var(--admin-primary-dark);
            color: #fff
        }

        .admin-tabs .nav-link.active {
            background: var(--admin-primary);
            border-color: var(--admin-primary);
            color: #fff
        }

        /* 導覽列動態底線 */
        .admin-tabs .nav-link::after {
            content: "";
            position: absolute;
            left: 10%;
            right: 10%;
            bottom: 4px;
            height: 3px;
            border-radius: 3px;
            background: rgba(255,255,255,.85);
            transform: scaleX(0);
            transform-origin: center;
            transition: transform .25s ease;
        }

        .admin-tabs .nav-link.active::after {
            transform: scaleX(1);
        }

    /* 包裹種類 */
    .package-type-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-weight: 700;
        line-height: 1;
        box-shadow: 0 1px 0 rgba(0,0,0,.04);
        transition: transform .15s,box-shadow .15s
    }

        .package-type-badge:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(0,0,0,.1)
        }

    .package-type-parcel {
        background: #E7F7F4 !important;
        color: #2C7E77 !important;
        border-color: #2C7E77 !important
    }

    .package-type-letter {
        background: #FFE6CC !important;
        color: #C76B16 !important;
        border-color: #E5924A !important
    }

    /* 狀態 */
    .status-badge-pending {
        background: #fff5f5;
        border: 1px solid var(--status-pending);
        color: var(--status-pending)
    }

    .status-badge-collected {
        background: #f0fff4;
        border: 1px solid var(--status-collected);
        color: var(--status-collected)
    }

    .status-display-wrapper .package-status-pending {
        color: var(--status-pending) !important;
        font-weight: 700
    }

    .status-display-wrapper .package-status-collected {
        color: var(--status-collected) !important;
        font-weight: 700
    }

    /* 包裹編號 */
    .package-id {
        background: transparent;
        border: none;
        font-family: inherit;
        font-weight: 700;
        color: #1E2A2A;
        padding: 0
    }

    /* 卷軸 */
    .table-responsive::-webkit-scrollbar {
        width: 8px;
        height: 8px
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #F1F1F1;
        border-radius: 4px
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--admin-secondary);
        border-radius: 4px
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: var(--admin-primary)
        }

    /* 卡片 */
    .admin-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: var(--card-radius);
        box-shadow: 0 8px 20px rgba(63,158,149,.06);
        padding: 16px;
        margin-bottom: 16px;
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(63,158,149,.12);
        }

    .filter-bar {
        display: grid;
        grid-template-columns: auto 320px auto minmax(340px,1fr) auto;
        gap: 16px;
        align-items: center;
    }

    .lbl-inline {
        font-weight: 800;
        font-size: 17px;
        color: #1E2A2A;
        line-height: var(--ctl-h);
        display: flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    /* 住戶下拉 */
    .combo-wrap {
        position: relative
    }

        .combo-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            color: var(--admin-primary);
            pointer-events: none
        }

        .combo-wrap select.form-select {
            padding-left: 40px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            min-height: var(--ctl-h)
        }

            .combo-wrap select.form-select:focus {
                border-color: var(--admin-primary);
                box-shadow: 0 0 0 .15rem rgba(63,158,149,.15)
            }

    /* 可選狀態 + 提示 */
    .status-inline {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: var(--ctl-h);
        justify-content: flex-start;
    }

    .status-hint-inline {
        font-size: 13px;
        line-height: 1.2;
        color: #7A8A8A;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .status-hint-inline i {
            color: #C08917;
        }

    .status-label-inline {
        font-weight: 800;
        font-size: 17px;
        color: #1E2A2A;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .status-pills {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        flex-wrap: wrap;
    }

    .status-pill {
        border: 1px solid var(--border-color);
        padding: 9px 14px;
        border-radius: 999px;
        background: #fff;
        font-weight: 700;
        cursor: pointer;
        user-select: none;
        position: relative;
        overflow: hidden;
        transition: transform .12s ease, box-shadow .12s ease;
    }

        .status-pill:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0,0,0,.06);
        }

        .status-pill[data-active="true"] {
            border-color: var(--admin-primary);
            background: #E7F7F4;
            color: #2C7E77;
            animation: pill-bounce .35s ease;
        }

        .status-pill[data-type="pending"][data-active="true"] {
            background: #fff5f5;
            border-color: var(--status-pending);
            color: var(--status-pending)
        }

        .status-pill[data-type="done"][data-active="true"] {
            background: #f0fff4;
            border-color: var(--status-collected);
            color: var(--status-collected)
        }

        .status-pill.disabled {
            background: #F4F1E7;
            border-color: #E7E3DA;
            color: #9BA6A6;
            cursor: not-allowed;
            box-shadow: none
        }

            .status-pill.disabled:hover {
                transform: none;
                box-shadow: none
            }

    .filter-hint {
        font-size: 13px;
        line-height: 1.2;
        text-align: center;
        color: #7A8A8A
    }

        .filter-hint i {
            color: #C08917
        }

    .invisible {
        visibility: hidden
    }

    .filter-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end
    }

        .filter-actions .btn {
            min-height: var(--ctl-h);
            border-radius: 10px;
            position: relative;
            overflow: hidden;
        }

    .btn-clear {
        background: #fff;
        border: 1px solid var(--border-color);
        color: #2a3a3a
    }

        .btn-clear:hover {
            background: #F4F1E7
        }

    /* 統計 */
    .summary-bar {
        background: linear-gradient(135deg, #FFF9F0 0%, #F7F3EB 100%);
        border: 1px solid #EDE6D8;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(63,158,149,.06);
        padding: 26px 18px;
        margin-top: 12px;
        opacity: 0;
        transform: translateY(6px);
        animation: fade-in-up .5s ease forwards .1s;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        align-items: center;
    }

    .summary-item {
        text-align: center;
        padding: 6px 8px;
        transition: transform .15s ease;
    }

        .summary-item:hover {
            transform: translateY(-2px) scale(1.01);
        }

        .summary-item .value {
            font-weight: 800;
            font-size: 36px;
            line-height: 1;
            margin-bottom: 8px;
            color: #1F2A2A; 
        }

            .summary-item .value.is-pending {
                color: #E74C3C;
            }
            /* 未取：紅 */
            .summary-item .value.is-done {
                color: #2ECC71;
            }
            /* 已取：綠 */
            .summary-item .value.is-time {
                font-size: 22px; 
                font-weight: 700;
            }

        .summary-item .label {
            font-size: 18px;
            color: #2A3A3A;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .summary-item .label.label-red {
                color: #E74C3C;
            }

            .summary-item .label.label-green {
                color: #2ECC71;
            }

            .summary-item .label i {
                opacity: .9;
            }

    /* RWD */
    @@media (max-width: 992px) {
        .summary-row {
            grid-template-columns: 1fr 1fr;
            row-gap: 18px;
        }
    }

    @@media (max-width: 576px) {
        .summary-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width:992px) {
        .status-inline {
            flex-wrap: wrap;
        }

        .status-hint-inline {
            order: 0;
            width: 100%;
        }

        .status-label-inline {
            order: 1;
        }

        .status-pills {
            order: 2;
        }
    }

    /* 互動/動畫新增*/

    /* 逐列滑入（套在 <tr>） */
    @@keyframes row-pop {
        from

    {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .row-pop {
        opacity: 0;
        animation: row-pop .35s ease forwards;
    }

    /* 統計卡片 淡入上移 */
    @@keyframes fade-in-up {
        from

    {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* 狀態 pill 啟用小彈跳 */
    @@keyframes pill-bounce {
        0%

    {
        transform: translateY(0) scale(1);
    }

    40% {
        transform: translateY(-2px) scale(1.03);
    }

    100% {
        transform: translateY(0) scale(1);
    }

    }

    .ripple-ink {
        position: absolute;
        border-radius: 50%;
        transform: scale(0);
        background: rgba(255,255,255,.55);
        pointer-events: none;
        animation: ripple .6s ease-out forwards;
        mix-blend-mode: screen;
    }
    @@keyframes ripple {
        to

    {
        transform: scale(3.5);
        opacity: 0;
    }

    }
    /* 編輯模式表單 */
    .edit-form .form-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 16px;
        align-items: start;
    }

    .edit-form .fg-col-3 {
        grid-column: span 3;
    }

    .edit-form .fg-col-4 {
        grid-column: span 4;
    }

    .edit-form .fg-col-2 {
        grid-column: span 2;
    }

    .edit-form .fg-col-12 {
        grid-column: span 12;
    }

    @@media (max-width:1200px) {
        .edit-form .fg-col-3

    {
        grid-column: span 6;
    }

    .edit-form .fg-col-4 {
        grid-column: span 6;
    }

    .edit-form .fg-col-2 {
        grid-column: span 6;
    }

    }
    @@media (max-width:768px) {
        .edit-form .fg-col-3, .edit-form .fg-col-4, .edit-form .fg-col-2, .edit-form .fg-col-12

    {
        grid-column: span 12;
    }

    }

    .edit-form .field {
        position: relative;
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 12px 12px 10px 12px;
        box-shadow: 0 6px 16px rgba(63,158,149,.06);
        transition: box-shadow .2s ease, transform .15s ease;
    }

        .edit-form .field:hover {
            box-shadow: 0 10px 24px rgba(63,158,149,.10);
            transform: translateY(-1px);
        }

        .edit-form .field:focus-within {
            box-shadow: 0 0 0 3px rgba(63,158,149,.18), 0 10px 24px rgba(63,158,149,.12);
        }

    .edit-form .label {
        font-weight: 800;
        color: #1E2A2A;
        font-size: 14px;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .edit-form .affix {
        position: relative;
    }

        .edit-form .affix > i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--admin-primary);
            opacity: .9;
            font-size: 16px;
            pointer-events: none;
        }

        .edit-form .affix > .form-select,
        .edit-form .affix > .form-control {
            padding-left: 40px;
            min-height: 44px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

            .edit-form .affix > .form-select:focus,
            .edit-form .affix > .form-control:focus {
                border-color: var(--admin-primary);
                box-shadow: 0 0 0 .15rem rgba(63,158,149,.15);
            }

    .edit-form .hint {
        font-size: 12px;
        color: #7A8A8A;
    }

    .edit-form .photo-box {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
    }

        .edit-form .photo-box input[type="file"] {
            display: none;
        }

    .edit-form .photo-fake {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1px dashed var(--border-color);
        border-radius: 10px;
        cursor: pointer;
        user-select: none;
        background: #fff;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

        .edit-form .photo-fake:hover {
            background: #F9FBFA;
            border-color: var(--admin-secondary);
            transform: translateY(-1px);
        }

    .edit-form .photo-name {
        font-size: 13px;
        color: #6B7C7C;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .edit-form .actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

        .edit-form .actions .btn {
            min-height: 44px;
            border-radius: 12px;
            padding: 10px 16px;
            font-weight: 700;
            box-shadow: 0 8px 18px rgba(63,158,149,.10);
            transition: transform .12s ease, box-shadow .12s ease;
        }

            .edit-form .actions .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(63,158,149,.16);
            }

            .edit-form .actions .btn:active {
                transform: translateY(0);
            }
</style>

<div class="container-fluid py-4" id="ProductItem" style="padding:20px!important;margin:0!important;">
    <!-- 標題 -->
    <div class="d-flex align-items-center justify-content-between" style="margin:0 0 20px 0!important;">
        <h4 class="page-title" style="margin:0!important;">
            <i class="bi bi-box-seam"></i> @ViewBag.Title
        </h4>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="toggleEdit"
                   v-model="display_edit" v-on:change="ShowEdit"
                   style="transform:scale(1.2)!important;">
            <label class="form-check-label fw-bold" for="toggleEdit" style="font-size:14px!important;">
                <i class="bi me-2" v-on:class="display_edit ? 'bi-pencil-square text-warning' : 'bi-eye text-primary'"></i>
                {{ display_edit ? '編輯模式' : '檢視模式' }}
            </label>
        </div>
    </div>

    <!-- 導覽列 -->
    <ul class="nav nav-pills nav-fill admin-tabs shadow rounded-3" style="margin:0 0 25px 0!important;">
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='ALL'}]" v-on:click="QueryOpt='ALL';HandleQuery()">
                <i class="bi bi-layers"></i>查看全部
            </a>
        </li>
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='UNDONE'}]" v-on:click="QueryOpt='UNDONE';HandleQuery()">
                <i class="bi bi-exclamation-circle"></i>未領取
            </a>
        </li>
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='RESIDENT'}]" v-on:click="QueryOpt='RESIDENT';HandleQuery()">
                <i class="bi bi-person-badge"></i>住戶查詢
            </a>
        </li>
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='HISTORY'}]" v-on:click="QueryOpt='HISTORY';HandleQuery()">
                <i class="bi bi-archive"></i>歷史紀錄
            </a>
        </li>
    </ul>

    <!-- 編輯表單 -->
    <div class="admin-card edit-form" v-if="display_edit">
        <div class="form-grid">
            <!-- 包裹類別 -->
            <div class="fg-col-3">
                <div class="field">
                    <div class="label"><i class="bi bi-box"></i>包裹類別</div>
                    <div class="affix">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <select v-model="Pack_Type" class="form-select">
                            <option value="">請選擇類別</option>
                            <option :value="item.pack_type" v-for="item in ProdTypeList" :key="item.pack_type">
                                {{item.pack_name}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 收件住戶 -->
            <div class="fg-col-3">
                <div class="field">
                    <div class="label"><i class="bi bi-person-badge"></i>收件住戶</div>
                    <div class="affix">
                        <i class="bi bi-people"></i>
                        <select v-model="Red_Id" class="form-select">
                            <option value="">請選擇住戶</option>
                            <option :value="item.red_id" v-for="item in ResidentList" :key="item.red_id">
                                {{item.condo_id}} - {{item.red_name}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 備註 -->
            <div class="fg-col-4">
                <div class="field">
                    <div class="label"><i class="bi bi-card-text"></i>備註 <span class="text-danger">*</span><span class="hint">例：管理室、1樓信箱、黑貓宅急便</span></div>
                    <div class="affix">
                        <i class="bi bi-pencil-square"></i>
                        <input type="text"
                               v-model="Remarks"
                               class="form-control"
                               v-bind:class="{ 'is-invalid': showRemarksError }"
                               placeholder="請至少填寫包裹放置位置"
                               maxlength="500"
                               v-on:input="clearRemarksError">
                    </div>
                    
