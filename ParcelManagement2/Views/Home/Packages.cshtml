@{
    var date = DateTime.Now.ToString("MMdd");
}

<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
        --admin-primary: #3F9E95;
        --admin-secondary: #7FCFC3;
        --admin-primary-dark: #2F847C;
        --admin-accent: #CFC7BB;
        --admin-light: #9FB1B1;
        --border-color: #E7E3DA;
        --card-radius: 16px;
        --status-pending: #E74C3C;
        --status-collected: #2ECC71;
        --label-h: 26px;
        --ctl-h: 44px;
        --cream: #FFF7E6;
        --cream-border: #F0E6D6;
    }

    body {
        font-size: 16px;
    }

    /*基礎樣式 */

    .page-title {
        font-size: 1.4rem;
        color: var(--admin-primary);
    }

        .page-title i {
            color: var(--admin-accent);
        }

    .table th, .table td {
        font-size: 15px;
        text-align: center;
    }

    .form-label, .form-select, .btn, .pickup-time, .resident-name, .package-id,
    .package-type-badge, .package-status-pending, .package-status-collected,
    .status-badge-pending, .status-badge-collected {
        font-size: 15px;
        text-align: center;
    }

    /* 表格與容器*/

    .admin-table-container {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: var(--card-radius);
        box-shadow: 0 8px 24px rgba(63,158,149,.08);
        overflow: hidden;
        position: relative;
    }

    .table-responsive {
        max-height: calc(100vh - 260px);
        overflow: auto;
        -webkit-overflow-scrolling: touch;
        position: relative;
    }

    .table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100% !important;
        table-layout: auto !important;
    }

        .table thead {
            position: relative;
            z-index: 5;
        }

            .table thead th {
                position: sticky;
                top: 0;
                z-index: 5;
                background: linear-gradient(180deg, var(--admin-primary), #388F87);
                color: #fff;
                border-color: var(--admin-primary);
                white-space: nowrap;
                box-shadow: 0 2px 0 rgba(0,0,0,.05);
                border: 1px solid var(--border-color);
                vertical-align: middle;
            }

                .table thead th i {
                    margin-right: 10px;
                    color: #E6F6F4;
                    font-size: 13px;
                    vertical-align: middle;
                }

                .table thead th:first-child {
                    border-top-left-radius: calc(var(--card-radius) - 2px);
                }

                .table thead th:last-child {
                    border-top-right-radius: calc(var(--card-radius) - 2px);
                }

        .table tbody tr:hover {
            background: rgba(127,207,195,.12);
        }

            .table tbody tr:hover td:first-child {
                border-top-left-radius: 10px;
                border-bottom-left-radius: 10px;
            }

            .table tbody tr:hover td:last-child {
                border-top-right-radius: 10px;
                border-bottom-right-radius: 10px;
            }

        .table th, .table td {
            border: 1px solid var(--border-color);
            color: #1E2A2A;
            background: #fff;
            vertical-align: middle;
            white-space: normal;
            word-wrap: break-word;
        }

        .table .remarks-cell {
            max-width: none !important;
            width: 100%;
            white-space: normal;
            word-wrap: break-word;
        }

    /* 導覽列*/

    .admin-tabs .nav-link {
        background: var(--admin-primary);
        border-color: var(--admin-primary);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .admin-tabs .nav-link:not(.active) {
            background: var(--admin-secondary);
            border-color: var(--admin-secondary);
            color: #0E2523;
        }

        .admin-tabs .nav-link:hover, .admin-tabs .nav-link:focus {
            background: var(--admin-primary-dark);
            border-color: var(--admin-primary-dark);
            color: #fff;
        }

        .admin-tabs .nav-link.active {
            background: var(--admin-primary);
            border-color: var(--admin-primary);
            color: #fff;
        }

        .admin-tabs .nav-link::after {
            content: "";
            position: absolute;
            left: 10%;
            right: 10%;
            bottom: 4px;
            height: 3px;
            border-radius: 3px;
            background: rgba(255,255,255,.85);
            transform: scaleX(0);
            transform-origin: center;
            transition: transform .25s ease;
        }

        .admin-tabs .nav-link.active::after {
            transform: scaleX(1);
        }

    /*包裹類型與狀態 */

    .package-type-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-weight: 700;
        line-height: 1;
        box-shadow: 0 1px 0 rgba(0,0,0,.04);
        transition: transform .15s, box-shadow .15s;
    }

        .package-type-badge:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(0,0,0,.1);
        }

    .package-type-parcel {
        background: #E7F7F4 !important;
        color: #2C7E77 !important;
        border-color: #2C7E77 !important;
    }

    .package-type-letter {
        background: #FFE6CC !important;
        color: #C76B16 !important;
        border-color: #E5924A !important;
    }

    .status-badge-pending {
        background: #fff5f5;
        border: 1px solid var(--status-pending);
        color: var(--status-pending);
    }

    .status-badge-collected {
        background: #f0fff4;
        border: 1px solid var(--status-collected);
        color: var(--status-collected);
    }

    .status-display-wrapper .package-status-pending {
        color: var(--status-pending) !important;
        font-weight: 700;
    }

    .status-display-wrapper .package-status-collected {
        color: var(--status-collected) !important;
        font-weight: 700;
    }

    .package-id {
        background: transparent;
        border: none;
        font-family: inherit;
        font-weight: 700;
        color: #1E2A2A;
        padding: 0;
    }

    /* 滾輪樣式 */

    .table-responsive::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #F1F1F1;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--admin-secondary);
        border-radius: 4px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: var(--admin-primary);
        }

    /* 卡片 */

    .admin-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: var(--card-radius);
        box-shadow: 0 8px 20px rgba(63,158,149,.06);
        padding: 16px;
        margin-bottom: 16px;
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(63,158,149,.12);
        }

    /* 住戶查詢篩選區  */

    .filter-bar {
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .filter-controls-wrapper {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        gap: 20px;
        align-items: center;
    }

    .filter-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .filter-item-select {
        grid-column: 1 / 2;
    }

    .filter-item-pills {
        grid-column: 2 / 3;
    }

    .filter-item-hint {
        grid-column: 3 / 4;
        justify-content: center;
    }

    .filter-item-action {
        grid-column: 4 / 5;
        justify-content: flex-end;
    }

    .filter-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 14px;
        color: #495057;
        white-space: nowrap;
        margin: 0;
    }

        .filter-label i {
            font-size: 16px;
            color: var(--admin-primary);
        }

    /* 下拉選單 */
    .combo-wrap {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 250px;
    }

        .combo-wrap i {
            position: absolute;
            left: 12px;
            font-size: 18px;
            color: var(--admin-primary);
            z-index: 1;
            pointer-events: none;
        }

        .combo-wrap .form-select {
            width: 100%;
            padding: 8px 12px 8px 40px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .combo-wrap .form-select:focus {
                border-color: var(--admin-primary);
                box-shadow: 0 0 0 0.2rem rgba(63, 158, 149, 0.25);
            }

    /* 狀態按鈕組 */
    .status-pills {
        display: flex;
        gap: 10px;
        flex-wrap: nowrap;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 20px;
        font-weight: 600;
        color: #495057;
        cursor: pointer;
        transition: all 0.3s ease;
        user-select: none;
        white-space: nowrap;
    }

        .status-pill:hover:not(.disabled) {
            background: var(--admin-primary);
            color: white;
            border-color: var(--admin-primary);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(63, 158, 149, 0.3);
        }

        .status-pill[data-active="true"] {
            background: var(--admin-primary);
            color: white;
            border-color: var(--admin-primary);
        }

        .status-pill[data-type="pending"][data-active="true"] {
            background: #fff5f5;
            border-color: var(--status-pending);
            color: var(--status-pending);
        }

        .status-pill[data-type="done"][data-active="true"] {
            background: #f0fff4;
            border-color: var(--status-collected);
            color: var(--status-collected);
        }

        .status-pill.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

            .status-pill.disabled:hover {
                transform: none;
                box-shadow: none;
            }

        .status-pill i {
            font-size: 14px;
        }

    /* 提示訊息 */
    .filter-hint {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: #fff3cd;
        border-radius: 8px;
        border-left: 4px solid #ffc107;
        white-space: nowrap;
        transition: opacity 0.3s ease;
    }

        .filter-hint.invisible {
            opacity: 0;
            pointer-events: none;
        }

        .filter-hint i {
            color: #ffc107;
            font-size: 16px;
            flex-shrink: 0;
        }

    /* 清除按鈕 */
    .filter-actions {
        display: flex;
        justify-content: flex-end;
    }

    .btn-clear {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: white;
        border: 2px solid #dc3545;
        border-radius: 8px;
        color: #dc3545;
        font-weight: 600;
        transition: all 0.3s ease;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-clear:hover {
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

        .btn-clear i {
            font-size: 16px;
        }

    /* 統計區 */

    .summary-bar {
        background: linear-gradient(135deg, #FFF9F0 0%, #F7F3EB 100%);
        border: 1px solid #EDE6D8;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(63,158,149,.06);
        padding: 26px 18px;
        margin-top: 12px;
        opacity: 0;
        transform: translateY(6px);
        animation: fade-in-up .5s ease forwards .1s;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        align-items: center;
    }

    .summary-item {
        text-align: center;
        padding: 6px 8px;
        transition: transform .15s ease;
    }

        .summary-item:hover {
            transform: translateY(-2px) scale(1.01);
        }

        .summary-item .value {
            font-weight: 800;
            font-size: 36px;
            line-height: 1;
            margin-bottom: 8px;
            color: #1F2A2A;
        }

            .summary-item .value.is-pending {
                color: #E74C3C;
            }

            .summary-item .value.is-done {
                color: #2ECC71;
            }

            .summary-item .value.is-time {
                font-size: 22px;
                font-weight: 700;
            }

        .summary-item .label {
            font-size: 18px;
            color: #2A3A3A;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .summary-item .label.label-red {
                color: #E74C3C;
            }

            .summary-item .label.label-green {
                color: #2ECC71;
            }

            .summary-item .label i {
                opacity: .9;
            }

    /* 編輯表單 */

    .edit-form .form-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 16px;
        align-items: start;
    }

    .edit-form .fg-col-3 {
        grid-column: span 3;
    }

    .edit-form .fg-col-4 {
        grid-column: span 4;
    }

    .edit-form .fg-col-2 {
        grid-column: span 2;
    }

    .edit-form .fg-col-12 {
        grid-column: span 12;
    }

    .edit-form .field {
        position: relative;
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 12px 12px 10px 12px;
        box-shadow: 0 6px 16px rgba(63,158,149,.06);
        transition: box-shadow .2s ease, transform .15s ease;
    }

        .edit-form .field:hover {
            box-shadow: 0 10px 24px rgba(63,158,149,.10);
            transform: translateY(-1px);
        }

        .edit-form .field:focus-within {
            box-shadow: 0 0 0 3px rgba(63,158,149,.18), 0 10px 24px rgba(63,158,149,.12);
        }

    .edit-form .label {
        font-weight: 800;
        color: #1E2A2A;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .edit-form .affix {
        position: relative;
    }

        .edit-form .affix > i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--admin-primary);
            opacity: .9;
            font-size: 16px;
            pointer-events: none;
        }

        .edit-form .affix > .form-select,
        .edit-form .affix > .form-control {
            padding-left: 40px;
            min-height: 44px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

            .edit-form .affix > .form-select:focus,
            .edit-form .affix > .form-control:focus {
                border-color: var(--admin-primary);
                box-shadow: 0 0 0 .15rem rgba(63,158,149,.15);
            }

    .edit-form .hint {
        font-size: 12px;
        color: #7A8A8A;
    }

    .edit-form .photo-box {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
    }

        .edit-form .photo-box input[type="file"] {
            display: none;
        }

    .edit-form .photo-fake {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1px dashed var(--border-color);
        border-radius: 10px;
        cursor: pointer;
        user-select: none;
        background: #fff;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

        .edit-form .photo-fake:hover {
            background: #F9FBFA;
            border-color: var(--admin-secondary);
            transform: translateY(-1px);
        }

    .edit-form .photo-name {
        font-size: 13px;
        color: #6B7C7C;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .edit-form .actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

        .edit-form .actions .btn {
            min-height: 44px;
            border-radius: 12px;
            padding: 10px 16px;
            font-weight: 700;
            box-shadow: 0 8px 18px rgba(63,158,149,.10);
            transition: transform .12s ease, box-shadow .12s ease;
        }

            .edit-form .actions .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(63,158,149,.16);
            }

            .edit-form .actions .btn:active {
                transform: translateY(0);
            }

    /* 模態視窗*/

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 8px;
        min-width: 400px;
        max-width: 500px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .modal-header {
        padding: 20px;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h3 {
            margin: 0;
            font-size: 18px;
        }

    .pickup-modal-content {
        background: white;
        border-radius: 12px;
        min-width: 450px;
        max-width: 500px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .pickup-modal-header {
        background: var(--admin-primary);
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
    }

        .pickup-modal-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .close-btn {
        background: none;
        border: none;
        color: white;
        font-size: 28px;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

        .close-btn:hover {
            opacity: 0.8;
        }

    .modal-body {
        padding: 20px;
    }

    .modal-footer {
        padding: 15px 20px;
        border-top: 1px solid #dee2e6;
        text-align: right;
    }

        .modal-footer .btn {
            margin-left: 10px;
        }

    /*動畫效果 */

    @@keyframes row-pop {
        from

    {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .row-pop {
        opacity: 0;
        animation: row-pop .35s ease forwards;
    }

    @@keyframes fade-in-up {
        from

    {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes pill-bounce {
        0%

    {
        transform: translateY(0) scale(1);
    }

    40% {
        transform: translateY(-2px) scale(1.03);
    }

    100% {
        transform: translateY(0) scale(1);
    }

    }

    .status-pill[data-active="true"] {
        animation: pill-bounce .35s ease;
    }

    @@keyframes ripple {
        to

    {
        transform: scale(3.5);
        opacity: 0;
    }

    }

    .ripple-ink {
        position: absolute;
        border-radius: 50%;
        transform: scale(0);
        background: rgba(255,255,255,.55);
        pointer-events: none;
        animation: ripple .6s ease-out forwards;
        mix-blend-mode: screen;
    }

    /* 響應式設計*/

    @@media (max-width: 1200px) {
        .edit-form .fg-col-3, .edit-form .fg-col-4, .edit-form .fg-col-2

    {
        grid-column: span 6;
    }

    }

    @@media (max-width: 1024px) {
        .filter-controls-wrapper

    {
        grid-template-columns: auto 1fr;
        gap: 16px;
    }

    .filter-item-select,
    .filter-item-pills,
    .filter-item-hint,
    .filter-item-action {
        grid-column: 1 / -1;
    }

    .combo-wrap {
        min-width: 100%;
    }

    .status-pills {
        width: 100%;
    }

    .filter-item-hint {
        justify-content: flex-start;
    }

    .filter-item-action {
        justify-content: stretch;
    }

    .btn-clear {
        width: 100%;
        justify-content: center;
    }

    .summary-row {
        grid-template-columns: 1fr 1fr;
        row-gap: 18px;
    }

    }

    @@media (max-width: 768px) {
        .filter-bar

    {
        gap: 16px;
        padding: 16px;
    }

    .filter-item {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
    }

    .filter-label {
        justify-content: flex-start;
    }

    .combo-wrap .form-select {
        padding-left: 38px;
    }

    .status-pills {
        gap: 8px;
    }

    .status-pill {
        flex: 1;
        justify-content: center;
        padding: 6px 12px;
        min-width: calc(33.333% - 8px);
    }

    .filter-hint {
        padding: 6px 10px;
    }

    .btn-clear {
        width: 100%;
        justify-content: center;
        padding: 10px 16px;
    }

    .edit-form .fg-col-3,
    .edit-form .fg-col-4,
    .edit-form .fg-col-2,
    .edit-form .fg-col-12 {
        grid-column: span 12;
    }

    .summary-row {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 480px) {
        .filter-bar

    {
        gap: 12px;
        padding: 12px;
    }

    .status-pills {
        flex-direction: column;
        gap: 8px;
    }

    .status-pill {
        width: 100%;
        padding: 10px 16px;
    }

    .filter-hint {
        padding: 8px;
        text-align: center;
    }

    .btn-clear {
        padding: 12px 16px;
    }

    .modal-content,
    .pickup-modal-content {
        min-width: 90%;
        max-width: 90%;
    }

    }
</style>

<div class="container-fluid py-4" id="ProductItem" style="padding:20px!important;margin:0!important;">
    <!-- 標題 -->
    <div class="d-flex align-items-center justify-content-between" style="margin:0 0 20px 0!important;">
        <h4 class="page-title" style="margin:0!important;">
            <i class="bi bi-box-seam"></i> @ViewBag.Title
        </h4>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="toggleEdit"
                   v-model="display_edit" v-on:change="ShowEdit"
                   style="transform:scale(1.2)!important;">
            <label class="form-check-label fw-bold" for="toggleEdit" style="font-size:14px!important;">
                <i class="bi me-2" v-on:class="display_edit ? 'bi-pencil-square text-warning' : 'bi-eye text-primary'"></i>
                {{ display_edit ? '編輯模式' : '檢視模式' }}
            </label>
        </div>
    </div>

    <!-- 導覽列 -->
    <ul class="nav nav-pills nav-fill admin-tabs shadow rounded-3" style="margin:0 0 25px 0!important;">
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='ALL'}]" v-on:click="QueryOpt='ALL';HandleQuery()">
                <i class="bi bi-layers"></i>查看全部
            </a>
        </li>
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='UNDONE'}]" v-on:click="QueryOpt='UNDONE';HandleQuery()">
                <i class="bi bi-exclamation-circle"></i>未領取
            </a>
        </li>
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='RESIDENT'}]" v-on:click="QueryOpt='RESIDENT';HandleQuery()">
                <i class="bi bi-person-badge"></i>住戶查詢
            </a>
        </li>
        <li class="nav-item">
            <a href="#" v-bind:class="['nav-link',{active:QueryOpt==='HISTORY'}]" v-on:click="QueryOpt='HISTORY';HandleQuery()">
                <i class="bi bi-archive"></i>歷史紀錄
            </a>
        </li>
    </ul>

    <!-- 編輯表單 -->
    <div class="admin-card edit-form" v-if="display_edit">
        <div class="form-grid">
            <!-- 包裹類別 -->
            <div class="fg-col-3">
                <div class="field">
                    <div class="label"><i class="bi bi-box"></i>包裹類別</div>
                    <div class="affix">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <select v-model="Pack_Type" class="form-select">
                            <option value="">請選擇類別</option>
                            <option :value="item.pack_type" v-for="item in ProdTypeList" :key="item.pack_type">
                                {{item.pack_name}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 收件住戶 -->
            <div class="fg-col-3">
                <div class="field">
                    <div class="label"><i class="bi bi-person-badge"></i>收件住戶</div>
                    <div class="affix">
                        <i class="bi bi-people"></i>
                        <select v-model="Red_Id" class="form-select">
                            <option value="">請選擇住戶</option>
                            <option :value="item.red_id" v-for="item in ResidentList" :key="item.red_id">
                                {{item.condo_id}} - {{item.red_name}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 備註 -->
            <div class="fg-col-4">
                <div class="field">
                    <div class="label"><i class="bi bi-card-text"></i>備註 <span class="text-danger">*</span><span class="hint">例：管理室、1樓信箱、黑貓宅急便</span></div>
                    <div class="affix">
                        <i class="bi bi-pencil-square"></i>
                        <input type="text"
                               v-model="Remarks"
                               class="form-control"
                               v-bind:class="{ 'is-invalid': showRemarksError }"
                               placeholder="請至少填寫包裹放置位置"
                               maxlength="500"
                               v-on:input="clearRemarksError">
                    </div>
                    
                    <div class="invalid-feedback" v-if="showRemarksError">請填寫包裹放置位置</div>
                </div>
            </div>

            <!-- 照片 -->
            <div class="fg-col-2">
                <div class="field">
                    <div class="label">
                        <i class="bi bi-image"></i>包裹照片 
                        <span class="text-muted" style="font-weight:600;">(選填)</span>
                    </div>

                    <div class="photo-box" v-if="!PhotoFile">
                        <label class="photo-fake" for="photoUpload">
                            <i class="bi bi-upload"></i>
                            <span>選擇檔案</span>
                        </label>
                        <div class="photo-name" id="photoFileName">{{ selectedPhoto || '未選擇任何檔案' }}</div>
                        
                        <input type="file" id="photoUpload" ref="photoUpload"
                               accept="image/jpeg,image/jpg,image/png,image/gif"
                               v-on:change="handlePhotoSelect($event)">
                    </div>
                    <!-- 已選檔案：顯示「重新上傳」與檔名 -->
                    <div class="photo-box" v-else>
                        <i class="bi bi-file-image" style="opacity:.85;"></i>
                        <div class="photo-name" :title="selectedPhoto">{{ selectedPhoto }}</div>

                        <div class="ms-auto d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    v-on:click="reuploadPhoto">
                                <i class="bi bi-arrow-clockwise me-1"></i>重新上傳
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    v-on:click="clearUpload">
                                <i class="bi bi-eraser me-1"></i>清空
                            </button>
                        </div>

                        <input type="file"
                               id="photoUpload"
                               ref="photoUpload"
                               class="d-none"
                               accept="image/jpeg,image/jpg,image/png,image/gif"
                               v-on:change="handlePhotoSelect($event)">
                    </div>
                </div>
            </div>

            <!-- 操作按鈕 -->
            <div class="fg-col-12">
                <div class="actions">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            v-on:click="clearUpload">
                        <i class="bi bi-eraser me-2"></i>清空
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            v-on:click="UpdatePackages">
                        <i class="bi bi-arrow-repeat me-2"></i>批次更新
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            v-on:click="AddProduct"
                            style="background:var(--admin-primary); border-color:var(--admin-primary);">
                        <i class="bi bi-plus-circle me-2"></i>新增包裹
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- 住戶查詢條件 -->
<div class="admin-card" v-if="QueryOpt==='RESIDENT'">
    <div class="filter-bar">
        <!-- 篩選條件容器 -->
        <div class="filter-controls-wrapper">
            <!-- 選擇住戶 -->
            <div class="filter-item filter-item-select">
                <label class="filter-label">
                    <i class="bi bi-person-badge"></i>
                    <span>選擇住戶</span>
                </label>
                <div class="combo-wrap">
                    <i class="bi bi-people"></i>
                    <select class="form-select" v-model="SelectRed" v-on:change="SearchByResident">
                        <option value="">請選擇要查詢的住戶</option>
                        <option v-for="r in ResidentList" :value="r.red_id" :key="r.red_id">
                            {{ r.condo_id }} - {{ r.red_name }}
                        </option>
                    </select>
                </div>
            </div>

            <!-- 篩選狀態 -->
            <div class="filter-item filter-item-pills">
                <label class="filter-label">
                    <i class="bi bi-funnel"></i>
                    <span>篩選狀態</span>
                </label>
                <div class="status-pills">
                    <span class="status-pill"
                          :data-active="!SelectStatus"
                          v-on:class="{disabled: !SelectRed}"
                          :title="!SelectRed ? '請先選擇住戶' : '全部'"
                          v-on:click="SelectRed ? (SelectStatus='', SearchByResident()) : null">
                        <i class="bi bi-grid-3x3-gap"></i>全部
                    </span>

                    <span class="status-pill" data-type="pending"
                          :data-active="SelectStatus==='未取'"
                          v-on:class="{disabled: !SelectRed}"
                          :title="!SelectRed ? '請先選擇住戶' : '未取'"
                          v-on:click="SelectRed ? (SelectStatus='未取', SearchByResident()) : null">
                        <i class="bi bi-exclamation-triangle"></i>未取
                    </span>

                    <span class="status-pill" data-type="done"
                          :data-active="SelectStatus==='已取'"
                          v-on:class="{disabled: !SelectRed}"
                          :title="!SelectRed ? '請先選擇住戶' : '已取'"
                          v-on:click="SelectRed ? (SelectStatus='已取', SearchByResident()) : null">
                        <i class="bi bi-check-circle"></i>已取
                    </span>
                </div>
                    <!-- 提示訊息 -->
                    <div class="filter-item filter-item-hint">
                        <div class="filter-hint" v-bind:class="{ invisible: SelectRed }">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>請先選擇查詢住戶</span>
                        </div>
                    </div>
            </div>

            

            <!-- 清除按鈕 -->
            <div class="filter-item filter-item-action">
                <button type="button" class="btn btn-clear"
                        v-on:click="SelectRed=''; SelectStatus=''; ProductList=[]">
                    <i class="bi bi-x-circle"></i>清除條件
                </button>
            </div>
        </div>
    </div>
</div>
    
    <!-- 包裹清單 -->
    <div class="admin-table-container">
        <div class="table-responsive">
            <table class="table admin-table table-hover align-middle" style="margin:0!important;">
                <thead class="sticky-top">
                    <tr>
                        <th v-if="display_edit && QueryOpt==='HISTORY'" style="width:80px;"><i class="bi bi-gear"></i>操作</th>
                        <th v-if="display_edit && QueryOpt!=='HISTORY'" class="edit-selection-cell" style="width:80px;"><i class="bi bi-check2-square"></i>選取</th>
                        <th v-if="QueryOpt!=='UNDONE'"><i class="bi bi-clock"></i>領取時間</th>
                        <th ><i class="bi bi-hash"></i>包裹編號</th>
                        <th ><i class="bi bi-box"></i>類別</th>
                        <th ><i class="bi bi-person"></i>住戶</th>
                        <th ><i class="bi bi-clipboard-check"></i>狀態</th>
                        <th v-if="QueryOpt!=='HISTORY'" style="font-size:14px;color:#999;"><i style="font-size:14px;font-style:italic;"> 備註</i></th>
                        <th v-if="QueryOpt!=='HISTORY'&& !display_edit" style="width:100px; font-size:14px;">是否領取</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="(item,idx) in ProductList" :key="item.pack_id || idx"
                        class="row-pop"
                        :style="{animationDelay:(idx*40)+'ms'}">
                        <td v-if="display_edit && QueryOpt==='HISTORY'">
                            <div class="d-flex justify-content-center gap-1">
                                <button class="btn btn-outline-primary btn-sm" v-on:click="RestoreOne(item)" title="復原包裹" style="padding:4px 8px;font-size:11px;">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" v-on:click="RemoveOne(item)" title="永久刪除" style="padding:4px 8px;font-size:11px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>

                        <td v-if="display_edit && QueryOpt!=='HISTORY'">
                            <div class="d-flex flex-column align-items-center gap-1">
                                <div class="form-check">
                                    <input type="checkbox" v-model="item.Flag_Update" v-on:change="onUpdateChk(item)" class="form-check-input" :id="'update_'+idx">
                                    <label :for="'update_'+idx" class="form-check-label">更新</label>
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" v-model="item.Flag_Del" v-on:change="onDeleteChk(item)" class="form-check-input" :id="'del_'+idx">
                                    <label :for="'del_'+idx" class="form-check-label">刪除</label>
                                </div>
                            </div>
                        </td>

                        <td v-if="QueryOpt!=='UNDONE'">
                            <small class="pickup-time">
                                <span v-if="!item.pickup_datetime || item.pickup_datetime==='-'">-</span>
                                <span v-else>{{ item.pickup_datetime.substring(0,16).replace('T',' ') }}</span>
                            </small>
                        </td>

                        <td><span class="package-id">{{ item.pack_id }}</span></td>

                        <td>
                            <span v-bind:class="getPackageTypeClass(item)" class="package-type-badge">{{ item.pack_name }}</span>
                        </td>

                        <td>
                            <span class="resident-name">
                                <template v-if="item.red_id">
                                        {{ item.condo_id }}-{{ item.red_name }}
                                </template>
                                <template v-else>
                                    <span class="resident-name">
                                        {{item.condo_id}}
                                    </span>
                                </template>
                            </span>
                        </td>

                        <td>
                            <div v-if="display_edit" class="status-container">
                                <div v-if="QueryOpt!=='HISTORY'" class="status-select-wrapper">
                                    <select v-model="item.status" v-bind:disabled="!item.Flag_Update" class="form-select form-select-sm">
                                        <option :value="0">未取</option>
                                        <option :value="1">已取</option>
                                    </select>
                                </div>
                                <div class="status-display-wrapper">
                                    <small class="text-muted">目前狀態:</small>
                                    <small v-if="item.status==0 || item.status==='0'" class="package-status-pending" style="cursor:pointer;" v-on:click="viewPackagePhoto(item)" title="點擊查看包裹照片">
                                        <i class="bi bi-exclamation-triangle"></i> 未取
                                    </small>
                                    <small v-else class="package-status-collected">
                                        <i class="bi bi-check-circle"></i> 已取
                                    </small>
                                </div>
                            </div>
                            <div v-else>
                                <span v-if="item.status==0 || item.status==='0'" class="badge rounded-pill package-status-pending status-badge-pending" style="cursor:pointer;" v-on:click="viewPackagePhoto(item)">
                                    <i class="bi bi-exclamation-triangle me-1"></i>未取
                                </span>
                                <span v-else class="badge rounded-pill package-status-collected status-badge-collected">
                                    <i class="bi bi-check-circle me-1"></i>已取
                                </span>
                            </div>
                        </td>
                        <td v-if="QueryOpt!=='HISTORY'" style="text-align:center;">
                            <span class="remarks-cell" :title="item.remarks || '-'">{{ item.remarks || '-' }}</span>
                        </td>
                        <td v-if="QueryOpt!=='HISTORY' && !display_edit">
                            <button class="btn btn-sm"
                                    :class="(item.status==0 || item.status==='0') ? 'btn-success' : 'btn-secondary'"
                                    v-bind:disabled="picking || !(item.status==0 || item.status==='0')"
                                    v-on:click ="handlePickup(item)">
                                <span v-if="item.status==0 || item.status==='0'">領取</span>
                                <span v-else>已領取</span>
                            </button>
                        </td>
                    </tr>

                    <!-- 空狀態（依情境） -->
                    <tr v-if="ProductList.length===0">
                        <td v-if="QueryOpt==='HISTORY' && display_edit" colspan="7" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-archive" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">目前尚無歷史紀錄</h6><p class="text-secondary" style="margin:0;">尚未有任何已刪除的包裹記錄</p>
                            </div>
                        </td>
                        <td v-else-if="QueryOpt==='HISTORY' && !display_edit" colspan="6" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-archive" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">目前尚無歷史紀錄</h6><p class="text-secondary" style="margin:0;">尚未有任何已刪除的包裹記錄</p>
                            </div>
                        </td>
                        <td v-else-if="QueryOpt==='UNDONE' && display_edit" colspan="7" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-check-circle" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">沒有待領取的包裹</h6><p class="text-secondary" style="margin:0;">所有包裹都已領取完畢</p>
                            </div>
                        </td>
                        <td v-else-if="QueryOpt==='UNDONE' && !display_edit" colspan="6" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-check-circle" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">沒有待領取的包裹</h6><p class="text-secondary" style="margin:0;">所有包裹都已領取完畢</p>
                            </div>
                        </td>
                        <td v-else-if="QueryOpt==='RESIDENT' && display_edit" colspan="8" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-search" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">查無此住戶的包裹記錄</h6><p class="text-secondary" style="margin:0;">請選擇其他住戶或調整查詢條件</p>
                            </div>
                        </td>
                        <td v-else-if="QueryOpt==='RESIDENT' && !display_edit" colspan="7" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-search" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">查無此住戶的包裹記錄</h6><p class="text-secondary" style="margin:0;">請選擇其他住戶或調整查詢條件</p>
                            </div>
                        </td>
                        <td v-else-if="display_edit" colspan="8" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-inbox" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">目前暫無包裹或信件</h6><p class="text-secondary" style="margin:0;">請等待包裹送達或調整查詢條件</p>
                            </div>
                        </td>
                        <td v-else colspan="7" style="padding:40px 20px;text-align:center;color:var(--admin-light);">
                            <div>
                                <i class="bi bi-inbox" style="font-size:48px;margin:0 0 16px 0;display:block;color:var(--admin-light);"></i>
                                <h6 style="margin:0 0 4px 0;">目前暫無包裹或信件</h6><p class="text-secondary" style="margin:0;">請等待包裹送達或調整查詢條件</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- 統計 -->
        <div class="summary-bar" v-if="ProductList.length >= 0">
            <div class="summary-row">
                <div class="summary-item">
                    <div class="label">
                        <i class="bi bi-people"></i>總計
                    </div>
                    <div class="value">
                        {{ ProductList.length }}
                    </div>
                    <div>
                        <i>件</i>
                    </div>
                </div>
                <div class="summary-item">
                    <div class="label label-red">
                        <i class="bi bi-exclamation-triangle"></i>未取
                    </div>
                    <div class="value is-pending">
                        {{ ProductList.filter(p => p.status == 0 || p.status === '0').length }}
                    </div>
                    <div class="label label-red">
                        <i>件</i>
                    </div>
                </div>
                <div class="summary-item">
                    <div class="label label-green">
                        <i class="bi bi-check-circle"></i>已取
                    </div>
                    <div class="value">
                        {{ ProductList.filter(p => p.status == 1 || p.status === '1').length }}
                    </div>
                    <div class="label label-green">
                        <i>件</i>
                    </div>
                </div>
                <div class="summary-item">
                    <div class="label">
                        <i class="bi bi-clock"></i>最近更新
                    </div>
                    <div class="value is-time">
                        {{ new Date().toLocaleString('zh-TW', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- 選擇領取人 Modal -->
    <div v-if="showResidentModal"
         style="position:fixed; inset:0; background:#0006; display:flex; align-items:center; justify-content:center; z-index:2000;">
        <div style="width:min(520px,90vw); background:#fff; border-radius:12px; box-shadow:0 10px 30px #0005;">
            <div style="padding:14px 18px; background:var(--admin-primary); color:#fff; border-radius:12px 12px 0 0;">
                <strong>選擇領取人</strong>
            </div>
            <div style="padding:16px 20px; max-height:60vh; overflow:auto;">
                <p style="margin:0 0 10px;">請選擇包裹領取人：</p>
                <div v-for="r in pickupResidents" :key="r.red_id" style="padding:8px 10px; border:1px solid #e6e6e6; border-radius:8px; margin-bottom:8px;">
                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                        <input type="radio" name="pickupRed" :value="r.red_id" v-model="selectedRedId">
                            <div style="font-weight:600;">{{ r.red_name }}</div>
                            <small style="color:#777;">{{ r.red_id }}</small>
                    </label>
                </div>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:10px; padding:12px 16px;">
                <button class="btn btn-outline-secondary btn-sm" v-on:click ="closePickupModal()">取消</button>
                <button class="btn btn-primary btn-sm" v-on:click ="confirmResidentSelection()">確認</button>
            </div>
        </div>
    </div>
    <!-- 確認領取 Modal -->
