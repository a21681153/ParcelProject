@{
    ViewBag.Title = ViewBag.Title ?? "FaceBox社區包裹統計首頁";
}
<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
        --theme-primary: #7FCFC3; 
        --theme-primary-dark: #3F9E95;
        --theme-accent: #CFC7BB;
        --theme-light: #F4F1E7; 
        --theme-border: #E7E3DA; 
        --theme-text-primary: #1E2A2A; 
        --theme-text-secondary: #5C6B6B; 

        --status-pending: #E74C3C;
        --status-collected: #2ECC71;

        --btn-outline: #4ECDC4;
        --card-radius: 16px;
    }

    /* 動畫 */
    * {
        transition: all .3s cubic-bezier(.25,.46,.45,.94);
    }

    @@keyframes slideInFromTop {
        from {
            opacity: 0;
            transform: translateY(-30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideInFromLeft {
        from {
            opacity: 0;
            transform: translateX(-20px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes countUp {
        from {
            opacity: 0;
            transform: scale(.5)
        }

        to {
            opacity: 1;
            transform: scale(1)
        }
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-5px)
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: .95
        }

        50% {
            transform: scale(1.06);
            opacity: 1
        }
    }

    @@keyframes wave {
        0%, 100% {
            background-position: 0% 50%
        }

        50% {
            background-position: 100% 50%
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0
        }

        to {
            opacity: 1
        }
    }

    @@keyframes activePagePulse {
        0%, 100% {
            box-shadow: 0 4px 14px rgba(63,158,149,.26)
        }

        50% {
            box-shadow: 0 6px 20px rgba(63,158,149,.38)
        }
    }

    /* 頁首 */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding: 0 8px;
        animation: slideInFromTop .8s ease-out;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--theme-text-primary);
        margin: 0;
        display: flex;
        align-items: center;
        text-shadow: none;
    }

        .page-title i {
            margin-right: 12px;
            color: var(--theme-primary);
            font-size: 1.3rem;
            animation: bounce 2s ease-in-out infinite;
        }

    /* 統計卡：奶油米底+更淡薄荷掃光 */
    .stats-card {
        background: linear-gradient(180deg,#F8F6EF 0%, var(--theme-light) 100%);
        color: var(--theme-text-primary);
        border-radius: var(--card-radius);
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 10px 24px rgba(63,158,149,.12);
        border: 1px solid rgba(63,158,149,.12);
        position: relative;
        overflow: hidden;
        animation: fadeInUp .6s ease-out;
    }

        .stats-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 14px 34px rgba(63,158,149,.16);
        }

        .stats-card::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: .28;
            background: linear-gradient(45deg, transparent 0%, rgba(127,207,195,.18) 50%, transparent 100%);
            animation: wave 5s ease-in-out infinite;
        }

    .stats-item {
        cursor: pointer;
        border-radius: 12px;
        padding: 16px 8px;
    }

        .stats-item:hover {
            background: rgba(127,207,195,.06);
        }

    .stats-number {
        font-size: 2.2rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 8px;
        color: var(--theme-text-primary);
        text-shadow: none;
        animation: countUp .8s ease-out;
    }

        .stats-number:hover {
            transform: scale(1.08);
        }

    .stats-label {
        font-size: .95rem;
        margin: 0;
        font-weight: 700;
        line-height: 1.3;
        color: var(--theme-text-primary);
        text-shadow: none;
    }

        .stats-label i {
            font-size: 1rem;
            margin-right: 6px;
            color: var(--theme-primary);
            animation: pulse 2s ease-in-out infinite;
        }

    /* 表格容器 */
    .admin-table-container {
        background: #FFF;
        border-radius: var(--card-radius);
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(30,42,42,.07);
        border: 1px solid var(--theme-border);
        margin-bottom: 24px;
        backdrop-filter: blur(8px);
        animation: fadeInUp .8s ease-out;
        animation-delay: .2s;
        animation-fill-mode: both;
    }

    .table thead th {
        background: linear-gradient(180deg, var(--theme-primary-dark) 0%, #388F87 100%);
        color: #FFF;
        font-weight: 800;
        white-space: nowrap;
        border-color: var(--theme-primary-dark);
        text-shadow: none;
        position: relative;
        overflow: hidden;
    }

        .table thead th::before {
            display: none;
        }

        .table thead th i {
            margin-right: 8px;
            vertical-align: middle;
            font-size: 16px;
            color: #E6F6F4;
        }

    /* 表格內容 */
    .table th, .table td {
        vertical-align: middle;
        text-align: center;
        padding: 18px 14px;
        border: 1px solid var(--theme-border);
        font-size: 15px;
        line-height: 1.4;
        background: #FFF;
        color: var(--theme-text-primary);
    }

    .table tbody tr {
        transition: all .3s cubic-bezier(.25,.46,.45,.94);
        background: #FFF;
        animation: slideInFromLeft .6s ease-out;
        animation-fill-mode: both;
    }

        .table tbody tr:nth-child(odd) {
            animation-delay: .1s
        }

        .table tbody tr:nth-child(even) {
            animation-delay: .2s
        }

        .table tbody tr:hover {
            background: linear-gradient(135deg, rgba(127,207,195,.10), rgba(207,199,187,.06));
            transform: translateY(-1px) scale(1.003);
            box-shadow: 0 4px 12px rgba(30,42,42,.07);
        }

    /* 清單數字 */
    .stat-link {
        text-decoration: none;
        padding: 0;
        border: none;
        background: transparent;
        box-shadow: none;
        display: inline;
        min-width: 0;
        cursor: pointer;
        font-weight: 700;
    }

        .stat-link::before {
            display: none;
        }

        .stat-link:hover {
            text-decoration: underline;
        }

    .stat-pending {
        color: var(--status-pending) !important;
    }

    .stat-collected {
        color: var(--status-collected) !important;
    }

    /* 住戶資訊 */
    .resident-info {
        font-weight: 700;
        color: var(--theme-text-primary);
        font-size: 15px;
        text-shadow: none;
    }

    /* 空資料提示 */
    .empty-state {
        padding: 50px 20px;
        text-align: center;
        color: var(--theme-text-secondary);
        animation: fadeIn 1s ease-out;
    }

        .empty-state i {
            font-size: 56px;
            margin-bottom: 16px;
            display: block;
            opacity: .7;
            color: #BFE8E2;
            animation: pulse 2s ease-in-out infinite;
        }

        .empty-state h6 {
            font-size: 18px;
            margin-bottom: 8px;
            font-weight: 700;
            color: var(--theme-text-primary);
        }

        .empty-state small {
            font-size: 14px;
            color: var(--theme-text-secondary);
        }

    /* 按鈕 */
    .btn {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 20px;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
    }

        .btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.24), transparent);
            left: -100%;
            transition: left .6s;
        }

        .btn:hover::before {
            left: 100%
        }

        .btn:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
        }

    .btn-outline-primary {
        border-color: var(--btn-outline);
        color: var(--btn-outline);
        background: rgba(255,255,255,.96);
        border-width: 2px;
        font-weight: 600;
    }

        .btn-outline-primary:hover {
            background: var(--btn-outline);
            border-color: var(--btn-outline);
            color: #FFF;
            box-shadow: 0 6px 22px rgba(78,205,196,.30);
            transform: translateY(-2px) scale(1.05);
        }

    /* 導覽列*/
    .navbar, .navbar.bg-light {
        background: linear-gradient(180deg, #8AD6CB 0%, var(--theme-primary-dark) 100%) !important;
        border-bottom: 1px solid rgba(255,255,255,.22) !important;
    }

        .navbar .nav-link {
            color: #EAF6F4 !important;
        }

            .navbar .nav-link:hover, .navbar .nav-link:focus {
                color: #FFF !important;
                background: rgba(255,255,255,.10) !important;
                border-radius: 10px;
            }

            .nav-pills .nav-link.active, .nav-pills .show > .nav-link, .navbar .nav-link.active {
                background: #2F847C !important;
                color: #FFF !important;
                box-shadow: none !important;
            }

            .navbar .badge, .navbar .nav-link .badge {
                background: #3F9E95 !important;
                color: #FFF !important;
            }

    /* 分頁*/
    .pagination .page-link {
        background: #FFF;
        border: 1px solid var(--theme-border);
        color: var(--theme-text-primary);
        padding: 12px 16px;
        margin: 0 4px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        min-width: 48px;
        transition: all .3s cubic-bezier(.25,.46,.45,.94);
    }

        .pagination .page-link:hover {
            background: var(--theme-light);
            color: var(--theme-text-primary);
            border-color: #E4EEE9;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 4px 10px rgba(30,42,42,.06);
        }

    .pagination .page-item.active .page-link {
        background: var(--theme-primary);
        border-color: var(--theme-primary);
        color: #FFF;
        box-shadow: 0 4px 14px rgba(63,158,149,.26);
        animation: activePagePulse 2s ease-in-out infinite;
    }

    /* 響應式 */
    @@media (max-width:768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .stats-card {
            padding: 20px
        }

        .stats-number {
            font-size: 1.8rem
        }
    }

    @@media (max-width:576px) {
        .stats-card {
            padding: 18px
        }

        .stats-number {
            font-size: 1.6rem
        }

        .page-title {
            font-size: 1.3rem
        }
    }
</style>


<div class="container-fluid">
    <div id="ResidentStats">
        <div class="page-header">
            <h3 class="page-title">
                <i class="bi bi-graph-up"></i>
                @ViewBag.Title
            </h3>
            <button type="button" class="btn btn-outline-primary" v-on:click="fetchStats">
                <i class="bi bi-arrow-clockwise"></i>
                重新整理
            </button>
        </div>

        <div class="stats-card" v-if="stats.length > 0">
            <div class="row text-center g-2">
                <div class="col-4 col-md-4">
                    <div class="stats-item">
                        <div class="stats-number">{{ stats.length }}</div>
                        <h6 class="stats-label">
                            <i class="bi bi-people"></i>總住戶數
                        </h6>
                    </div>
                </div>
                <div class="col-4 col-md-4">
                    <div class="stats-item">
                        <div class="stats-number" style="color: #E74C3C;">{{ totalUncollected }}</div>
                        <h6 class="stats-label" style="color: #E74C3C;">
                            <i class="bi bi-exclamation-triangle"></i>未領取包裹
                        </h6>
                    </div>
                </div>
                <div class="col-4 col-md-4">
                    <div class="stats-item">
                        <div class="stats-number" style="color: #2ECC71;">{{ totalCollected }}</div>
                        <h6 class="stats-label" style="color: #2ECC71;">
                            <i class="bi bi-check-circle"></i>已領取包裹
                        </h6>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-table-container">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="sticky-top">
                        <tr>
                            <th><i class="bi bi-person"></i>住戶資訊</th>
                            <th><i class="bi bi-exclamation-triangle"></i>未領取包裹</th>
                            <th><i class="bi bi-check-circle"></i>已領取包裹</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="r in pagedStats" :key="r.red_id">
                            <td>
                                <span class="resident-info">{{r.condo_id}} - {{ r.red_name }}</span>
                            </td>
                            <td>
                                <a href="#" class="stat-link stat-pending" v-on:click.prevent="goToResident(r.red_id, '未取')">
                                    {{ r.uncollected }} 件
                                </a>
                            </td>
                            <td>
                                <a href="#" class="stat-link stat-collected" v-on:click.prevent="goToResident(r.red_id, '已取')">
                                    {{ r.collected }} 件
                                </a>
                            </td>
                        </tr>
                        <tr v-if="pagedStats.length === 0">
                            <td colspan="3" class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <h6 class="mb-2">目前無統計資料</h6>
                                <small>請稍後再試或聯繫管理員</small>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <nav v-if="totalPages > 1" class="mt-4">
            <ul class="pagination justify-content-center">
                <li :class="['page-item', { disabled: currentPage === 1 }]">
                    <a class="page-link" href="#" v-on:click.prevent="setPage(currentPage-1)">
                        <i class="bi bi-chevron-left me-1"></i>上一頁
                    </a>
                </li>
                <li v-for="n in visiblePages" :key="n"
                    :class="['page-item', { active: n === currentPage, disabled: n === '...' }]">
                    <a class="page-link" href="#" v-on:click.prevent="n !== '...' && setPage(n)">
                        {{ n }}
                    </a>
                </li>
                <li :class="['page-item', { disabled: currentPage === totalPages }]">
                    <a class="page-link" href="#" v-on:click.prevent="setPage(currentPage+1)">
                        下一頁<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    const app = Vue.createApp({
        data() {
            return {
                stats: [],
                currentPage: 1,
                pageSize: 15
            }
        },
        computed: {
            totalPages() {
                return Math.ceil(this.stats.length / this.pageSize);
            },
            pagedStats() {
                const start = (this.currentPage - 1) * this.pageSize;
                return this.stats.slice(start, start + this.pageSize);
            },
            totalUncollected() {
                return this.stats.reduce((sum, stat) => sum + stat.uncollected, 0);
            },
            totalCollected() {
                return this.stats.reduce((sum, stat) => sum + stat.collected, 0);
            },
            visiblePages() {
                const pages = [];
                const total = this.totalPages;
                const current = this.currentPage;

                if (total <= 7) {
                    for (let i = 1; i <= total; i++) {
                        pages.push(i);
                    }
                } else {
                    pages.push(1);

                    if (current > 4) {
                        pages.push('...');
                    }

                    const start = Math.max(2, current - 2);
                    const end = Math.min(total - 1, current + 2);

                    for (let i = start; i <= end; i++) {
                        pages.push(i);
                    }

                    if (current < total - 3) {
                        pages.push('...');
                    }

                    pages.push(total);
                }

                return pages;
            }
        },
        mounted() {
            this.fetchStats();
        },
        methods: {
            fetchStats() {
                axios.post('/Home/GetResidentPackageStats')
                    .then(res => {
                        if (Array.isArray(res.data)) {
                            this.stats = res.data;
                            this.currentPage = 1;
                        } else {
                            this.stats = [];
                        }
                    })
                    .catch(() => {
                        this.stats = [];
                        console.error('無法載入統計資料');
                    });
            },
            setPage(n) {
                if (n < 1 || n > this.totalPages || n === '...') return;
                this.currentPage = n;
            },
            goToResident(red_id, status) {
                const url = `/Home/Packages?red_id=${encodeURIComponent(red_id)}&status=${encodeURIComponent(status)}`;
                window.location.href = url;
            }
        }
    });
    app.mount('#ResidentStats');
</script>

<script src="/Scripts/common-jwt.js"></script>
