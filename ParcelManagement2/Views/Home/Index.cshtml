@{
    ViewBag.Title = ViewBag.Title ?? "社區包裹統計首頁";
}
<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
        --theme-primary: #34A3A0; /* 主色：薄荷青 */
        --theme-primary-dark: #237C77; /* 加深：表頭用 */
        --theme-accent: #FF8A5B; /* 點綴：柔珊瑚 */
        --theme-light: #FFF7EA; /* 背景：奶油米 */
        --theme-border: #E7ECEF; /* 柔和邊框 */
        --theme-text-primary: #1E2A32; /* 主字色 */
        --theme-text-secondary: #6B7E8E;
        /* 狀態顏色：維持既有 */
        --status-pending: #E74C3C;
        --status-collected: #2ECC71;
        --card-radius: 16px;
    }

    /* 動畫維持，僅微調陰影與對比 */
    * {
        transition: all .3s cubic-bezier(.25,.46,.45,.94);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding: 0 8px;
        animation: slideInFromTop .8s ease-out;
    }

    @@keyframes slideInFromTop {
        from {
            opacity: 0;
            transform: translateY(-30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--theme-text-primary);
        margin: 0;
        display: flex;
        align-items: center;
        text-shadow: none;
    }

        .page-title i {
            margin-right: 12px;
            color: var(--theme-primary) !important;
            font-size: 1.3rem;
            animation: bounce 2s ease-in-out infinite;
        }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-5px)
        }
    }

    /* 統計卡片：淺色雙漸層，讓紅/綠數字自然清楚（不改數字顏色本身） */
    .stats-card {
        background: linear-gradient(135deg, #FFF7EA 0%, #EBF8F6 100%) !important;
        color: var(--theme-text-primary) !important;
        border-radius: var(--card-radius);
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 8px 28px rgba(35,124,119,0.18) !important;
        border: 1px solid rgba(35,124,119,0.12) !important;
        position: relative;
        overflow: hidden;
        animation: fadeInUp .6s ease-out;
    }

        .stats-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 16px 40px rgba(59,167,160,0.22);
        }

        .stats-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,.25) 50%, transparent 100%);
            opacity: .35;
            animation: wave 4s ease-in-out infinite;
            pointer-events: none;
        }

    @@keyframes wave {
        0%, 100% {
            background-position: 0% 50%
        }

        50% {
            background-position: 100% 50%
        }
    }

    .stats-item {
        cursor: pointer;
        border-radius: 12px;
        padding: 16px 8px;
    }

        .stats-item:hover {
            background: rgba(46,133,128,0.06);
        }

    .stats-number {
        font-size: 2.2rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 8px;
        color: #223849; /* 總住戶數維持深字；未領/已領有 inline 顏色，不動 */
        text-shadow: none;
        animation: countUp .8s ease-out;
    }

    @@keyframes countUp {
        from {
            opacity: 0;
            transform: scale(.5)
        }

        to {
            opacity: 1;
            transform: scale(1)
        }
    }

    .stats-number:hover {
        transform: scale(1.08);
    }

    .stats-label {
        font-size: .95rem;
        margin: 0;
        font-weight: 700;
        line-height: 1.3;
        color: var(--theme-text-primary);
        text-shadow: none;
    }

        .stats-label i {
            font-size: 1rem;
            margin-right: 6px;
            color: var(--theme-primary) !important;
            animation: pulse 2s ease-in-out infinite;
        }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: .95
        }

        50% {
            transform: scale(1.06);
            opacity: 1
        }
    }

    .table thead th {
        background: linear-gradient(180deg, var(--theme-primary-dark) 0%, #1E6B66 100%) !important;
        color: #FFFFFF !important;
        border-color: var(--theme-primary-dark) !important;
        text-shadow: none !important;
        font-weight: 800 !important;
    }

        .table thead th i {
            color: #D6F1EF !important; /* 圖示淡薄荷，對比清楚 */
        }

        .table thead th::before { /* 移除原高光帶，避免反白 */
            display: none !important;
        }

    .table thead.sticky-top th {
        box-shadow: inset 0 -1px 0 rgba(255,255,255,0.12) !important;
    }
    /* 重要：不覆蓋紅/綠數字或標籤的 inline 顏色 —— 移除任何 [style*="..."] 的覆寫 */

    .stats-card .row {
        margin: 0
    }

    .stats-card .col-md-4 {
        padding: 12px 16px
    }

    /* 卡片/容器：淺底、柔邊框、低對比陰影 */
    .admin-card {
        background: rgba(255,255,255,.98);
        border: 1px solid var(--theme-border);
        border-radius: var(--card-radius);
        box-shadow: 0 4px 18px rgba(34,56,73,.08);
        padding: 24px;
        margin-bottom: 24px;
        backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
        animation: fadeInUp .6s ease-out;
    }

        .admin-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--theme-primary), #5FC3BD, var(--theme-accent));
            opacity: .7;
            animation: shimmer 3s ease-in-out infinite;
        }

    @@keyframes shimmer {
        0% {
            left: -100%
        }

        50% {
            left: 100%
        }

        100% {
            left: 100%
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .admin-card:hover {
        box-shadow: 0 10px 26px rgba(34,56,73,.12);
        transform: translateY(-3px) scale(1.01);
        border-color: #D7D1C9;
    }

    .admin-table-container {
        background: #FFFFFF;
        border-radius: var(--card-radius);
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(34,56,73,.08);
        border: 1px solid var(--theme-border);
        margin-bottom: 24px;
        backdrop-filter: blur(8px);
        animation: fadeInUp .8s ease-out;
        animation-delay: .2s;
        animation-fill-mode: both;
    }

    /* 表格：主色加深的表頭，內容淺底 */
    .table th {
        background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
        color: #fff;
        font-weight: 700;
        white-space: nowrap;
        border-color: var(--theme-primary);
        text-shadow: 0 1px 2px rgba(0,0,0,.18);
        position: relative;
        overflow: hidden;
    }

        .table th::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
            animation: headerShine 3s ease-in-out infinite;
        }

    @@keyframes headerShine {
        0% {
            left: -100%
        }

        50% {
            left: 100%
        }

        100% {
            left: 100%
        }
    }

    .table th i {
        margin-right: 8px;
        vertical-align: middle;
        font-size: 16px;
        animation: wiggle 3s ease-in-out infinite;
    }

    @@keyframes wiggle {
        0%, 100% {
            transform: rotate(0)
        }

        25% {
            transform: rotate(2deg)
        }

        75% {
            transform: rotate(-2deg)
        }
    }

    .table th, .table td {
        vertical-align: middle;
        text-align: center;
        padding: 18px 14px;
        border: 1px solid var(--theme-border);
        font-size: 15px;
        line-height: 1.4;
        background: #FFFFFF;
    }

    .table tbody tr {
        transition: all .3s cubic-bezier(.25,.46,.45,.94);
        background: #FFFFFF;
        animation: slideInFromLeft .6s ease-out;
        animation-fill-mode: both;
    }

        .table tbody tr:hover {
            background: linear-gradient(135deg, rgba(52,163,160,0.08), rgba(255,138,91,0.05)) !important;
            box-shadow: 0 4px 14px rgba(30,42,50,0.08) !important;
            transform: translateY(-1px) scale(1.003);
        }

        .table tbody tr:nth-child(odd) {
            animation-delay: .1s
        }

        .table tbody tr:nth-child(even) {
            animation-delay: .2s
        }

    @@keyframes slideInFromLeft {
        from {
            opacity: 0;
            transform: translateX(-20px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    /* 按鈕顏色維持原本 #4ECDC4（不更動） */
    .btn-outline-primary {
        border-color: #4ECDC4;
        color: #4ECDC4;
        background: rgba(255,255,255,.96);
        border-width: 2px;
        font-weight: 600;
    }

        .btn-outline-primary:hover {
            background: #4ECDC4;
            border-color: #4ECDC4;
            color: #fff;
            box-shadow: 0 6px 24px rgba(78,205,196,.35);
            transform: translateY(-2px) scale(1.05);
        }

    /* 分頁：活潑主色 + 淺底 hover，更直覺 */
    .pagination .page-link {
        background: #FFFFFF;
        border: 1px solid var(--theme-border);
        color: var(--theme-text-primary);
        padding: 12px 16px;
        margin: 0 4px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        min-width: 48px;
        transition: all .3s cubic-bezier(.25,.46,.45,.94);
    }

        .pagination .page-link:hover {
            background: var(--theme-light) !important;
            color: var(--theme-text-primary);
            border-color: #E4F0EE !important;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 4px 12px rgba(34,56,73,.08);
        }

    .pagination .page-item.active .page-link {
        background: var(--theme-primary);
        border-color: var(--theme-primary);
        color: #fff;
        box-shadow: 0 4px 14px rgba(59,167,160,.28);
        animation: activePagePulse 2s ease-in-out infinite;
    }

    @@keyframes activePagePulse {
        0%, 100% {
            box-shadow: 0 4px 14px rgba(59,167,160,.28)
        }

        50% {
            box-shadow: 0 6px 20px rgba(59,167,160,.40)
        }
    }

    /* 統計超連結：保留狀態色，hover 輕量化 */
    .stat-link {
        text-decoration: none;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
        min-width: 50px;
        border: none;
        font-weight: 700;
        font-size: 16px;
        position: relative;
        overflow: hidden;
        background: transparent;
        transition: all .25s cubic-bezier(.25,.46,.45,.94);
    }

        .stat-link::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(0,0,0,.06), transparent);
            left: -100%;
            transition: left .5s;
        }

        .stat-link:hover::before {
            left: 100%
        }

        .stat-link:hover {
            transform: translateY(-1px) scale(1.02);
            text-shadow: none;
        }

    .stat-pending {
        color: var(--status-pending) !important;
        background: transparent;
        border: none;
    }

        .stat-pending:hover {
            background: rgba(231,76,60,.10);
            color: var(--status-pending) !important;
        }

    .stat-collected {
        color: var(--status-collected) !important;
        background: transparent;
        border: none;
    }

        .stat-collected:hover {
            background: rgba(46,204,113,.10);
            color: var(--status-collected) !important;
        }

    /* 住戶資訊與空狀態 */
    .resident-info {
        font-weight: 700;
        color: var(--theme-text-primary);
        font-size: 15px;
        text-shadow: none;
    }

    .empty-state {
        padding: 50px 20px;
        text-align: center;
        color: var(--theme-text-secondary);
        animation: fadeIn 1s ease-out;
    }

        .empty-state i {
            font-size: 56px;
            margin-bottom: 16px;
            display: block;
            color: #B7E4E0 !important;
            opacity: .7 !important;
            animation: pulse 2s ease-in-out infinite;
        }

        .empty-state h6 {
            font-size: 18px;
            margin-bottom: 8px;
            font-weight: 700;
            color: var(--theme-text-primary);
        }

        .empty-state small {
            font-size: 14px;
            color: var(--theme-text-secondary);
        }

    .btn {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 20px;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        transition: all .4s cubic-bezier(.25,.46,.45,.94);
    }

        .btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.28), transparent);
            left: -100%;
            transition: left .6s;
        }

        .btn:hover::before {
            left: 100%
        }

        .btn:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 20px rgba(0,0,0,.10);
        }

    /* 響應式 */
    @@media (max-width:768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .stats-card {
            padding: 20px
        }

        .stats-number {
            font-size: 1.8rem
        }
    }

    @@media (max-width:576px) {
        .stats-card {
            padding: 18px
        }

        .stats-number {
            font-size: 1.6rem
        }

        .page-title {
            font-size: 1.3rem
        }
    }

    .fade-in {
        animation: fadeIn .6s ease-out
    }

    @@keyframes fadeIn {
        from {
            opacity: 0
        }

        to {
            opacity: 1
        }
    }
</style>



<div class="container-fluid">
    <div id="ResidentStats">
        <div class="page-header">
            <h3 class="page-title">
                <i class="bi bi-graph-up"></i>
                @ViewBag.Title
            </h3>
            <button type="button" class="btn btn-outline-primary" v-on:click="fetchStats">
                <i class="bi bi-arrow-clockwise"></i>
                重新整理
            </button>
        </div>

        <div class="stats-card" v-if="stats.length > 0">
            <div class="row text-center g-2">
                <div class="col-4 col-md-4">
                    <div class="stats-item">
                        <div class="stats-number">{{ stats.length }}</div>
                        <h6 class="stats-label">
                            <i class="bi bi-people"></i>總住戶數
                        </h6>
                    </div>
                </div>
                <div class="col-4 col-md-4">
                    <div class="stats-item">
                        <div class="stats-number" style="color: #E74C3C;">{{ totalUncollected }}</div>
                        <h6 class="stats-label" style="color: #E74C3C;">
                            <i class="bi bi-exclamation-triangle"></i>未領取包裹
                        </h6>
                    </div>
                </div>
                <div class="col-4 col-md-4">
                    <div class="stats-item">
                        <div class="stats-number" style="color: #2ECC71;">{{ totalCollected }}</div>
                        <h6 class="stats-label" style="color: #2ECC71;">
                            <i class="bi bi-check-circle"></i>已領取包裹
                        </h6>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-table-container">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="sticky-top">
                        <tr>
                            <th><i class="bi bi-person"></i>住戶資訊</th>
                            <th><i class="bi bi-exclamation-triangle"></i>未領取包裹</th>
                            <th><i class="bi bi-check-circle"></i>已領取包裹</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="r in pagedStats" :key="r.red_id">
                            <td>
                                <span class="resident-info">{{r.condo_id}} - {{ r.red_name }}</span>
                            </td>
                            <td>
                                <a href="#" class="stat-link stat-pending" v-on:click.prevent="goToResident(r.red_id, '未取')">
                                    {{ r.uncollected }} 件
                                </a>
                            </td>
                            <td>
                                <a href="#" class="stat-link stat-collected" v-on:click.prevent="goToResident(r.red_id, '已取')">
                                    {{ r.collected }} 件
                                </a>
                            </td>
                        </tr>
                        <tr v-if="pagedStats.length === 0">
                            <td colspan="3" class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <h6 class="mb-2">目前無統計資料</h6>
                                <small>請稍後再試或聯繫管理員</small>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <nav v-if="totalPages > 1" class="mt-4">
            <ul class="pagination justify-content-center">
                <li :class="['page-item', { disabled: currentPage === 1 }]">
                    <a class="page-link" href="#" v-on:click.prevent="setPage(currentPage-1)">
                        <i class="bi bi-chevron-left me-1"></i>上一頁
                    </a>
                </li>
                <li v-for="n in visiblePages" :key="n"
                    :class="['page-item', { active: n === currentPage, disabled: n === '...' }]">
                    <a class="page-link" href="#" v-on:click.prevent="n !== '...' && setPage(n)">
                        {{ n }}
                    </a>
                </li>
                <li :class="['page-item', { disabled: currentPage === totalPages }]">
                    <a class="page-link" href="#" v-on:click.prevent="setPage(currentPage+1)">
                        下一頁<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    const app = Vue.createApp({
        data() {
            return {
                stats: [],
                currentPage: 1,
                pageSize: 15
            }
        },
        computed: {
            totalPages() {
                return Math.ceil(this.stats.length / this.pageSize);
            },
            pagedStats() {
                const start = (this.currentPage - 1) * this.pageSize;
                return this.stats.slice(start, start + this.pageSize);
            },
            totalUncollected() {
                return this.stats.reduce((sum, stat) => sum + stat.uncollected, 0);
            },
            totalCollected() {
                return this.stats.reduce((sum, stat) => sum + stat.collected, 0);
            },
            visiblePages() {
                const pages = [];
                const total = this.totalPages;
                const current = this.currentPage;

                if (total <= 7) {
                    for (let i = 1; i <= total; i++) {
                        pages.push(i);
                    }
                } else {
                    pages.push(1);

                    if (current > 4) {
                        pages.push('...');
                    }

                    const start = Math.max(2, current - 2);
                    const end = Math.min(total - 1, current + 2);

                    for (let i = start; i <= end; i++) {
                        pages.push(i);
                    }

                    if (current < total - 3) {
                        pages.push('...');
                    }

                    pages.push(total);
                }

                return pages;
            }
        },
        mounted() {
            this.fetchStats();
        },
        methods: {
            fetchStats() {
                axios.post('/Home/GetResidentPackageStats')
                    .then(res => {
                        if (Array.isArray(res.data)) {
                            this.stats = res.data;
                            this.currentPage = 1;
                        } else {
                            this.stats = [];
                        }
                    })
                    .catch(() => {
                        this.stats = [];
                        console.error('無法載入統計資料');
                    });
            },
            setPage(n) {
                if (n < 1 || n > this.totalPages || n === '...') return;
                this.currentPage = n;
            },
            goToResident(red_id, status) {
                const url = `/Home/Packages?red_id=${encodeURIComponent(red_id)}&status=${encodeURIComponent(status)}`;
                window.location.href = url;
            }
        }
    });

    app.mount('#ResidentStats');
</script>

<script src="/Scripts/common-jwt.js"></script>
