@using ParcelManagement2.Controllers
@model ResidentHomeVm
@{
    ViewBag.Title = "住戶首頁";
    string jsonResidents = (ViewBag.JsonList as string) ?? "[]";
    string selectedResidentId = (ViewBag.SelectedResidentId as string) ?? "";
}

<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
:root{
  --resident-primary:#3F9E95;
  --resident-secondary:#7FCFC3;
  --resident-primary-dark:#2F847C;
  --resident-accent:#CFC7BB;
  --resident-light:#9FB1B1;
  --border-color:#E7E3DA;
  --card-radius:12px;
  --status-pending:#E74C3C;
  --status-collected:#2ECC71;
  --text-primary:#1E2A2A;
  --text-secondary:#6c757d;
}

/* ===== 基本框架 ===== */
.resident-container{padding:15px;margin:0;min-height:100vh;background:linear-gradient(135deg,#f8f9fa 0%,#e9ecef 100%);}
.welcome-card{background:linear-gradient(135deg,var(--resident-primary) 0%,var(--resident-secondary) 100%);color:#fff;border-radius:var(--card-radius);padding:20px 25px;margin-bottom:20px;box-shadow:0 4px 20px rgba(44,62,80,.2);position:relative;overflow:hidden;}
.welcome-card::before{content:'';position:absolute;top:-50%;right:-50%;width:200px;height:200px;background:rgba(255,255,255,.1);border-radius:50%;z-index:1;}
.welcome-content{position:relative;z-index:2;}
.welcome-title{font-size:1.4rem;font-weight:700;margin-bottom:8px;display:flex;align-items:center;flex-wrap:wrap;}
.welcome-title i{margin-right:10px;font-size:1.2rem;color:rgba(255,255,255,.9);}
.resident-link{color:rgba(255,255,255,.9);text-decoration:none;border-bottom:2px solid rgba(255,255,255,.3);transition:.3s;}
.resident-link:hover{color:#fff;border-bottom-color:#fff;}
.condo-info{font-size:1rem;margin-top:6px;color:rgba(255,255,255,.9);font-weight:500;}
.member-selector{margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.2);}
.member-select-label{font-size:13px;margin-bottom:6px;color:rgba(255,255,255,.9);font-weight:500;}
.member-select{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:6px;padding:6px 10px;font-size:13px;transition:.3s;max-width:220px;}
.member-select:focus{background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.5);outline:none;box-shadow:0 0 0 2px rgba(255,255,255,.2);}
.member-select option{background:var(--resident-primary);color:#fff;}

.layout-container{display:flex;gap:20px;align-items:stretch;min-height:calc(100vh - 300px);}
.left-column,.right-column{flex:1;display:flex;flex-direction:column;min-height:auto;}
.left-column{gap:20px;max-width:45%;min-height:calc(100vh - 300px);}
.right-column{max-width:55%;}

/* ===== 卡片與表格 ===== */
.resident-card{background:#fff;border:1px solid var(--border-color);border-radius:var(--card-radius);box-shadow:0 2px 8px rgba(0,0,0,.08);transition:.3s;padding:20px;position:relative;display:flex;flex-direction:column;overflow:hidden;}
.resident-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.12);transform:translateY(-2px);}
.resident-card.residents-card{flex:none;height:280px;min-height:280px;max-height:280px;}
.resident-card.mails-card{flex:1;min-height:300px;}
.resident-card.full-height{flex:1;min-height:680px;display:flex;flex-direction:column;}
.resident-card.full-height .resident-table-container{flex:1;display:flex;flex-direction:column;}
.resident-card.full-height .table-wrapper{overflow-y:auto;overflow-x:hidden;border:1px solid var(--border-color);border-radius:4px;}
.resident-card.full-height .table-wrapper::-webkit-scrollbar{width:8px;}
.resident-card.full-height .table-wrapper::-webkit-scrollbar-track{background:#f1f1f1;border-radius:4px;}
.resident-card.full-height .table-wrapper::-webkit-scrollbar-thumb{background:var(--resident-light);border-radius:4px;}
.resident-card.full-height .table-wrapper::-webkit-scrollbar-thumb:hover{background:var(--resident-primary);}
.resident-card.full-height .resident-table{margin:0;border:none;border-collapse:separate;border-spacing:0;width:100%;font-size:14px;}

.card-title{font-size:1.2rem;font-weight:600;color:var(--resident-primary);margin-bottom:15px;display:flex;align-items:center;border-bottom:2px solid var(--border-color);padding-bottom:10px;flex-shrink:0;}
.card-title i{margin-right:8px;color:var(--resident-accent);font-size:1.1rem;}
.card-title .badge{margin-left:auto;font-size:11px;padding:4px 8px;border-radius:12px;}

.resident-table-container{background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06);border:1px solid var(--border-color);flex:1;display:flex;flex-direction:column;}
.table-wrapper{flex:1;overflow-y:auto;display:flex;flex-direction:column;}
.resident-table{margin:0;border:none;border-collapse:separate;border-spacing:0;width:100%;font-size:14px;flex:1;height:100%;}
.resident-table thead th{background:var(--resident-primary);color:#fff;font-weight:600;font-size:14px;padding:12px 10px;text-align:center;border:none;position:sticky;top:0;z-index:10;}
.resident-table tbody td{padding:10px 8px;text-align:center;height:70px;font-size:14px;border-bottom:1px solid var(--border-color);vertical-align:middle;transition:background-color .2s;}
.resident-table tbody tr:hover td{background-color:rgba(63,158,149,.08);}
.resident-table tbody tr:last-child td{border-bottom:none;}
.resident-table tbody tr.empty-row td{height:40px;border-bottom:1px solid rgba(222,226,230,.3);color:transparent;}
.resident-table tbody tr.empty-row:hover td{background-color:transparent;}

.empty-state{text-align:center;padding:60px 20px;color:#6c757d;}
.empty-state i{font-size:36px;margin-bottom:12px;opacity:.5;}
.empty-state h6{font-size:15px;margin-bottom:6px;font-weight:600;color:var(--resident-primary);}
.empty-state p{font-size:13px;margin:0;opacity:.8;}

/* ===== 狀態/字樣 ===== */
.package-id{background:transparent!important;padding:0!important;border-radius:0!important;box-shadow:none!important;font-family:inherit!important;font-size:14px;font-weight:700;border:0!important;color:var(--text-primary)!important;display:inline-block;}
.status-badge{padding:6px 15px;border-radius:15px;font-size:14px;font-weight:600;text-align:center;display:inline-block;cursor:pointer;transition:.2s;border:1px solid;text-decoration:none;}
.status-badge:hover{transform:scale(1.05);box-shadow:0 2px 6px rgba(0,0,0,.2);}
.status-badge-pending{background:#fff5f5;border-color:var(--status-pending);color:var(--status-pending);}
.status-badge-pending:hover{background:var(--status-pending);color:#fff;}
.status-badge-mail{background:#fff8dc;border-color:#f39c12;color:#f39c12;}
.status-badge-mail:hover{background:#f39c12;color:#fff;}

.resident-info{font-weight:600;color:var(--text-primary);font-size:16px;}
.resident-id{background:var(--resident-primary);color:#fff;padding:4px 12px;border-radius:3px;font-size:14px;font-weight:600;display:inline-block;}
.resident-phone{color:var(--text-primary);letter-spacing:.2px;padding:4px 12px;font-size:16px;font-weight:700;font-family:'Courier New',monospace;}

/* ===== 載入 ===== */
.loading{text-align:center;padding:60px 20px;color:#6c757d;}
.loading i{animation:spin 1s linear infinite;font-size:24px;margin-bottom:10px;display:block;color:var(--resident-primary);}
.loading p{font-size:14px;margin:0;}
.spin{animation:spin 1s linear infinite;}
@@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

/* ===== 通知條 ===== */
.mail-notification-bar{background:linear-gradient(135deg,#f39c12 0%,#e67e22 100%);color:#fff;border-radius:var(--card-radius);margin-bottom:20px;box-shadow:0 4px 15px rgba(243,156,18,.3);overflow:hidden;animation:slideInDown .5s ease-out;}
.notification-content{display:flex;align-items:center;padding:15px 20px;gap:15px;}
.notification-icon{font-size:24px;color:rgba(255,255,255,.9);animation:bellShake 2s ease-in-out infinite;}
.notification-text{flex:1;}
.notification-text h6{margin:0 0 3px 0;font-size:16px;font-weight:600;}
.notification-text small{font-size:13px;color:rgba(255,255,255,.8);}

/* ===== 信件清單（卡片滾動） ===== */
.mail-scroll-container{min-height:330px;overflow-y:auto;overflow-x:hidden;padding:8px;display:flex;flex-direction:column;gap:12px;}
.mail-scroll-container::-webkit-scrollbar{width:8px;}
.mail-scroll-container::-webkit-scrollbar-track{background:#f1f1f1;border-radius:10px;}
.mail-scroll-container::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--resident-primary),var(--resident-secondary));border-radius:10px;}
.mail-card-item{background:linear-gradient(135deg,#fff 0%,#f8f9fa 100%);border:1px solid #e9ecef;border-left:4px solid var(--resident-primary);border-radius:12px;padding:16px;transition:.3s;box-shadow:0 2px 8px rgba(0,0,0,.05);animation:slideIn .4s ease;}
.mail-card-item:hover{transform:translateX(4px);box-shadow:0 4px 16px rgba(63,158,149,.15);border-left-color:var(--resident-secondary);}
.mail-card-header{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;}
.mail-icon{font-size:28px;color:var(--resident-primary);flex-shrink:0;animation:bounce 2s infinite;}
.mail-info{flex:1;min-width:0;}
.mail-id{font-family:'Courier New',monospace;font-size:15px;font-weight:700;color:#2c3e50;margin-bottom:6px;letter-spacing:.5px;}
.mail-type{margin-top:4px;}
.badge-mail{display:inline-flex;align-items:center;padding:4px 12px;background:linear-gradient(135deg,#ffc107,#ff9800);color:#fff;font-size:12px;font-weight:600;border-radius:12px;box-shadow:0 2px 6px rgba(255,193,7,.3);}
.mail-card-footer{display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid #e9ecef;}
.mail-time{font-size:13px;color:#6c757d;display:flex;align-items:center;}
.mail-time i{opacity:.7;}
.mail-status{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#dc3545;}
.status-dot{width:8px;height:8px;background:#dc3545;border-radius:50%;animation:pulse 2s infinite;}

/* ===== 包裹清單（卡片滾動） ===== */
.package-scroll-container{max-height:600px;overflow-y:auto;overflow-x:hidden;padding:8px;display:flex;flex-direction:column;gap:12px;}
.package-scroll-container::-webkit-scrollbar{width:8px;}
.package-scroll-container::-webkit-scrollbar-track{background:#f1f1f1;border-radius:10px;}
.package-scroll-container::-webkit-scrollbar-thumb{background:linear-gradient(180deg,#E74C3C,#C0392B);border-radius:10px;}
.package-scroll-container::-webkit-scrollbar-thumb:hover{background:#E74C3C;}

.package-card-item{background:linear-gradient(135deg,#fff 0%,#f8f9fa 100%);border:1px solid #e9ecef;border-left:4px solid #E74C3C;border-radius:12px;padding:16px;cursor:pointer;transition:.3s;box-shadow:0 2px 8px rgba(0,0,0,.05);animation:slideIn .4s ease;}
.package-card-item:hover{transform:translateY(-4px) scale(1.02);box-shadow:0 6px 20px rgba(231,76,60,.2);border-left-color:#C0392B;}
.package-card-item:active{transform:translateY(-2px) scale(1.01);}
.package-card-header{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;}
.package-icon{font-size:32px;color:#E74C3C;flex-shrink:0;animation:packageBounce 2s infinite;}
.package-info{flex:1;min-width:0;}
.package-id{font-family:'Courier New',monospace;font-size:16px;font-weight:700;color:#2c3e50;margin-bottom:6px;letter-spacing:.5px;word-break:break-all;}
.package-type{margin-top:4px;}
.badge-package{display:inline-flex;align-items:center;padding:4px 12px;background:linear-gradient(135deg,var(--resident-primary),var(--resident-secondary));color:#fff;font-size:12px;font-weight:600;border-radius:12px;box-shadow:0 2px 6px rgba(63,158,149,.3);white-space:nowrap;}
.package-card-body{padding:12px 0;border-top:1px solid #e9ecef;border-bottom:1px solid #e9ecef;margin-bottom:12px;}
.package-recipient{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:#495057;}
.package-recipient i{color:var(--resident-primary);font-size:18px;flex-shrink:0;}
.package-recipient span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.package-card-footer{display:flex;justify-content:space-between;align-items:center;}
.package-status{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#E74C3C;}
.status-dot-red{width:8px;height:8px;background:#E74C3C;border-radius:50%;animation:pulse 2s infinite;}
.package-action{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--resident-primary);padding:4px 12px;background:rgba(63,158,149,.1);border-radius:8px;transition:.3s;}
.package-card-item:hover .package-action{background:var(--resident-primary);color:#fff;transform:translateX(4px);}
.package-action i{font-size:14px;}


/* 右欄高度控制 */
.right-column .full-height{height:100%;display:flex;flex-direction:column;}
.right-column .full-height .card-content{flex:1;overflow:hidden;}

/* ===== 共用空狀態/顏色 ===== */
.empty-state i{font-size:64px;opacity:.3;margin-bottom:20px;display:block;}
.empty-state i.bi-inbox{color:#E74C3C;}
.empty-state i.bi-envelope-open{color:var(--resident-primary);}
.empty-state h6{font-size:18px;font-weight:600;color:#495057;margin-bottom:8px;}
.empty-state p{font-size:14px;color:#6c757d;margin:0;}

/* ===== 動畫 ===== */
@@keyframes slideInDown{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}
@@keyframes slideDown{from{max-height:0;opacity:0}to{max-height:500px;opacity:1}}
@@keyframes bellShake{
  0%,100%{transform:rotate(0)}
  10%,30%,50%,70%,90%{transform:rotate(-10deg)}
  20%,40%,60%,80%{transform:rotate(10deg)}
}
@@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@@keyframes packageBounce{0%,100%{transform:translateY(0) rotate(0)}25%{transform:translateY(-4px) rotate(-5deg)}75%{transform:translateY(-2px) rotate(5deg)}}
@@keyframes slideIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(1.2)}}

/* ===== 照片 Modal（精簡 RWD） ===== */
#packagePhotoModal .modal-dialog{max-width:900px;}
@@media (max-width:992px){#packagePhotoModal .modal-dialog{margin:12px;max-width:100%;}}
#packagePhotoModal .modal-content{max-height:calc(100vh - 24px);display:flex;flex-direction:column;}
#packagePhotoModal .modal-body{overflow:auto;}
.package-info-compact{background:#f8f9fa;padding:8px 12px;border-radius:6px;border:1px solid #dee2e6;font-size:14px;}
.package-info-compact .text-muted{font-size:14px;font-weight:600;margin-bottom:2px;}
.package-info-compact .small{font-size:14px;font-weight:500;}

#photo-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;padding:4px 0;}
.photo{position:relative;border:1px solid #dee2e6;border-radius:8px;background:#fff;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.08);}
.photo img{width:100%;height:auto;display:block;max-height:calc(100vh - 260px);object-fit:contain;cursor:zoom-in;}
.photo .label{position:absolute;left:8px;right:8px;bottom:8px;background:rgba(0,0,0,.7);color:#fff;padding:6px 10px;border-radius:6px;text-align:center;font-weight:600;}

    #photo-loading, #no-photos {
        padding: 40px 20px;
        text-align: center;
        color: var(--light-color);
    }

        #no-photos i {
            font-size: 3rem;
            opacity: .3;
            margin-bottom: 15px;
            display: block;
        }

.fullscreen-viewer{position:fixed;inset:0;background:rgba(0,0,0,.95);display:flex;align-items:center;justify-content:center;z-index:9999;cursor:zoom-out;}
.fullscreen-viewer img{max-width:95%;max-height:95%;object-fit:contain;border-radius:8px;box-shadow:0 4px 24px rgba(0,0,0,.5);}

/* ===== RWD ===== */
@@media (max-width:992px){
  .layout-container{flex-direction:column;gap:15px;min-height:auto;}
  .left-column,.right-column{flex:none;max-width:none;min-height:auto;}
  .left-column{gap:15px;}
  .resident-card.residents-card,.resident-card.mails-card,.resident-card.full-height{flex:none;margin-bottom:15px;height:auto;min-height:300px;max-height:none;}
}
@@media (max-width:768px){
  .resident-container{padding:12px;}
  .welcome-card{padding:15px 20px;margin-bottom:15px;}
  .welcome-title{font-size:1.3rem;}
  .layout-container{gap:12px;}
  .left-column{gap:12px;min-height:auto;}
  .resident-card{padding:15px;}
  .resident-card.residents-card{height:auto;min-height:250px;max-height:none;}
  .card-title{font-size:1.1rem;}
  .empty-state{padding:25px 10px;min-height:100px;}
  .empty-state i{font-size:28px;}
  #packagePhotoModal .modal-dialog{margin:10px;max-width:calc(100% - 20px);}
}
@@media (max-width:576px){
  .resident-container{padding:10px;}
  .welcome-card{padding:12px 15px;}
  .welcome-title{font-size:1.2rem;}
  .layout-container{gap:10px;}
  .left-column{gap:10px;min-height:auto;}
  .resident-card{padding:12px;}
  .resident-card.residents-card{height:auto;min-height:200px;}
  .card-title{font-size:1rem;}
  .resident-table thead th{padding:9px 6px;font-size:14px;}
  .resident-table tbody td{padding:9px 6px;font-size:13px;height:60px;white-space:normal;overflow:hidden;text-overflow:ellipsis;}
  .resident-table tbody tr.empty-row td{height:60px;}
  #photo-gallery{grid-template-columns:1fr;gap:10px;padding:4px;}
  .photo img{max-height:calc(100vh - 220px);}
}
/* 小數量列表高度調整 */
.mail-scroll-container:has(.mail-card-item:only-child){max-height:none;}
.mail-scroll-container:has(.mail-card-item:nth-child(-n+2)){max-height:200px;}
.package-scroll-container:has(.package-card-item:only-child){max-height:none;}
.package-scroll-container:has(.package-card-item:nth-child(-n+2)){max-height:630px;}
</style>

<div class="resident-container" id="ResidentApp">
    <!-- 歡迎標題卡片 -->
    <div class="welcome-card">
        <div class="welcome-content">
            <h1 class="welcome-title">
                <i class="bi bi-house-heart"></i>
                歡迎回來，<a href="/Resident/Edit" class="resident-link">
                    <span v-if="currentMemberName">{{ currentMemberName }}</span>
                    <span v-else>@Model.FullName</span>
                </a>
            </h1>
            <div class="condo-info">
                <i class="bi bi-geo-alt me-2"></i>戶號：@Model.Condo_Id
            </div>
            <!-- 成員選擇器 (僅在有多個成員時顯示) -->
            @if (Model.HasMultipleMembers)
            {
                <div class="member-selector">
                    <label class="member-select-label">
                        <i class="bi bi-person-check me-2"></i>目前登入身份：
                    </label>
                    <select class="member-select" v-model="selectedMemberId" v-on:change="changeMember">
                        <option v-for="member in members" :value="member.red_id" :key="member.red_id">
                            {{ member.red_id }} - {{ member.red_name }}
                        </option>
                    </select>
                </div>
            }
        </div>
    </div>
    @{
        var photoCount = Model?.ProfilePhotoCount ?? (ViewBag.ProfilePhotoCount as int? ?? 0);
    }
    @if (photoCount < 5)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert" style="border-left:4px solid #E74C3C;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            為了完整識別，請上傳滿 <strong>5</strong> 張個人照片，您目前有 <strong>@photoCount</strong> 張，
            尚缺 <strong>@(5 - photoCount)</strong> 張。
            <a href="/Resident/Edit" class="btn btn-sm btn-primary ms-3">前往上傳</a>
        </div>
    }
    <div v-if="mails && mails.length > 0" class="mail-notification-bar">
        <div class="notification-content">
            <div class="notification-icon">
                <i class="bi bi-envelope-exclamation"></i>
            </div>
            <div class="notification-text">
                <h6>貴戶有信件，請查收</h6>
                <small>共有 {{ mails.length }} 封信件待領取</small>
            </div>
        </div>
    </div>
    <!-- 主要內容區域 -->
    <div class="layout-container">
        <!-- 左欄：戶內住戶 + 待領取信件 -->
        <div class="left-column">
            <!-- 戶內住戶資訊 -->
            <div class="resident-card residents-card">
                <h3 class="card-title">
                    <i class="bi bi-people"></i>戶內住戶
                </h3>
                <div class="card-content">
                    <div class="resident-table-container">
                        <div class="table-wrapper">
                            <table class="table resident-table">
                                <thead>
                                    <tr>
                                        <th><i class="bi bi-person-badge me-1"></i>住戶編號</th>
                                        <th><i class="bi bi-person me-1"></i>姓名</th>
                                        <th><i class="bi bi-telephone me-1"></i>電話</th>
                                    </tr>
                                </thead>
                                <tbody id="tblResidents">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 待領取信件  -->
            <div class="resident-card mails-card">
                <h3 class="card-title">
                    <i class="bi bi-envelope"></i>待領取信件
                    <span v-if="mails.length > 0" class="badge bg-warning">{{ mails.length }}</span>
                </h3>
                <div class="card-content">
                    <!-- 載入狀態 -->
                    <div v-if="mailsLoading" class="loading">
                        <i class="bi bi-arrow-clockwise spin"></i>
                        <p>載入中...</p>
                    </div>

                    <!-- 信件清單 -->
                    <div v-else-if="mails && mails.length > 0" class="mail-scroll-container">
                        <div class="mail-card-item" v-for="m in mails" :key="m.pack_id" v-on:click="viewMailPhoto(m.pack_id)" style="cursor: pointer;">
                            <div class="mail-card-header">
                                <i class="bi bi-envelope-fill mail-icon"></i>
                                <div class="mail-info">
                                    <div class="mail-id">{{ m.pack_id }}</div>
                                    <div class="mail-type">
                                        <span class="badge-mail">
                                            <i class="bi bi-tag-fill me-1"></i>{{ m.pack_name || '信件' }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="mail-card-footer">
                                <div class="mail-time">
                                    <i class="bi bi-clock me-1"></i>
                                    {{ formatDateTime(m.create_time) }}
                                </div>
                                <div class="mail-status">
                                    <span class="status-dot"></span>
                                    未領取
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 空狀態 -->
                    <div v-else class="empty-state">
                        <i class="bi bi-envelope-open"></i>
                        <h6>目前沒有信件</h6>
                        <p>所有信件都已領取完畢</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- 右欄：待領取包裹 -->
        <div class="right-column">
            <div class="resident-card full-height">
                <h3 class="card-title">
                    <i class="bi bi-box-seam"></i>待領取包裹
                    <span v-if="packages.length > 0" class="badge bg-danger">{{ packages.length }}</span>
                </h3>
                <div class="card-content">
                    <div class="resident-table-container">
                        <!-- 載入狀態 -->
                        <div v-if="packagesLoading" class="loading">
                            <i class="bi bi-arrow-clockwise"></i>
                            <p>載入包裹資料中...</p>
                        </div>
                        <!-- 包裹清單 -->
                        <div v-else-if="packages && packages.length > 0" class="package-scroll-container">
                            <div class="package-card-item"
                                 v-for="p in packages"
                                 :key="p.pack_id"
                                 v-on:click="viewPackagePhoto(p.pack_id)"
                                 title="點擊查看包裹照片">
                                <div class="package-card-header">
                                    <i class="bi bi-box-seam-fill package-icon"></i>
                                    <div class="package-info">
                                        <div class="package-id">{{ p.pack_id }}</div>
                                        <div class="package-type">
                                            <span class="badge-package">
                                                <i class="bi bi-box me-1"></i>{{ p.pack_name || '包裹' }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="package-card-body">
                                        <div class="package-recipient">
                                            <i class="bi bi-person-circle me-2"></i>
                                            <span>{{ p.red_name }}</span>
                                        </div>
                                </div>
                                <div class="package-card-footer">
                                    <div class="package-status">
                                        <span class="status-dot status-dot-red"></span>
                                        未領取
                                    </div>
                                    <div class="package-action">
                                        <i class="bi bi-camera"></i>
                                        查看照片
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- 空狀態 -->
                        <div v-else class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h6>目前沒有待領取的包裹</h6>
                            <p>所有包裹都已領取完畢</p>
                        </div>
                    </div>
                </div>
            </div>
        </div> 
    </div>
</div>
<!-- 包裹照片模態視窗 -->
<div class="modal fade" id="packagePhotoModal" tabindex="-1" aria-labelledby="packagePhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="packagePhotoModalLabel">
                    <i class="bi bi-camera me-2"></i>包裹照片
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <div id="package-info" style="display:none; background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;font-size:18px">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>包裹編號：</strong><code id="modal-package-id"></code></p>
                            <p class="mb-2"><strong>類別：</strong><span id="modal-package-name"></span></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>收件人：</strong><span id="modal-recipient"></span></p>
                            <p class="mb-2"><strong>送達時間：</strong><span id="modal-create-time"></span></p>
                        </div>
                    </div>
                </div>
                <div id="photo-loading" class="text-center" style="display:none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">正在載入照片...</p>
                </div>
                <div id="photo-gallery"></div>
                    <!-- 無照片狀態 -->
                <div id="no-photos" class="text-center" style="display: none; padding: 40px 20px;">
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <i class="bi bi-box-seam package-icon-animation"
                            style="font-size: 64px; color: var(--resident-primary); margin-bottom: 15px; display: block;"></i>
                        <h6 style="font-size: 16px; font-weight: 600; color: #495057; margin-bottom: 6px;">
                            此包裹暫無照片
                        </h6>
                        <small style="font-size: 12px; color: #6c757d;">
                            建議收取包裹時拍照記錄
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        /* 戶內所有住戶清單 */
        (function () {
            const data = @Html.Raw(jsonResidents);
            const tbody = document.getElementById('tblResidents');

            if (data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="empty-state">
                            <i class="bi bi-person-plus"></i>
                            <h6>尚未建立住戶資料</h6>
                            <p>請聯繫管理員新增住戶資訊</p>
                        </td>
                    </tr>`;
                return;
            }

            const rows = data.map(function(r) {
                return `
                    <tr>
                        <td><span class="resident-id">${r.red_id}</span></td>
                        <td><span class="resident-info">${r.red_name}</span></td>
                        <td><span class="resident-phone">${r.phone || '-'}</span></td>
                    </tr>`;
            }).join('');
            tbody.innerHTML = rows;
        })();

        const { createApp } = Vue;
        createApp({
            data: function() {
                return {
                    packages: [],
                    mails: [],
                    members: @Html.Raw(jsonResidents),
                    selectedMemberId: '@Html.Raw(selectedResidentId)',
                    packagesLoading: true,
                    mailsLoading: true,
                    currentMemberName: '',
                    showMailDetails: false
                };
            },
            mounted: function() {
                this.fetchPackages();
                this.fetchMails();
                this.initCurrentMemberName();
            },
            methods: {
                viewMailPhoto: function(packId) {
                    this.viewPackagePhoto(packId);
                },
                formatDateTime: function(dateTimeStr) {
                    if (!dateTimeStr) return '-';
                    try {
                        var date = new Date(dateTimeStr);
                        var month = ('0' + (date.getMonth() + 1)).slice(-2);
                        var day = ('0' + date.getDate()).slice(-2);
                        var hours = ('0' + date.getHours()).slice(-2);
                        var minutes = ('0' + date.getMinutes()).slice(-2);
                        return month + '/' + day + ' ' + hours + ':' + minutes;
                    } catch (e) {
                        return dateTimeStr;
                    }
                },
                toggleMailDetails: function() {
                this.showMailDetails = !this.showMailDetails;
                },
                initCurrentMemberName: function() {
                    var self = this;
                    if (self.selectedMemberId && self.members.length > 0) {
                        var selectedMember = self.members.find(function(member) {
                            return member.red_id === self.selectedMemberId;
                        });
                        if (selectedMember) {
                            self.currentMemberName = selectedMember.red_name;
                        }
                    }
                },
                changeMember: function() {
                    var self = this;
                    if (!self.selectedMemberId) {
                        self.showMessage('請選擇成員','error');
                        return;
                    }
                    console.log('切換成員:', self.selectedMemberId);
                    const params = new URLSearchParams();
                    params.append('residentId',self.selectedMemberId);

                    axios.post('/Resident/SelectMember',params, {
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    })
                    .then(function(res) {
                        console.log('API回應:',res.data);

                        if (res.data && res.data.success) {
                            self.currentMemberName = res.data.memberName;
                            self.fetchPackages();
                            self.fetchMails();
                            self.showMessage('已切換為：' + res.data.memberName, 'success');
                        } else {
                            self.showMessage(res.data.message || '切換失敗', 'error');
                        }
                    })
                    .catch(function(error) {
                        console.error('API 錯誤:', error);

                        if (error.response) {
                            // API 有回應但出錯
                            console.error('錯誤狀態:', error.response.status);
                            console.error('錯誤資料:', error.response.data);

                            if (error.response.status === 404) {
                                self.showMessage('找不到 API 端點，請檢查路由設定', 'error');
                            } else {
                                self.showMessage(error.response.data?.message || '切換成員時發生錯誤', 'error');
                            }
                        } else if (error.request) {
                            // 請求發送但沒收到回應
                            self.showMessage('無法連接到伺服器', 'error');
                        } else {
                            // 其他錯誤
                            self.showMessage('切換成員時發生錯誤', 'error');
                        }
                    });
                },

                fetchPackages: function() {
                    var self = this;
                    self.packagesLoading = true;
                    axios.post('/Resident/GetUncollectedPackages')
                         .then(function(res) {
                             self.packages = res.data || [];
                             self.packagesLoading = false;
                         })
                         .catch(function() {
                             self.packages = [];
                             self.packagesLoading = false;
                         });
                },

                fetchMails: function() {
                    var self = this;
                    self.mailsLoading = true;
                    axios.post('/Resident/GetUncollectedMails')
                         .then(function(res) {
                             self.mails = res.data || [];
                             self.mailsLoading = false;
                         })
                         .catch(function() {
                             self.mails = [];
                             self.mailsLoading = false;
                         });
                },

                // 查看包裹照片功能
                viewPackagePhoto: function(packageId) {
                    console.log('查看包裹照片:', packageId);

                    if (!packageId) {
                        alert('包裹編號不能為空');
                        return;
                    }

                    // 顯示載入狀態
                    document.getElementById('photo-loading').style.display = 'block';
                    document.getElementById('photo-gallery').innerHTML = '';
                    document.getElementById('no-photos').style.display = 'none';
                    document.getElementById('package-info').style.display = 'none';

                    // 開啟模態視窗
                    var modal = new bootstrap.Modal(document.getElementById('packagePhotoModal'));
                    modal.show();

                    // 設定模態視窗標題
                    document.getElementById('packagePhotoModalLabel').innerHTML =
                        '<i class="bi bi-camera me-1"></i>包裹照片 - ' + packageId;

                    axios.post('/Resident/GetPackagePhotos', {
                        packageId: packageId.toString()
                    }, {
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    })
                    .then(function(res) {
                        document.getElementById('photo-loading').style.display = 'none';

                        if (res.data.success) {
                            // 填入包裹資訊
                            document.getElementById('package-info').style.display = 'block';
                            document.getElementById('modal-package-id').textContent = res.data.packageId;
                            document.getElementById('modal-package-name').textContent = res.data.packageName;
                            var recipientDisplay = res.data.recipientId
                                ? res.data.recipientName + ' (' + res.data.recipientId + ')'
                                : (res.data.condoId || '未指定');
                            document.getElementById('modal-recipient').textContent = recipientDisplay;
                            document.getElementById('modal-create-time').textContent = res.data.createTime;

                            // 顯示照片
                            if (res.data.photos && res.data.photos.length > 0) {
                                var galleryHtml = res.data.photos.map(function(photoUrl, index) {
                                    const isBase64 = photoUrl.startsWith('data:image/');
                                    const photoType = isBase64 ? '系統照片' : '檔案照片';

                                    return `
                                        <div class="photo-item mb-3" style="text-align:center;">
                                        <div style="position:relative; display:inline-block; max-width:100%;">
                                            <img src="${photoUrl}"
                                                 alt="包裹照片 ${index + 1}"
                                                 class="img-fluid rounded shadow"
                                                 style="max-width; height: 500px; cursor: zoom-in;
                                                        border: 2px solid #dee2e6; transition: all 0.3s ease;"
                                                 onclick="openFullscreen(this)"
                                                 onmouseover="this.style.borderColor='var(--primary-color)'; this.style.transform='scale(1.02)';"
                                                 onmouseout="this.style.transform=''; this.style.borderColor='#dee2e6';"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div style="display:none; flex-direction:column; align-items:center; justify-content:center;
                                                     width:750px;height:300px; color:#6c757d; background:#f8f9fa; border-radius:8px; border: 2px solid #dee2e6;">
                                                    <i class="bi bi-box-seam" style="font-size:60px; color:var(--resident-primary); margin-bottom:15px;
                                                       animation:packagePulse 2s ease-in-out infinite;"></i>
                                                    <p style="margin:0; font-size:14px;">照片載入失敗</p>
                                                </div>
                                            <div style="position:absolute; bottom:5px; left:5px; right:5px; background:rgba(0,0,0,0.7);
                                                 color:white; padding:6px 10px; border-radius:6px; text-align:center;">
                                                <small style="font-size:11px; font-weight:600;">${photoType} ${index + 1}</small>
                                            </div>
                                        </div>
                                    </div>`;
                            }).join('');
                            document.getElementById('photo-gallery').innerHTML = galleryHtml;
                        } else {
                            // 沒有照片時顯示包裹圖標
                            document.getElementById('no-photos').style.display = 'block';
                        }
                    } else {
                        document.getElementById('no-photos').style.display = 'block';
                    }
                })
                .catch(function(error) {
                    console.error('載入包裹照片錯誤:', error);
                    document.getElementById('photo-loading').style.display = 'none';
                    document.getElementById('no-photos').style.display = 'block';
                });
                },

                showMessage: function(message, type) {
                    if (type === 'success') {
                        alert('✓ ' + message);
                    } else {
                        alert('✗ ' + message);
                    }
                }
            }
        }).mount('#ResidentApp');

        // 全螢幕照片查看功能
        function openFullscreen(img) {
            var existingViewer = document.querySelector('[data-viewer="true"]');
            if (existingViewer && existingViewer.parentNode) {
                document.body.removeChild(existingViewer);
            }
            var viewer = document.createElement('div');
            viewer.className = 'fullscreen-viewer';
            viewer.setAttribute('data-viewer', 'true');

            var fullImg = document.createElement('img');
            fullImg.src = img.src;
            fullImg.alt = img.alt;

            viewer.appendChild(fullImg);

            // 點擊任何地方都可以關閉
            viewer.onclick = function() {
                closeFullscreenViewer();
            };

            // ESC 鍵關閉
            var escHandler = function(e) {
                if (e.key === 'Escape') {
                    closeFullscreenViewer();
                    document.removeEventListener('keydown', escHandler);
                }
            };
                // 關閉全螢幕檢視器的安全函數
            function closeFullscreenViewer() {
                var existingViewer = document.querySelector('[data-viewer="true"]');
                if (existingViewer && existingViewer.parentNode) {
                    try {
                        document.body.removeChild(existingViewer);
                    } catch (e) {
                        console.warn('無法移除全螢幕檢視器:', e);
                    }
                }
                document.removeEventListener('keydown', escHandler);
            }
            document.addEventListener('keydown', escHandler);
            document.body.appendChild(viewer);
        }
    </script>
}
