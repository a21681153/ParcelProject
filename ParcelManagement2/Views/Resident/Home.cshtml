@using ParcelManagement2.Controllers
@model ResidentHomeVm
@{
    ViewBag.Title = "住戶首頁";
    string jsonResidents = (ViewBag.JsonList as string) ?? "[]";
    string selectedResidentId = (ViewBag.SelectedResidentId as string) ?? "";
}

<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
        --resident-primary: #3F9E95; 
        --resident-secondary: #7FCFC3;
        --resident-primary-dark: #2F847C;
        --resident-accent: #CFC7BB;
        --resident-light: #9FB1B1;
        --border-color: #E7E3DA;
        --card-radius: 12px;

        --status-pending: #E74C3C;
        --status-collected: #2ECC71;
        --text-primary: #1E2A2A;
        --text-secondary: #6c757d;
    }

    /* 主容器 */
    .resident-container {
        padding: 15px;
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    /* 歡迎標題卡片*/
    .welcome-card {
        background: linear-gradient(135deg, var(--resident-primary) 0%, var(--resident-secondary) 100%);
        color: white;
        border-radius: var(--card-radius);
        padding: 20px 25px; 
        margin-bottom: 20px; 
        box-shadow: 0 4px 20px rgba(44, 62, 80, 0.2);
        position: relative;
        overflow: hidden;
    }

        .welcome-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            z-index: 1;
        }

    .welcome-content {
        position: relative;
        z-index: 2;
    }

    .welcome-title {
        font-size: 1.4rem; 
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

        .welcome-title i {
            margin-right: 10px;
            font-size: 1.2rem; 
            color: rgba(255, 255, 255, 0.9);
        }

    .resident-link {
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        border-bottom: 2px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

        .resident-link:hover {
            color: white;
            border-bottom-color: white;
        }

    .condo-info {
        font-size: 1rem; 
        margin-top: 6px; 
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
    }

    /* 成員選擇器 */
    .member-selector {
        margin-top: 12px; 
        padding: 12px 0 0 0; 
        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .member-select-label {
        font-size: 13px;
        margin-bottom: 6px;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
    }

    .member-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 13px; 
        transition: all 0.3s ease;
        max-width: 220px;
    }

        .member-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.5);
            outline: none;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
        }

        .member-select option {
            background: var(--resident-primary);
            color: white;
        }
    /* 佈局容器 */
    .layout-container {
        display: flex;
        gap: 20px;
        align-items: stretch;
        min-height: calc(100vh - 300px); 
    }

    .left-column, .right-column {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: auto;
    }

    .left-column {
        flex: 1;
        gap: 20px;
        max-width: 45%; 
        min-height: calc(100vh - 300px);
    }

    .right-column {
        flex: 1;
        max-width: 55%; 
    }
    /* 卡片設計 */
    .resident-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: var(--card-radius);
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        padding: 20px; 
        margin-bottom: 0;
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .resident-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }
        .resident-card.half-height {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 200px; 
        }

        /* 第一個卡片（戶內住戶） */
        .resident-card.residents-card {
            flex: none; 
            height: 280px; 
            min-height: 280px;
            max-height: 280px;
        }

        /* 第二個卡片（待領取信件）*/
        .resident-card.mails-card {
            flex: 1; 
            min-height: 300px; 
        }

        .resident-card.full-height {
            flex: 1;
            height: 100%;
            min-height: 680px; 
            display: flex;
            flex-direction: column;
        }

            .resident-card.full-height .resident-table-container {
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .resident-card.full-height .table-wrapper {
                flex: none;
                overflow-y: auto;
                overflow-x: hidden;
                min-height: 0px;
                max-height: none;
                border: 1px solid var(--border-color);
                border-radius:4px;
            }

                .resident-card.full-height .table-wrapper::-webkit-scrollbar {
                    width: 8px;
                }

                .resident-card.full-height .table-wrapper::-webkit-scrollbar-track {
                    background: #f1f1f1;
                    border-radius: 4px;
                }

                .resident-card.full-height .table-wrapper::-webkit-scrollbar-thumb {
                    background: var(--resident-light);
                    border-radius: 4px;
                }

                    .resident-card.full-height .table-wrapper::-webkit-scrollbar-thumb:hover {
                        background: var(--resident-primary);
                    }
            .resident-card.full-height .resident-table tbody {
                height: auto;
            }

                .resident-card.full-height .resident-table tbody td {
                    padding: 12px 8px; 
                    text-align: center;
                    font-size: 14px;
                    border-bottom: 1px solid var(--border-color);
                    height:70px;
                    vertical-align: middle;
                    transition: background-color 0.2s ease;
                    white-space: nowrap; 
                }

            .resident-card.full-height .empty-state {
                text-align: center;
                color: var(--resident-light);
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 200px; 
                padding: 40px 20px;
            }

            .resident-card.full-height .loading {
                text-align: center;
                padding: 40px 20px;
                color: var(--resident-light);
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 200px;
            }
            .resident-card.full-height .resident-table {
                margin: 0;
                border: none;
                border-collapse: separate;
                border-spacing: 0;
                height:70px;
                width: 100%;
                font-size: 14px;
                min-height: fit-content; 
            }

        .resident-card.mails-card .table-wrapper {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

            .resident-card.mails-card .table-wrapper::-webkit-scrollbar {
                width: 6px;
            }

            .resident-card.mails-card .table-wrapper::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 4px;
            }

            .resident-card.mails-card .table-wrapper::-webkit-scrollbar-thumb {
                background: var(--resident-light);
                border-radius: 4px;
            }

            .resident-card.full-height .card-content,
            .resident-card.residents-card .card-content,
            .resident-card.mails-card .card-content {
                flex: none;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

    .card-title {
        font-size: 1.2rem; 
        font-weight: 600;
        color: var(--resident-primary);
        margin-bottom: 15px; 
        display: flex;
        align-items: center;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 10px;
        flex-shrink: 0;
    }

        .card-title i {
            margin-right: 8px;
            color: var(--resident-accent);
            font-size: 1.1rem; 
        }

        .card-title .badge {
            margin-left: auto;
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 12px;
        }

    .card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .resident-table-container {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        border: 1px solid var(--border-color);
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .table-wrapper {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .resident-table {
        margin: 0;
        border: none;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        font-size: 14px;
        flex: 1; 
        height: 100%;
    }

        .resident-table tbody {
            height: 100%;
        }

        .resident-table thead th {
            background: var(--resident-primary);
            color: white;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 10px;
            text-align: center;
            border: none;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .resident-table tbody td {
            padding: 10px 8px; 
            text-align: center;
            height:70px;
            font-size: 14px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
            transition: background-color 0.2s ease;
        }

        .resident-table tbody tr:hover td {
            background-color: rgba(63,158,149,.08);
        }

        .resident-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* 空白填充行樣式 */
        .resident-table tbody tr.empty-row td {
            height: 40px;
            border-bottom: 1px solid rgba(222, 226, 230, 0.3);
            color: transparent;
        }

        .resident-table tbody tr.empty-row:hover td {
            background-color: transparent;
        }

    /* 空狀態 */
    .empty-state {
        text-align: center;
        color: var(--resident-light);
        flex: 1; 
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: auto;
        padding: 30px 15px;
    }

        .empty-state i {
            font-size: 36px;
            margin-bottom: 12px;
            display: block;
            opacity: 0.5;
        }

        .empty-state h6 {
            font-size: 15px;
            margin-bottom: 6px;
            font-weight: 600;
            color: var(--resident-primary);
        }

        .empty-state p {
            font-size: 13px;
            margin: 0;
            opacity: 0.8;
        }

    /* 狀態樣式 */
    .package-id {
        background: transparent !important;
        padding: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-family: inherit !important;
        font-size: 14px;
        font-weight: 700;
        border: 0 !important;
        color: var(--text-primary) !important;
        display: inline-block;
    }

    /* 可點擊的狀態徽章 */
    .status-badge {
        padding: 6px 15px;
        border-radius: 15px;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        display: inline-block;
        cursor: pointer; 
        transition: all 0.2s ease; 
        border: 1px solid;
        text-decoration: none;
    }

        .status-badge:hover {
            transform: scale(1.05);
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        }

    .status-badge-pending {
        background-color: #fff5f5;
        border-color: var(--status-pending);
        color: var(--status-pending);
    }

        .status-badge-pending:hover {
            background-color: var(--status-pending);
            color: white;
        }

    .status-badge-mail {
        background-color: #fff8dc;
        border-color: #f39c12;
        color: #f39c12;
    }

        .status-badge-mail:hover {
            background-color: #f39c12;
            color: white;
        }

    .resident-info {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 16px;
    }

    .resident-id {
        background: var(--resident-primary);
        color: white;
        padding: 4px 12px;
        border-radius: 3px;
        font-size: 14px;
        font-weight: 600;
        display: inline-block;
    }

    .resident-phone {
        color: var(--text-primary);
        letter-spacing: .2px;
        padding: 4px 12px;
        font-size: 16px;
        font-weight: 700;
        font-family: 'Courier New', monospace;
    }

    /* 載入動畫 */
    .loading {
        text-align: center;
        padding: 20px;
        color: var(--resident-light);
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100px;
    }

        .loading i {
            animation: spin 1s linear infinite;
            font-size: 24px;
            margin-bottom: 10px;
            display: block;
            color: var(--resident-primary);
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* 包裹照片模態視窗 */

    .package-info-compact {
        background: #f8f9fa;
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        font-size: 14px; 
    }

        .package-info-compact .text-muted {
            font-size: 14px; 
            font-weight: 600;
            margin-bottom: 2px;
        }

        .package-info-compact .small {
            font-size: 14px; 
            font-weight: 500;
        }

    /* 照片展示區域 */
    #photo-gallery-container {
        min-height: 40vh; 
        max-height: 50vh; 
        overflow-y: auto;
    }

    #photo-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
        gap: 12px; 
        padding: 8px 4px; 
    }

    .photo-item {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background: white;
        position: relative;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

        .photo-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

        .photo-item img {
            width: 100%;
            height: 370px; 
            object-fit: cover;
            cursor: zoom-in;
            transition: transform 0.2s ease;
        }

            .photo-item img:hover {
                transform: scale(1.02);
            }

        .photo-item .photo-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
            color: white;
            padding: 6px 8px; 
            font-size: 11px; 
            font-weight: 600;
            text-align: center;
        }

    /* 載入和空狀態 */
    #photo-loading {
        padding: 30px 0 !important;
    }

    #no-photos {
        padding: 30px 0 !important;
    }

        #no-photos i {
            font-size: 2.5rem !important;
        }

    /* 全螢幕照片檢視器 */
    .fullscreen-viewer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        cursor: zoom-out;
        animation: fadeIn 0.2s ease-out;
    }

        .fullscreen-viewer img {
            max-width: 95%;
            max-height: 95%;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.5);
        }

        /* 關閉按鈕 */
        .fullscreen-viewer::before {
            content: '✕';
            position: fixed;
            top: 20px;
            right: 30px;
            color: white;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
            z-index: 10000;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.5);
            border-radius: 50%;
            transition: all 0.2s ease;
        }

        .fullscreen-viewer:hover::before {
            background: rgba(255,255,255,0.2);
            transform: scale(1.1);
        }

    /* 載入動畫 */
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* 響應式調整 */
    @@media (max-width: 992px) {
        .layout-container {
            flex-direction: column;
            gap: 15px;
            min-height: auto;
        }

        .left-column, .right-column {
            flex: none;
            max-width: none;
            min-height: auto;
        }

        .left-column {
            gap: 15px;
        }

        .resident-card.residents-card,
        .resident-card.mails-card,
        .resident-card.full-height {
            flex: none;
            margin-bottom: 15px;
            height: auto;
            min-height: 300px;
            max-height: none;
        }

        .modal-dialog.modal-lg {
            margin: 15px; 
            max-width: calc(100% - 30px);
        }

        #photo-gallery-container {
            min-height: 35vh;
            max-height: 45vh;
        }

        #photo-gallery {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 8px;
        }

        .photo-item img {
            height: 150px; 
        }

        .package-info-compact {
            padding: 6px 8px;
            font-size: 11px;
        }

            .package-info-compact .row {
                flex-direction: column;
            }

            .package-info-compact .col-3 {
                margin-bottom: 6px;
                padding-bottom: 6px;
                border-bottom: 1px solid #e9ecef;
            }

                .package-info-compact .col-3:last-child {
                    border-bottom: none;
                    margin-bottom: 0;
                }
    }

    @@media (max-width: 768px) {
        .resident-container {
            padding: 12px;
        }

        .welcome-card {
            padding: 15px 20px;
            margin-bottom: 15px;
        }

        .welcome-title {
            font-size: 1.3rem;
        }

        .layout-container {
            gap: 12px;
        }

        .left-column {
            gap: 12px;
            min-height: auto;
        }

        .resident-card {
            padding: 15px;
        }

            .resident-card.residents-card {
                height: auto;
                min-height: 250px;
                max-height: none;
            }

        .card-title {
            font-size: 1.1rem;
        }

        .empty-state {
            padding: 25px 10px;
            min-height: 100px;
        }

            .empty-state i {
                font-size: 28px;
            }

        .modal-dialog.modal-lg {
            margin: 10px;
            max-width: calc(100% - 20px);
        }

        #photo-gallery-container {
            min-height: 30vh;
            max-height: 40vh;
        }

        #photo-gallery {
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 6px;
            padding: 6px 2px;
        }

        .photo-item img {
            height: 120px;
        }
    }

    @@media (max-width: 576px) {
        .resident-container {
            padding: 10px;
        }

        .welcome-card {
            padding: 12px 15px;
        }

        .welcome-title {
            font-size: 1.2rem;
        }

        .layout-container {
            gap: 10px;
        }

        .left-column {
            gap: 10px;
            min-height: auto;
        }

        .resident-card {
            padding: 12px;
        }

            .resident-card.residents-card {
                height: auto;
                min-height: 200px;
            }

        .card-title {
            font-size: 1rem;
        }

        .resident-table thead th{
            padding: 9px 6px;
            font-size: 14px;
        }
        .resident-table tbody td {
            padding: 9px 6px;
            font-size: 13px;
            height: 60px; 
            white-space: normal;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .resident-table tbody tr.empty-row td {
            height: 60px; 
        }
        #photo-gallery {
            grid-template-columns: 1fr 1fr; 
            padding: 4px;
        }

        .photo-item img {
            height: 100px;
        }

        .modal-header {
            padding: 6px 10px !important; 
        }

        .modal-body {
            padding: 6px !important; 
        }

        #photo-gallery-container {
            min-height: 25vh;
            max-height: 35vh;
        }
    }

    .resident-table tbody tr.empty-row td {
        height: 70px;
        border-bottom: 1px solid rgba(222, 226, 230, 0.3);
        color: transparent;
    }

    .resident-table tbody tr.empty-row:hover td {
        background-color: transparent;
    }
    /* 包裹圖標動畫效果 */
    .package-icon-animation {
        animation: packageIconPulse 2s ease-in-out infinite;
        transition: all 0.3s ease;
    }

        .package-icon-animation:hover {
            transform: scale(1.05);
            color: #004499 !important;
        }

    @@keyframes packageIconPulse {
        0%, 100%

    {
        transform: scale(1);
        opacity: 0.8;
    }

    50% {
        transform: scale(1.02);
        opacity: 1;
    }

    }

    /* 無照片佔位符樣式 */
    .no-photo-placeholder {
        transition: all 0.3s ease;
        cursor: default;
    }

        .no-photo-placeholder:hover {
            background: #f1f3f4 !important;
            border-color: var(--resident-primary) !important;
        }

    /* 照片載入失敗回退樣式 */
    .photo-fallback {
        transition: all 0.3s ease;
    }

        .photo-fallback:hover i {
            color: #004499 !important;
            transform: scale(1.1);
        }
    /* 信件通知樣式 */
    .mail-notification-bar {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        color: white;
        border-radius: var(--card-radius);
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
        overflow: hidden;
        animation: slideInDown 0.5s ease-out;
    }

    .notification-content {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        gap: 15px;
    }

    .notification-icon {
        font-size: 24px;
        color: rgba(255, 255, 255, 0.9);
        animation: bellShake 2s ease-in-out infinite;
    }

    .notification-text {
        flex: 1;
    }

        .notification-text h6 {
            margin: 0 0 3px 0;
            font-size: 16px;
            font-weight: 600;
        }

        .notification-text small {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.8);
        }

    .notification-action .btn {
        border-color: rgba(255, 255, 255, 0.3);
        color: white;
        font-size: 12px;
        padding: 4px 12px;
        transition: all 0.3s ease;
    }

        .notification-action .btn:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: white;
            transform: translateY(-1px);
        }

    /* 信件詳情 */
    .mail-details-panel {
        padding: 0 20px 20px 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        margin-top: 15px;
        padding-top: 15px;
        animation: slideDown 0.3s ease-out;
    }

    .mail-item-card {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        padding: 12px;
        transition: all 0.3s ease;
    }

        .mail-item-card:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }

    .mail-info {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }

    .mail-id {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 11px;
        font-family: 'Courier New', monospace;
    }

    .mail-type {
        background: rgba(255, 255, 255, 0.9);
        color: #e67e22;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .recipient-name {
        color: rgba(255, 255, 255, 0.8);
        font-size: 12px;
    }

    /* 動畫效果 */
    @@keyframes slideInDown {
        from

    {
        transform: translateY(-20px);
        opacity: 0;
    }

    to {
        transform: translateY(0);
        opacity: 1;
    }

    }

    @@keyframes slideDown {
        from

    {
        max-height: 0;
        opacity: 0;
    }

    to {
        max-height: 500px;
        opacity: 1;
    }

    }

    @@keyframes bellShake {
        0%, 100%

    {
        transform: rotate(0deg);
    }

    10%, 30%, 50%, 70%, 90% {
        transform: rotate(-10deg);
    }

    20%, 40%, 60%, 80% {
        transform: rotate(10deg);
    }
    }
     @@keyframes packagePulse {
         0%, 100%

    {
        transform: scale(1);
        opacity: 0.8;
    }

    50% {
        transform: scale(1.05);
        opacity: 1;
    }
    }
</style>

<div class="resident-container" id="ResidentApp">
    <!-- 歡迎標題卡片 -->
    <div class="welcome-card">
        <div class="welcome-content">
            <h1 class="welcome-title">
                <i class="bi bi-house-heart"></i>
                歡迎回來，<a href="/Resident/Edit" class="resident-link">
                    <span v-if="currentMemberName">{{ currentMemberName }}</span>
                    <span v-else>@Model.FullName</span>
                </a>
            </h1>
            <div class="condo-info">
                <i class="bi bi-geo-alt me-2"></i>戶號：@Model.Condo_Id
            </div>
            <!-- 成員選擇器 (僅在有多個成員時顯示) -->
            @if (Model.HasMultipleMembers)
            {
                <div class="member-selector">
                    <label class="member-select-label">
                        <i class="bi bi-person-check me-2"></i>目前登入身份：
                    </label>
                    <select class="member-select" v-model="selectedMemberId" v-on:change="changeMember">
                        <option v-for="member in members" :value="member.red_id" :key="member.red_id">
                            {{ member.red_id }} - {{ member.red_name }}
                        </option>
                    </select>
                </div>
            }
        </div>
    </div>
    @{
        var photoCount = Model?.ProfilePhotoCount ?? (ViewBag.ProfilePhotoCount as int? ?? 0);
    }
    @if (photoCount < 5)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert" style="border-left:4px solid #E74C3C;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            為了完整識別，請上傳滿 <strong>5</strong> 張個人照片，您目前有 <strong>@photoCount</strong> 張，
            尚缺 <strong>@(5 - photoCount)</strong> 張。
            <a href="/Resident/Edit" class="btn btn-sm btn-primary ms-3">前往上傳</a>
        </div>
    }
    <div v-if="mails && mails.length > 0" class="mail-notification-bar">
        <div class="notification-content">
            <div class="notification-icon">
                <i class="bi bi-envelope-exclamation"></i>
            </div>
            <div class="notification-text">
                <h6>貴戶有信件，請查收</h6>
                <small>共有 {{ mails.length }} 封信件待領取</small>
            </div>
        </div>
    </div>
    <!-- 主要內容區域 -->
    <div class="layout-container">
        <!-- 左欄：戶內住戶 + 待領取信件 -->
        <div class="left-column">
            <!-- 戶內住戶資訊 -->
            <div class="resident-card residents-card">
                <h3 class="card-title">
                    <i class="bi bi-people"></i>戶內住戶
                </h3>
                <div class="card-content">
                    <div class="resident-table-container">
                        <div class="table-wrapper">
                            <table class="table resident-table">
                                <thead>
                                    <tr>
                                        <th><i class="bi bi-person-badge me-1"></i>住戶編號</th>
                                        <th><i class="bi bi-person me-1"></i>姓名</th>
                                        <th><i class="bi bi-telephone me-1"></i>電話</th>
                                    </tr>
                                </thead>
                                <tbody id="tblResidents">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 待領取信件  -->
            <div class="resident-card mails-card">
                <h3 class="card-title">
                    <i class="bi bi-envelope"></i>待領取信件
                    <span v-if="mails.length > 0" class="badge bg-warning">{{ mails.length }}</span>
                </h3>
                <div class="card-content">
                    <div class="resident-table-container">
                        <div v-if="mailsLoading" class="loading">
                            <i class="bi bi-arrow-clockwise"></i>
                            <p>載入中...</p>
                        </div>
                        <div v-else-if="mails && mails.length > 0" class="table-wrapper">
                            <table class="table resident-table">
                                <thead>
                                    <tr>
                                        <th><i class="bi bi-hash me-1"></i>信件編號</th>
                                        <th><i class="bi bi-envelope me-1"></i>類別</th>
                                        <th><i class="bi bi-person me-1"></i>收件人</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="m in mails" :key="m.pack_id">
                                        <td>
                                            <code class="package-id">{{ m.pack_id }}</code>
                                        </td>
                                        <td>
                                            <span class="status-badge status-badge-mail">
                                                <i class="bi bi-envelope me-1"></i>{{ m.pack_name || '信件' }}
                                            </span>
                                        </td>
                                        <td>
                                            <span class="resident-info">{{ m.red_name }}</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div v-else class="empty-state">
                            <i class="bi bi-envelope-open"></i>
                            <h6>目前沒有信件</h6>
                            <p>所有信件都已領取完畢</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- 右欄：待領取包裹 -->
        <div class="right-column">
            <div class="resident-card full-height">
                <h3 class="card-title">
                    <i class="bi bi-box-seam"></i>待領取包裹
                    <span v-if="packages.length > 0" class="badge bg-danger">{{ packages.length }}</span>
                </h3>
                <div class="card-content">
                    <div class="resident-table-container">
                        <!-- 載入狀態 -->
                        <div v-if="packagesLoading" class="loading">
                            <i class="bi bi-arrow-clockwise"></i>
                            <p>載入包裹資料中...</p>
                        </div>
                        <!-- 包裹清單 -->
                        <div v-else-if="packages && packages.length > 0" class="table-wrapper">
                            <table class="table resident-table">
                                <thead>
                                    <tr>
                                        <th><i class="bi bi-hash me-1"></i>包裹編號</th>
                                        <th><i class="bi bi-box me-1"></i>狀態</th>
                                        <th><i class="bi bi-person me-1"></i>收件人</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="p in packages" :key="p.pack_id">
                                        <td>
                                            <code class="package-id">{{ p.pack_id }}</code>
                                        </td>
                                        <td>
                                            <span class="status-badge status-badge-pending"
                                                  v-on:click="viewPackagePhoto(p.pack_id)"
                                                  title="點擊查看包裹照片">
                                                <i class="bi bi-box me-1"></i>未取
                                            </span>
                                        </td>
                                        <td>
                                            <span class="resident-info">{{ p.red_name }}</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- 空狀態 -->
                        <div v-else class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h6>目前沒有待領取的包裹</h6>
                            <p>所有包裹都已領取完畢</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- 包裹照片模態視窗 -->
<div class="modal fade" id="packagePhotoModal" tabindex="-1" aria-labelledby="packagePhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="packagePhotoModalLabel">
                    <i class="bi bi-camera me-2"></i>包裹照片
                </h5>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <div id="package-info" style="display:none; background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;font-size:18px">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>包裹編號：</strong><code id="modal-package-id"></code></p>
                            <p class="mb-2"><strong>類別：</strong><span id="modal-package-name"></span></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>收件人：</strong><span id="modal-recipient"></span></p>
                            <p class="mb-2"><strong>送達時間：</strong><span id="modal-create-time"></span></p>
                        </div>
                    </div>
                </div>
                <div id="photo-loading" class="text-center" style="display:none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">正在載入照片...</p>
                </div>
                <div id="photo-gallery"></div>
                    <!-- 無照片狀態 -->
                <div id="no-photos" class="text-center" style="display: none; padding: 40px 20px;">
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <i class="bi bi-box-seam package-icon-animation"
                            style="font-size: 64px; color: var(--resident-primary); margin-bottom: 15px; display: block;"></i>
                        <h6 style="font-size: 16px; font-weight: 600; color: #495057; margin-bottom: 6px;">
                            此包裹暫無照片
                        </h6>
                        <small style="font-size: 12px; color: #6c757d;">
                            建議收取包裹時拍照記錄
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        /* 戶內所有住戶清單 */
        (function () {
            const data = @Html.Raw(jsonResidents);
            const tbody = document.getElementById('tblResidents');

            if (data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="empty-state">
                            <i class="bi bi-person-plus"></i>
                            <h6>尚未建立住戶資料</h6>
                            <p>請聯繫管理員新增住戶資訊</p>
                        </td>
                    </tr>`;
                return;
            }

            const rows = data.map(function(r) {
                return `
                    <tr>
                        <td><span class="resident-id">${r.red_id}</span></td>
                        <td><span class="resident-info">${r.red_name}</span></td>
                        <td><span class="resident-phone">${r.phone || '-'}</span></td>
                    </tr>`;
            }).join('');
            tbody.innerHTML = rows;
        })();

        const { createApp } = Vue;
        createApp({
            data: function() {
                return {
                    packages: [],
                    mails: [],
                    members: @Html.Raw(jsonResidents),
                    selectedMemberId: '@Html.Raw(selectedResidentId)',
                    packagesLoading: true,
                    mailsLoading: true,
                    currentMemberName: '',
                    showMailDetails: false
                };
            },
            mounted: function() {
                this.fetchPackages();
                this.fetchMails();
                this.initCurrentMemberName();
            },
            methods: {
                toggleMailDetails: function() {
                this.showMailDetails = !this.showMailDetails;
                },
                initCurrentMemberName: function() {
                    var self = this;
                    if (self.selectedMemberId && self.members.length > 0) {
                        var selectedMember = self.members.find(function(member) {
                            return member.red_id === self.selectedMemberId;
                        });
                        if (selectedMember) {
                            self.currentMemberName = selectedMember.red_name;
                        }
                    }
                },
                changeMember: function() {
                    var self = this;
                    if (!self.selectedMemberId) {
                        self.showMessage('請選擇成員','error');
                        return;
                    }
                    console.log('切換成員:', self.selectedMemberId);
                    const params = new URLSearchParams();
                    params.append('residentId',self.selectedMemberId);

                    axios.post('/Resident/SelectMember',params, {
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    })
                    .then(function(res) {
                        console.log('API回應:',res.data);

                        if (res.data && res.data.success) {
                            self.currentMemberName = res.data.memberName;
                            self.fetchPackages();
                            self.fetchMails();
                            self.showMessage('已切換為：' + res.data.memberName, 'success');
                        } else {
                            self.showMessage(res.data.message || '切換失敗', 'error');
                        }
                    })
                    .catch(function(error) {
                        console.error('API 錯誤:', error);

                        if (error.response) {
                            // API 有回應但出錯
                            console.error('錯誤狀態:', error.response.status);
                            console.error('錯誤資料:', error.response.data);

                            if (error.response.status === 404) {
                                self.showMessage('找不到 API 端點，請檢查路由設定', 'error');
                            } else {
                                self.showMessage(error.response.data?.message || '切換成員時發生錯誤', 'error');
                            }
                        } else if (error.request) {
                            // 請求發送但沒收到回應
                            self.showMessage('無法連接到伺服器', 'error');
                        } else {
                            // 其他錯誤
                            self.showMessage('切換成員時發生錯誤', 'error');
                        }
                    });
                },

                fetchPackages: function() {
                    var self = this;
                    self.packagesLoading = true;
                    axios.post('/Resident/GetUncollectedPackages')
                         .then(function(res) {
                             self.packages = res.data || [];
                             self.packagesLoading = false;
                         })
                         .catch(function() {
                             self.packages = [];
                             self.packagesLoading = false;
                         });
                },

                fetchMails: function() {
                    var self = this;
                    self.mailsLoading = true;
                    axios.post('/Resident/GetUncollectedMails')
                         .then(function(res) {
                             self.mails = res.data || [];
                             self.mailsLoading = false;
                         })
                         .catch(function() {
                             self.mails = [];
                             self.mailsLoading = false;
                         });
                },

                // 查看包裹照片功能
                viewPackagePhoto: function(packageId) {
                    console.log('查看包裹照片:', packageId);

                    if (!packageId) {
                        alert('包裹編號不能為空');
                        return;
                    }

                    // 顯示載入狀態
                    document.getElementById('photo-loading').style.display = 'block';
                    document.getElementById('photo-gallery').innerHTML = '';
                    document.getElementById('no-photos').style.display = 'none';
                    document.getElementById('package-info').style.display = 'none';

                    // 開啟模態視窗
                    var modal = new bootstrap.Modal(document.getElementById('packagePhotoModal'));
                    modal.show();

                    // 設定模態視窗標題
                    document.getElementById('packagePhotoModalLabel').innerHTML =
                        '<i class="bi bi-camera me-1"></i>包裹照片 - ' + packageId;

                    axios.post('/Resident/GetPackagePhotos', {
                        packageId: packageId.toString()
                    }, {
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    })
                    .then(function(res) {
                        document.getElementById('photo-loading').style.display = 'none';

                        if (res.data.success) {
                            // 填入包裹資訊
                            document.getElementById('package-info').style.display = 'block';
                            document.getElementById('modal-package-id').textContent = res.data.packageId;
                            document.getElementById('modal-package-name').textContent = res.data.packageName;
                            document.getElementById('modal-recipient').textContent =
                                res.data.recipientName + ' (' + res.data.recipientId + ')';
                            document.getElementById('modal-create-time').textContent = res.data.createTime;

                            // 顯示照片
                            if (res.data.photos && res.data.photos.length > 0) {
                                var galleryHtml = res.data.photos.map(function(photoUrl, index) {
                                    const isBase64 = photoUrl.startsWith('data:image/');
                                    const photoType = isBase64 ? '系統照片' : '檔案照片';

                                    return `
                                        <div class="photo-item mb-3" style="text-align:center;">
                                        <div style="position:relative; display:inline-block; max-width:100%;">
                                            <img src="${photoUrl}"
                                                 alt="包裹照片 ${index + 1}"
                                                 class="img-fluid rounded shadow"
                                                 style="max-width; height: 500px; cursor: zoom-in;
                                                        border: 2px solid #dee2e6; transition: all 0.3s ease;"
                                                 onclick="openFullscreen(this)"
                                                 onmouseover="this.style.borderColor='var(--primary-color)'; this.style.transform='scale(1.02)';"
                                                 onmouseout="this.style.transform=''; this.style.borderColor='#dee2e6';"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div style="display:none; flex-direction:column; align-items:center; justify-content:center;
                                                     width:750px;height:300px; color:#6c757d; background:#f8f9fa; border-radius:8px; border: 2px solid #dee2e6;">
                                                    <i class="bi bi-box-seam" style="font-size:60px; color:var(--resident-primary); margin-bottom:15px;
                                                       animation:packagePulse 2s ease-in-out infinite;"></i>
                                                    <p style="margin:0; font-size:14px;">照片載入失敗</p>
                                                </div>
                                            <div style="position:absolute; bottom:5px; left:5px; right:5px; background:rgba(0,0,0,0.7);
                                                 color:white; padding:6px 10px; border-radius:6px; text-align:center;">
                                                <small style="font-size:11px; font-weight:600;">${photoType} ${index + 1}</small>
                                            </div>
                                        </div>
                                    </div>`;
                            }).join('');
                            document.getElementById('photo-gallery').innerHTML = galleryHtml;
                        } else {
                            // 沒有照片時顯示包裹圖標
                            document.getElementById('no-photos').style.display = 'block';
                        }
                    } else {
                        document.getElementById('no-photos').style.display = 'block';
                    }
                })
                .catch(function(error) {
                    document.getElementById('photo-loading').style.display = 'none';
                    console.error('載入包裹照片錯誤:', error);
                    document.getElementById('no-photos').style.display = 'block';
                });
                },

                showMessage: function(message, type) {
                    if (type === 'success') {
                        alert('✓ ' + message);
                    } else {
                        alert('✗ ' + message);
                    }
                }
            }
        }).mount('#ResidentApp');

        // 全螢幕照片查看功能
        function openFullscreen(img) {
            var existingViewer = document.querySelector('[data-viewer="true"]');
            if (existingViewer && existingViewer.parentNode) {
                document.body.removeChild(existingViewer);
            }
            var viewer = document.createElement('div');
            viewer.className = 'fullscreen-viewer';
            viewer.setAttribute('data-viewer', 'true');

            var fullImg = document.createElement('img');
            fullImg.src = img.src;
            fullImg.alt = img.alt;

            viewer.appendChild(fullImg);

            // 點擊任何地方都可以關閉
            viewer.onclick = function() {
                closeFullscreenViewer();
            };

            // ESC 鍵關閉
            var escHandler = function(e) {
                if (e.key === 'Escape') {
                    closeFullscreenViewer();
                    document.removeEventListener('keydown', escHandler);
                }
            };
                // 關閉全螢幕檢視器的安全函數
            function closeFullscreenViewer() {
                var existingViewer = document.querySelector('[data-viewer="true"]');
                if (existingViewer && existingViewer.parentNode) {
                    try {
                        document.body.removeChild(existingViewer);
                    } catch (e) {
                        console.warn('無法移除全螢幕檢視器:', e);
                    }
                }
                document.removeEventListener('keydown', escHandler);
            }
            document.addEventListener('keydown', escHandler);
            document.body.appendChild(viewer);
        }
    </script>
}
