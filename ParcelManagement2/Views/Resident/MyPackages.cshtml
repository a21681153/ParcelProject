@model MyPackagesVm
@{
    ViewBag.Title = "我的包裹";
    string jsonResidents = (ViewBag.JsonResidents as string) ?? "[]";
    string selectedResidentId = (ViewBag.SelectedResidentId as string) ?? "";
}

<script src="https://cdn.jsdelivr.net/npm/vue@3.2.31/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
        --primary-color: #3F9E95;
        --secondary-color: #7FCFC3;
        --accent-color: #2F847C;
        --success-color: #2ECC71;
        --warning-color: #E6B566;
        --danger-color: #E74C3C;
        --light-color: #9FB1B1;
        --border-color: #E7E3DA;
        --card-radius: 14px;
    }

    /*版面基礎 */
    .packages-container {
        padding: 20px;
        background: linear-gradient(180deg,#F7FBFA 0%, #EEF7F6 100%);
        min-height: 100vh;
    }

    .header-card {
        background: linear-gradient(90deg,var(--primary-color),var(--secondary-color));
        color: #fff;
        border-radius: var(--card-radius);
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 6px 18px rgba(63,158,149,.18);
        border: 1px solid #ffffff33;
    }

    .header-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .header-subtitle {
        opacity: .9;
        margin-bottom: 0;
    }

    /* 成員選擇 */
    .member-selector {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid rgba(255,255,255,.2);
    }

    .member-select {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.3);
        color: #fff;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        max-width: 250px;
    }

        .member-select:focus {
            background: rgba(255,255,255,.15);
            border-color: rgba(255,255,255,.5);
            outline: none;
        }

        .member-select option {
            background: var(--primary-color);
            color: #fff;
        }

    .nav-tabs {
        border-bottom: 2px solid var(--border-color);
        margin-bottom: 20px;
    }

        .nav-tabs .nav-link {
            border: none;
            border-bottom: 3px solid transparent;
            color: #2a3a3a99;
            font-weight: 600;
            padding: 15px 25px;
            transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, color .12s ease;
        }

            .nav-tabs .nav-link:hover {
                color: var(--primary-color);
                border-bottom-color: var(--secondary-color);
                transform: translateY(-1px);
            }

            .nav-tabs .nav-link.active {
                color: var(--primary-color);
                border-bottom-color: var(--primary-color);
                background: transparent;
                font-weight: 800;
            }

    /* 卡片與表格 */
    .content-card {
        background: #fff;
        border-radius: var(--card-radius);
        box-shadow: 0 2px 10px rgba(0,0,0,.1);
        overflow: hidden;
    }

    .packages-table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .packages-table thead th {
            background: linear-gradient(180deg,var(--primary-color),#388F87);
            color: #fff;
            font-weight: 600;
            padding: 15px 12px;
            text-align: center;
            border: none;
            font-size: 14px;
        }

        .packages-table tbody td {
            padding: 14px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
            font-size: 16px;
        }

        .packages-table tbody tr:hover td {
            background-color: rgba(127,207,195,.12);
        }

        .packages-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* 類型（包裹/信件） */
    .type-badge {
        padding: 4px 8px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        border: 1px solid transparent;
        display: inline-block;
    }

    .type-package {
        background: #E7F7F4;
        color: #2C7E77;
        border-color: #2C7E77;
    }

    .type-mail {
        background: #FFF3E0;
        color: #C76B16;
        border-color: #E5924A;
    }

    /* 狀態（未取/已取） */
    .status-badge {
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 14px;
        font-weight: 700;
        display: inline-block;
        border: 1px solid;
        box-shadow: 0 1px 0 rgba(0,0,0,.04);
    }

    .status-pending {
        background: #fff5f5;
        color: var(--danger-color);
        border-color: var(--danger-color);
        cursor: pointer;
        text-decoration: none;
    }

    .status-collected {
        background: #f0fff4;
        color: var(--success-color);
        border-color: var(--success-color);
        cursor: default;
    }

    .status-pending:hover {
        background: var(--danger-color);
        color: #fff;
        transform: scale(1.05);
        box-shadow: 0 2px 8px rgba(231,76,60,.3);
    }

    /* 按鈕 */
    .btn.btn-primary {
        background: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn.btn-primary:hover {
            background: var(--accent-color);
            border-color: var(--accent-color);
        }

    /* 模態相片 */
    .photo-item {
        text-align: center;
        margin-bottom: 20px;
    }

        .photo-item img {
            transition: transform .3s ease;
            border: 2px solid #dee2e6;
            border-radius: 8px;
        }

            .photo-item img:hover {
                border-color: var(--primary-color);
            }

    #photo-gallery {
        max-height: 60vh;
        overflow-y: auto;
        padding: 15px;
    }

    #photo-loading, #no-photos {
        padding: 40px 20px;
        text-align: center;
        color: var(--light-color);
    }

        #no-photos i {
            font-size: 3rem;
            opacity: .3;
            margin-bottom: 15px;
            display: block;
        }

    /* 載入動畫 */
    @@keyframes spin {
        0%

    {
        transform: rotate(0)
    }

    100% {
        transform: rotate(360deg)
    }

    }

    .loading, .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--light-color);
    }

        .loading i, .empty-state i {
            font-size: 48px;
            margin-bottom: 15px;
            display: block;
            opacity: .5;
        }

        .loading i {
            animation: spin 1s linear infinite;
        }

    /* RWD */
    @@media (max-width: 768px) {
        .packages-container

    {
        padding: 15px;
    }

    .header-card {
        padding: 20px;
    }

    .nav-tabs .nav-link {
        padding: 12px 15px;
        font-size: 14px;
    }

    .packages-table thead th, .packages-table tbody td {
        padding: 10px 8px;
        font-size: 14px;
    }

    }
</style>

<div class="packages-container" id="MyPackagesApp">
    <div class="header-card">
        <h1 class="header-title"><i class="bi bi-box-seam me-2"></i>我的包裹</h1>
        <p class="header-subtitle">查看您的包裹與信件狀況</p>
        @if (Model.HasMultipleMembers)
        {
            <div class="member-selector">
                <label class="form-label text-light mb-2"><i class="bi bi-person-check me-2"></i>查看成員：</label>
                <select class="member-select" v-model="selectedMemberId" v-on:change="changeMember">
                    <option v-for="member in members" :value="member.red_id" :key="member.red_id">
                        {{ member.red_id }} - {{ member.red_name }}
                    </option>
                </select>
            </div>
        }
    </div>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link" v-on:class="{ active: activeTab === 'all' }" v-on:click="switchTab('all')" href="#all-packages">
                <i class="bi bi-list-ul me-2"></i>所有包裹
                <span v-if="allPackages.length > 0" class="badge bg-primary ms-2">{{ allPackages.length }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" v-on:class="{ active: activeTab === 'pending' }" v-on:click="switchTab('pending')" href="#pending-packages">
                <i class="bi bi-exclamation-triangle me-2"></i>未領取
                <span v-if="pendingCount > 0" class="badge bg-danger ms-2">{{ pendingCount }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" v-on:class="{ active: activeTab === 'history' }" v-on:click="switchTab('history')" href="#collected-history">
                <i class="bi bi-check-circle me-2"></i>領取紀錄
                <span v-if="collectedHistory.length > 0" class="badge bg-success ms-2">{{ collectedHistory.length }}</span>
            </a>
        </li>
    </ul>

    <div class="content-card">
        <!-- 所有包裹 -->
        <div v-show="activeTab === 'all'">
            <div v-if="allLoading" class="loading">
                <i class="bi bi-arrow-clockwise"></i><h5>載入中...</h5>
            </div>
            <div v-else-if="allPackages.length === 0" class="empty-state">
                <i class="bi bi-inbox"></i><h5>目前沒有任何包裹</h5><p>尚未有任何包裹或信件記錄</p>
            </div>
            <div v-else>
                <table class="table packages-table">
                    <thead>
                        <tr>
                            <th>包裹編號</th>
                            <th>類型</th>
                            <th>收件人</th>
                            <th>送達時間</th>
                            <th>狀態</th>
                            <th>領取人</th>
                            <th>領取時間</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in allPackages" :key="item.pack_id">
                            <td><code>{{ item.pack_id }}</code></td>
                            <td>
                                <span class="type-badge" v-bind:class="item.item_type === '信件' ? 'type-mail' : 'type-package'">
                                    {{ item.item_type }}
                                </span>
                            </td>
                            <td>{{ item.red_name }}</td>
                            <td>{{ formatDateTime(item.create_time) }}</td>
                            <td>
                                <span class="status-badge"
                                      v-bind:class="item.status == 0 ? 'status-pending' : 'status-collected'"
                                      v-on:click="item.status == 0 ? viewPackagePhoto(item.pack_id) : null"
                                      :title="item.status == 0 ? '點擊查看包裹照片' : ''">
                                    {{ item.status_text }}
                                </span>
                            </td>
                            <td>{{ item.collector_name || '-' }}</td>
                            <td>{{ item.pickup_datetime ? formatDateTime(item.pickup_datetime) : '-' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 未領取 -->
        <div v-show="activeTab === 'pending'">
            <div v-if="pendingLoading" class="loading">
                <i class="bi bi-arrow-clockwise"></i><h5>載入中...</h5>
            </div>
            <div v-else-if="pendingPackages.length === 0" class="empty-state">
                <i class="bi bi-check-circle"></i><h5>沒有待領取的包裹</h5><p>所有包裹都已領取完畢</p>
            </div>
            <div v-else>
                <table class="table packages-table">
                    <thead>
                        <tr>
                            <th>包裹編號</th>
                            <th>類型</th>
                            <th>收件人</th>
                            <th>送達時間</th>
                            <th>存放天數</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in pendingPackages" :key="item.pack_id">
                            <td><code>{{ item.pack_id }}</code></td>
                            <td>
                                <span class="type-badge" v-bind:class="item.item_type === '信件' ? 'type-mail' : 'type-package'">
                                    {{ item.item_type }}
                                </span>
                            </td>
                            <td>{{ item.red_name }}</td>
                            <td>{{ formatDateTime(item.create_time) }}</td>
                            <td>{{ calculateDays(item.create_time) }} 天</td>
                            <td>
                                <button class="btn btn-sm btn-primary" v-on:click="viewPackagePhoto(item.pack_id)">
                                    <i class="bi bi-camera me-1"></i>查看照片
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- 領取紀錄 -->
        <div v-show="activeTab === 'history'">
            <div v-if="historyLoading" class="loading">
                <i class="bi bi-arrow-clockwise"></i><h5>載入中...</h5>
            </div>
            <div v-else-if="collectedHistory.length === 0" class="empty-state">
                <i class="bi bi-clock-history"></i><h5>目前沒有領取紀錄</h5><p>尚未領取過任何包裹</p>
            </div>
            <div v-else>
                <table class="table packages-table">
                    <thead>
                        <tr>
                            <th>包裹編號</th>
                            <th>類型</th>
                            <th>收件人</th>
                            <th>送達時間</th>
                            <th>領取時間</th>
                            <th>領取人</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in collectedHistory" :key="item.pack_id">
                            <td><code>{{ item.pack_id }}</code></td>
                            <td>
                                <span class="type-badge" v-bind:class="item.item_type === '信件' ? 'type-mail' : 'type-package'">
                                    {{ item.item_type }}
                                </span>
                            </td>
                            <td>{{ item.red_name }}</td>
                            <td>{{ formatDateTime(item.create_time) }}</td>
                            <td>{{ formatDateTime(item.pickup_datetime) }}</td>
                            <td>{{ item.collector_name || '-' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 包裹照片模態視窗 -->
<div class="modal fade" id="packagePhotoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="packagePhotoModalLabel">
                    <i class="bi bi-camera me-2"></i>包裹照片
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="package-info" style="display:none; background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;font-size:18px">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>包裹編號：</strong><code id="modal-package-id"></code></p>
                            <p class="mb-2"><strong>類別：</strong><span id="modal-package-name"></span></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>收件人：</strong><span id="modal-recipient"></span></p>
                            <p class="mb-0"><strong>送達時間：</strong><span id="modal-create-time"></span></p>
                        </div>
                    </div>
                </div>
                <div id="photo-loading" class="text-center" style="display:none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">正在載入照片...</p>
                </div>
                <div id="photo-gallery"></div>
                <div id="no-photos" class="text-center" style="display:none;">
                    <i class="bi bi-camera" style="font-size:3rem;opacity:.3;"></i>
                    <h6 class="mt-2">此包裹暫無照片</h6>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        const { createApp } = Vue;
        function openFullscreen(img) {
            const fullscreenDiv = document.createElement('div');
            fullscreenDiv.style.cssText = `
                position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
                background: rgba(0,0,0,0.95); z-index: 9999; display: flex;
                align-items: center; justify-content: center; cursor: zoom-out;
            `;

            const fullImg = document.createElement('img');
            fullImg.src = img.src;
            fullImg.style.cssText = 'max-width: 95%; max-height: 95%; object-fit: contain;';

            fullscreenDiv.appendChild(fullImg);
            fullscreenDiv.onclick = function() {
                document.body.removeChild(fullscreenDiv);
            };

            document.body.appendChild(fullscreenDiv);
        }
        createApp({
          data() {
            return {
              activeTab: 'all',
              members: @Html.Raw(jsonResidents),
              selectedMemberId: '@Html.Raw(selectedResidentId)',
              allPackages: [], pendingPackages: [], collectedHistory: [],
              allLoading: false, pendingLoading: false, historyLoading: false
            };
          },
          computed: {
            pendingCount() { return this.allPackages.filter(p => p.status == 0).length; }
          },
          mounted() { this.loadAllData(); },
          methods: {
            switchTab(tab){ this.activeTab = tab; this.loadTabData(); },
            changeMember(){
              if (!this.selectedMemberId) return;
              const params = new URLSearchParams(); params.append('residentId', this.selectedMemberId);
              axios.post('/Resident/SelectMember', params, { headers:{ 'Content-Type':'application/x-www-form-urlencoded' }})
                .then(res => {
                  if (res.data && res.data.success) { this.loadAllData(); this.showMessage('已切換為：' + res.data.memberName, 'success'); }
                  else { this.showMessage(res.data?.message || '切換失敗', 'error'); }
                })
                .catch(() => this.showMessage('切換成員時發生錯誤', 'error'));
            },
            loadAllData(){ this.loadAllPackages(); this.loadCollectedHistory(); },
            loadTabData(){
              switch(this.activeTab){
                case 'all': if(this.allPackages.length===0) this.loadAllPackages(); break;
                case 'pending': break;
                case 'history': if(this.collectedHistory.length===0) this.loadCollectedHistory(); break;
              }
            },
            async loadAllPackages(){
              this.allLoading = true;
              try{
                const resp = await axios.post('/Resident/GetAllPackages');
                this.allPackages = resp.data || [];
                this.pendingPackages = this.allPackages.filter(p => p.status == 0);
              }catch(e){ this.allPackages = []; this.pendingPackages = []; }
              finally{ this.allLoading = false; this.pendingLoading = false; }
            },
            async loadCollectedHistory(){
              this.historyLoading = true;
              try{
                const resp = await axios.post('/Resident/GetCollectedHistory');
                this.collectedHistory = resp.data || [];
              }catch(e){ this.collectedHistory = []; }
              finally{ this.historyLoading = false; }
            },
            formatDateTime(s){
              if(!s) return '-';
              const d = new Date(s);
              return d.toLocaleString('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});
            },
            calculateDays(createTime){
              if(!createTime) return 0;
              const diff = Math.abs(new Date() - new Date(createTime));
              return Math.ceil(diff / (1000*60*60*24));
            },
            // 查看包裹照片功能
                viewPackagePhoto(packageId) {
                console.log('查看包裹照片:', packageId);

                if (!packageId) {
                    alert('包裹編號不能為空');
                    return;
                }

                // 顯示載入狀態
                document.getElementById('photo-loading').style.display = 'block';
                document.getElementById('photo-gallery').innerHTML = '';
                document.getElementById('no-photos').style.display = 'none';
                document.getElementById('package-info').style.display = 'none';

                // 開啟模態視窗
                const modal = new bootstrap.Modal(document.getElementById('packagePhotoModal'));
                modal.show();

                // 模態視窗標題
                document.getElementById('packagePhotoModalLabel').innerHTML =
                    '<i class="bi bi-camera me-2"></i>包裹照片 - ' + packageId;

                // 呼叫 API
                axios.post('/Resident/GetPackagePhotos', {
                    packageId: packageId.toString()
                }, {
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(function(res) {
                    console.log('API 回應:', res.data); 

                    document.getElementById('photo-loading').style.display = 'none';

                    if (res.data && res.data.success) {
                        // 顯示包裹資訊
                        document.getElementById('package-info').style.display = 'block';
                        document.getElementById('modal-package-id').textContent = res.data.packageId || '-';
                        document.getElementById('modal-package-name').textContent = res.data.packageName || '-';
                        document.getElementById('modal-recipient').textContent =
                            (res.data.recipientName || '') + ' (' + (res.data.recipientId || '') + ')';
                        document.getElementById('modal-create-time').textContent = res.data.createTime || '-';
                        //  顯示照片
                        if (res.data.photos && res.data.photos.length > 0) {
                            let galleryHtml = res.data.photos.map(function(photoUrl, index) {
                                const isBase64 = photoUrl.startsWith('data:image/');
                                const photoType = isBase64 ? '系統照片' : '檔案照片';

                                return `
                                    <div class="photo-item mb-3" style="text-align:center;">
                                        <div style="position:relative; display:inline-block; max-width:100%;">
                                            <img src="${photoUrl}"
                                                 alt="包裹照片 ${index + 1}"
                                                 class="img-fluid rounded shadow"
                                                 style="max-width; height: 500px; cursor: zoom-in;
                                                        border: 2px solid #dee2e6; transition: all 0.3s ease;"
                                                 onclick="openFullscreen(this)"
                                                 onmouseover="this.style.borderColor='var(--primary-color)'; this.style.transform='scale(1.02)';"
                                                 onmouseout="this.style.transform=''; this.style.borderColor='#dee2e6';"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div style="display:none; flex-direction:column; align-items:center; justify-content:center;
                                                     width:750px;height:300px; color:#6c757d; background:#f8f9fa; border-radius:8px; border: 2px solid #dee2e6;">
                                                    <i class="bi bi-box-seam" style="font-size:60px; color:var(--resident-primary); margin-bottom:15px;
                                                       animation:packagePulse 2s ease-in-out infinite;"></i>
                                                    <p style="margin:0; font-size:14px;">照片載入失敗</p>
                                                </div>
                                            <div style="position:absolute; bottom:5px; left:5px; right:5px; background:rgba(0,0,0,0.7);
                                                 color:white; padding:6px 10px; border-radius:6px; text-align:center;">
                                                <small style="font-size:11px; font-weight:600;">${photoType} ${index + 1}</small>
                                            </div>
                                        </div>
                                    </div>`;
                            }).join('');

                            document.getElementById('photo-gallery').innerHTML = galleryHtml;
                        } else {
                            document.getElementById('no-photos').style.display = 'block';
                        }
                    } else {
                        console.error('API 回傳失敗:', res.data);
                        document.getElementById('no-photos').style.display = 'block';
                    }
                })
                .catch(function(error) {
                    console.error('載入包裹照片錯誤:', error);
                    document.getElementById('photo-loading').style.display = 'none';
                    document.getElementById('no-photos').style.display = 'block';

                    if (error.response) {
                        console.error('伺服器回應錯誤:', error.response.status, error.response.data);
                        alert('載入照片失敗：' + (error.response.data?.message || '伺服器錯誤'));
                    } else if (error.request) {
                        console.error('請求未收到回應:', error.request);
                        alert('載入照片失敗：無法連線到伺服器');
                    } else {
                        console.error('請求設定錯誤:', error.message);
                        alert('載入照片失敗：' + error.message);
                    }
                });
            },
            showMessage(msg,type){ alert((type==='success'?'✓ ':'✗ ')+msg); }
          }
        }).mount('#MyPackagesApp');
    </script>
}
