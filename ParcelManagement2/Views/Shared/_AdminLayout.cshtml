@{
    var date = DateTime.Now.ToString("MMdd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - 管理後台</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* B4CAFA 主題色系變數 */
        :root {
            --theme-primary: #B4CAFA;
            --theme-primary-dark: #8BB0F7;
            --theme-primary-light: #D6E5FD;
            --theme-secondary: #A8E6CF;
            --theme-accent: #6B8FF7;
            --theme-bg-main: linear-gradient(135deg, #F8FCFF 0%, #E8F4FD 100%);
            --theme-border: #A0BDF8;
            --theme-text-primary: #2C3E50;
            --theme-text-secondary: #5A6C7D;
            /* 功能色保持不變 */
            --status-pending: #dc3545;
            --status-collected: #28a745;
            --status-warning: #ffc107;
            --status-info: #17a2b8;
            --navbar-height: 56px;
            --content-padding: 18px;
            --card-radius: 8px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
        }

        body {
            background: var(--theme-bg-main);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            font-size: 14px;
            padding-top: var(--navbar-height);
            overflow-x: hidden;
            color: var(--theme-text-primary);
        }

        /* 導覽列樣式 */
        .navbar-admin {
            background: linear-gradient(90deg, var(--theme-primary), var(--theme-primary-dark));
            box-shadow: 0 2px 15px rgba(139, 176, 247, 0.3);
            height: var(--navbar-height);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            border: none;
            backdrop-filter: blur(10px);
        }

            .navbar-admin .container-fluid {
                height: 100%;
                padding: 0 var(--content-padding);
                max-width: none;
                display: flex;
                align-items: center;
            }

        .navbar-brand {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--theme-text-primary) !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
            margin-right: 20px;
            text-shadow: 0 1px 3px rgba(255, 255, 255, 0.3);
        }

            .navbar-brand:hover {
                color: white !important;
                transform: translateY(-1px);
            }

            .navbar-brand i {
                margin-right: 8px;
                font-size: 1.1rem;
            }

        .navbar-admin .nav-link {
            color: var(--theme-text-primary);
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin: 0 4px;
            display: flex;
            align-items: center;
            font-size: 13px;
            white-space: nowrap;
            border: 1px solid transparent;
        }

            .navbar-admin .nav-link:hover {
                background: rgba(255, 255, 255, 0.2);
                color: white;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(107, 143, 247, 0.3);
                border-color: rgba(255, 255, 255, 0.3);
            }

            .navbar-admin .nav-link.active,
            .navbar-admin .nav-link.current-page {
                background: var(--theme-accent);
                color: white;
                box-shadow: 0 3px 10px rgba(107, 143, 247, 0.4);
            }

            .navbar-admin .nav-link i {
                margin-right: 6px;
                font-size: 0.9rem;
            }

        .navbar-nav {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 4px;
            gap: 2px;
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            height: 44px;
        }

        .desktop-menu {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-left: auto;
            height: 100%;
        }
        .user-info {
            color: var(--theme-text-primary);
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            padding: 0 15px;
            margin-right: 0px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            height: 36px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

            .user-info i {
                margin-right: 6px;
                font-size: 1rem;
            }

        .btn-logout {
            background: transparent;
            border: 2px solid rgba(255, 255, 255, 0.8);
            color: white;
            font-weight: 600;
            padding: 8px 15px;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 12px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

            .btn-logout:hover {
                background: white;
                color: var(--theme-primary);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(255, 255, 255, 0.3);
            }

            .btn-logout i {
                margin-right: 4px;
                font-size: 0.9rem;
            }

        /* 手機版側邊選單 */
        .offcanvas-admin {
            background: linear-gradient(180deg, var(--theme-primary), var(--theme-primary-dark));
            width: 240px;
            border: none;
        }

            .offcanvas-admin .offcanvas-header {
                justify-content: space-between;
                padding: 18px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            }

            .offcanvas-admin .offcanvas-title {
                font-size: 1.1rem;
                font-weight: 700;
                color: white;
                display: flex;
                align-items: center;
            }

                .offcanvas-admin .offcanvas-title i {
                    margin-right: 8px;
                    font-size: 1.2rem;
                }

            .offcanvas-admin .nav-pills .nav-link {
                color: #1A2332; 
                font-weight: 500;
                padding: 12px 16px;
                margin: 3px 12px;
                border-radius: 8px;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                border: 1px solid transparent;
                font-size: 13px;
            }

                .offcanvas-admin .nav-pills .nav-link:hover {
                    background: rgba(255, 255, 255, 0.2);
                    color: white;
                    border-color: rgba(255, 255, 255, 0.2);
                    transform: translateX(4px);
                }

                .offcanvas-admin .nav-pills .nav-link.active,
                .offcanvas-admin .nav-pills .nav-link.current-page {
                    background: var(--theme-accent);
                    color: white;
                    border-color: var(--theme-accent);
                }

                .offcanvas-admin .nav-pills .nav-link i {
                    margin-right: 10px;
                    font-size: 1rem;
                    width: 18px;
                    text-align: center;
                }

        .offcanvas-user-info {
            color: #1A2332;
            font-size: 12px;
            font-weight: 500;
            padding: 12px 16px;
            margin: 8px 12px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            display: flex;
            align-items: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .offcanvas-user-info i {
                margin-right: 8px;
                font-size: 1.1rem;
            }

        .offcanvas-admin .btn-logout {
            margin: 12px;
            width: calc(100% - 24px);
            height: 40px;
            justify-content: center;
            display: flex;
            align-items: center;
        }

        /* 主要內容區域 */
        .main-content {
            padding: 0;
            margin: 0;
            background: var(--theme-bg-main);
            width: 100%;
            min-height: calc(100vh - var(--navbar-height));
        }

            .main-content .container-fluid {
                padding: var(--content-padding);
                margin: 0;
                max-width: none;
                width: 100%;
            }

        /* 卡片樣式 */
        .card-header {
            background: var(--theme-primary-light);
            border-bottom: 1px solid var(--theme-border);
            color: var(--theme-text-primary);
            font-weight: 600;
        }

        /* 響應式設計 */
        @@media (max-width: 768px) {
            .navbar-brand

        {
            font-size: 1.1rem;
            margin-right: 12px;
        }

        .navbar-admin .nav-link {
            padding: 6px 8px;
            font-size: 12px;
            margin: 0 2px;
        }

        .main-content .container-fluid {
            padding: 14px;
        }

        }

        @@media (max-width: 576px) {
            .navbar-brand

        {
            font-size: 1rem;
            margin-right: 8px;
        }

        .user-info {
            font-size: 11px;
            padding: 0 8px;
            margin-right: 8px;
        }

        .btn-logout {
            font-size: 11px;
            padding: 6px 8px;
        }

        .main-content .container-fluid {
            padding: 10px;
        }

        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <!-- 導覽列 -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Home/Index">
                <i class="bi bi-building"></i>
                社區包裹管理系統
            </a>

            <button class="navbar-toggler d-lg-none"
                    type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#adminMenu" aria-controls="adminMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="d-none d-lg-flex desktop-menu">
                <div class="user-info">
                    <i class="bi bi-person-circle"></i>
                    您好，@User.Identity.Name
                </div>

                <ul class="navbar-nav flex-row align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index" id="nav-index">
                            <i class="bi bi-graph-up"></i>總覽
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Packages" id="nav-packages">
                            <i class="bi bi-box-seam"></i>包裹
                        </a>
                    </li>
                </ul>

                <button id="btnLogoutLg" class="btn btn-logout">
                    <i class="bi bi-box-arrow-right"></i>登出
                </button>
            </div>
        </div>
    </nav>

    <!-- 手機版側邊選單 -->
    <div class="offcanvas offcanvas-start offcanvas-admin d-lg-none"
         tabindex="-1" id="adminMenu" aria-labelledby="adminMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="adminMenuLabel">
                <i class="bi bi-list"></i>功能選單
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="offcanvas-user-info">
                <i class="bi bi-person-circle"></i>
                您好，@User.Identity.Name
            </div>

            <ul class="nav nav-pills flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="/Home/Index" id="mobile-nav-index">
                        <i class="bi bi-graph-up"></i>總覽首頁
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Home/Packages" id="mobile-nav-packages">
                        <i class="bi bi-box-seam"></i>包裹管理
                    </a>
                </li>
            </ul>

            <button id="btnLogoutSm" class="btn btn-logout mt-3">
                <i class="bi bi-box-arrow-right"></i>登出系統
            </button>
        </div>
    </div>

    <!-- 主內容區域 -->
    <div class="main-content">
        @RenderBody()
    </div>

    @Html.AntiForgeryToken()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="~/Scripts/common-jwt.js"></script>

    <script>
        const doLogout = () => {
            if (confirm('確定要登出系統嗎？')) {
                axios.post('/Account/Logout').finally(() => {
                    localStorage.removeItem('jwt');
                    delete axios.defaults.headers.common.Authorization;
                    location.href = '/Account/Login';
                });
            }
        };

        document.getElementById('btnLogoutLg')?.addEventListener('click', doLogout);
        document.getElementById('btnLogoutSm')?.addEventListener('click', doLogout);

        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;

            if (currentPath.includes('/Home/Index')) {
                document.getElementById('nav-index')?.classList.add('current-page');
                document.getElementById('mobile-nav-index')?.classList.add('current-page');
            } else if (currentPath.includes('/Home/Packages')) {
                document.getElementById('nav-packages')?.classList.add('current-page');
                document.getElementById('mobile-nav-packages')?.classList.add('current-page');
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
