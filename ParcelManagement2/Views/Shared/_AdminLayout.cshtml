@{
    var date = DateTime.Now.ToString("MMdd");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - 管理後台</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --admin-primary: #3F9E95;
            --admin-secondary: #7FCFC3;
            --admin-primary-dark: #2F847C;
            --admin-accent: #CFC7BB;
            --admin-light: #9FB1B1;
            --cream: #F7F3EA;
            --border-color: #E7E3DA;
            --text: #1E2A2A;
            --card-radius: 14px;
            --navbar-h: 56px;
        }

        * {
            box-sizing: border-box
        }

        html, body {
            height: 100%
        }

        body {
            margin: 0;
            color: var(--text);
            background: linear-gradient(180deg,#F7FBFA 0%, #EEF7F6 100%);
            font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
            font-size: 14px;
            padding-top: var(--navbar-h);
            overflow-x: hidden;
        }

        /* 導覽列 */
        .navbar-admin {
            height: var(--navbar-h);
            background: linear-gradient(90deg,var(--admin-primary),var(--admin-secondary));
            border: 0;
            box-shadow: 0 2px 12px rgba(63,158,149,.15);
        }

            .navbar-admin .navbar-brand {
                font-weight: 800;
                color: #fff !important;
                display: flex;
                align-items: center;
                gap: .5rem;
            }

            .navbar-admin .nav-link {
                color: #fff;
                font-weight: 700;
                border-radius: 8px;
                padding: .5rem .75rem;
                margin: 0 .125rem;
                transition: .15s ease;
                opacity: .95;
            }

                .navbar-admin .nav-link:hover {
                    opacity: 1;
                    background: rgba(255,255,255,.12)
                }

                .navbar-admin .nav-link.current {
                    background: #ffffff24
                }

        .user-info {
            color: #fff;
            font-weight: 700;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: .4rem;
            padding: .35rem .6rem;
            border-radius: 8px;
            background: #ffffff22;
        }

        .btn-logout {
            color: #fff;
            border: 1px solid #fff;
            background: transparent;
            font-weight: 700;
            font-size: 12px;
            padding: .4rem .7rem;
            border-radius: 8px;
        }

            .btn-logout:hover {
                background: #fff;
                color: var(--admin-primary)
            }

        /* 手機側欄  */
        .offcanvas-admin {
            width: 248px;
            border: 0;
            background: linear-gradient(180deg,var(--admin-primary),var(--admin-primary-dark));
            color: #fff;
        }

            .offcanvas-admin .nav-link {
                color: #fff;
                font-weight: 700;
                border-radius: 10px
            }

                .offcanvas-admin .nav-link.current,
                .offcanvas-admin .nav-link:hover {
                    background: #ffffff26
                }

        /*   主內容   */
        .main-content {
            min-height: calc(100vh - var(--navbar-h))
        }

            .main-content .container-fluid {
                padding: 20px
            }
        .cream-card {
            background: linear-gradient(135deg,#FFFDF7 0%,var(--cream) 100%);
            border: 1px solid var(--border-color);
            border-radius: var(--card-radius);
        }

        /*   響應式   */
        @@media (max-width:992px) {
            .user-info

        {
            display: none
        }

        }
        /* 「目前頁面」狀態 */
        .navbar-admin .nav-link {
            position: relative;
            transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease, color .12s ease;
            border: 1px solid transparent;
        }

            .navbar-admin .nav-link:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(255,255,255,.22);
            }

            .navbar-admin .nav-link.current,
            .navbar-admin .nav-link[aria-current="page"] {
                background: #fff !important;
                color: var(--admin-primary) !important;
                border-color: #fff !important;
                box-shadow: 0 6px 18px rgba(255,255,255,.35), 0 2px 6px rgba(0,0,0,.08);
                transform: translateY(-1px);
            }

                .navbar-admin .nav-link.current::after,
                .navbar-admin .nav-link[aria-current="page"]::after {
                    content: "";
                    position: absolute;
                    left: 12px;
                    right: 12px;
                    bottom: -8px;
                    height: 4px;
                    background: #fff;
                    border-radius: 4px;
                }

        /*  手機側欄目前頁面（更明顯的白色 Pills）  */
        .offcanvas-admin .nav-link {
            transition: background-color .12s ease, color .12s ease, box-shadow .12s ease;
            border: 1px solid transparent;
        }

            .offcanvas-admin .nav-link.current,
            .offcanvas-admin .nav-link[aria-current="page"] {
                background: #fff !important;
                color: var(--admin-primary) !important;
                box-shadow: inset 0 0 0 2px #fff, 0 6px 16px rgba(0,0,0,.12);
                font-weight: 800;
            }

            .navbar-admin .nav-link:focus-visible,
            .offcanvas-admin .nav-link:focus-visible {
                outline: 2px solid #fff;
                outline-offset: 2px;
                box-shadow: 0 0 0 3px rgba(255,255,255,.35);
            }

    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <!-- 導覽列 -->
    <nav class="navbar navbar-expand-lg navbar-admin fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Home/Index">
                <i class="bi bi-building"></i> 社區包裹管理系統
            </a>

            <button class="navbar-toggler text-white border-0"
                    type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#adminMenu" aria-controls="adminMenu">
                <i class="bi bi-list" style="font-size:1.4rem;"></i>
            </button>

            <div class="d-none d-lg-flex align-items-center gap-2 ms-auto">
                <div class="user-info">
                    <i class="bi bi-person-circle"></i> 您好，@User.Identity.Name
                </div>
                <ul class="navbar-nav flex-row">
                    <li class="nav-item">
                        <a id="nav-index" class="nav-link" href="/Home/Index">
                            <i class="bi bi-graph-up"></i> 總覽
                        </a>
                    </li>
                    <li class="nav-item">
                        <a id="nav-packages" class="nav-link" href="/Home/Packages">
                            <i class="bi bi-box-seam"></i> 包裹
                        </a>
                    </li>
                </ul>
                <button id="btnLogoutLg" class="btn btn-logout">
                    <i class="bi bi-box-arrow-right"></i> 登出
                </button>
            </div>
        </div>
    </nav>

    <!-- 手機側邊選單 -->
    <div class="offcanvas offcanvas-start offcanvas-admin d-lg-none" tabindex="-1" id="adminMenu">
        <div class="offcanvas-header">
            <h6 class="m-0 fw-bold"><i class="bi bi-collection me-1"></i> 功能選單</h6>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <div class="mb-3 p-2 rounded-3" style="background:#ffffff22">
                <i class="bi bi-person-circle me-1"></i> 您好，@User.Identity.Name
            </div>
            <div class="nav flex-column gap-1">
                <a id="m-index" class="nav-link px-3 py-2" href="/Home/Index">
                    <i class="bi bi-graph-up me-1"></i> 總覽首頁
                </a>
                <a id="m-packages" class="nav-link px-3 py-2" href="/Home/Packages">
                    <i class="bi bi-box-seam me-1"></i> 包裹管理
                </a>
            </div>
            <hr class="border-white-25" />
            <button id="btnLogoutSm" class="btn btn-logout w-100">
                <i class="bi bi-box-arrow-right"></i> 登出系統
            </button>
        </div>
    </div>

    <!-- 主內容 -->
    <div class="main-content">
        @RenderBody()
    </div>

    @Html.AntiForgeryToken()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="~/Scripts/common-jwt.js"></script>

    <script>
        // 登出
        const doLogout = () => {
            if (confirm('確定要登出系統嗎？')) {
                axios.post('/Account/Logout').finally(() => {
                    localStorage.removeItem('jwt');
                    delete axios.defaults.headers.common.Authorization;
                    location.href = '/Account/Login';
                });
            }
        };
        document.getElementById('btnLogoutLg')?.addEventListener('click', doLogout);
        document.getElementById('btnLogoutSm')?.addEventListener('click', doLogout);

        // 目前頁籤高亮
        (function () {
            const p = location.pathname.toLowerCase();
            const add = id => {
              const el = document.getElementById(id);
              if(!el) return;
              el.classList.add('current');
              el.setAttribute('aria-current','page');
            };
            if (p.includes('/home/packages')) { add('nav-packages'); add('m-packages'); }
            else { add('nav-index'); add('m-index'); }
        })();
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
