@* Views/Shared/_ResidentLayout.cshtml *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - 住戶專區</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 核心樣式 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --resident-layout-primary: #B4CAFA;
            --resident-layout-secondary: #8BB0F7;
            --resident-layout-accent: #A8E6CF;
            --resident-layout-border: #A0BDF8;
            --resident-layout-bg: #F8FCFF;
            --text-primary: #2C3E50;
        }

        /* 住戶導航列 */
        .resident-navbar {
            background: linear-gradient(90deg, var(--resident-layout-primary), var(--resident-layout-secondary)) !important;
            border-bottom: 3px solid var(--resident-layout-accent);
            box-shadow: 0 4px 20px rgba(139, 176, 247, 0.2);
        }

            .resident-navbar .navbar-brand,
            .resident-navbar .nav-link {
                color: white !important;
                font-weight: 600;
                transition: all 0.3s ease;
            }

                .resident-navbar .nav-link:hover {
                    color: var(--resident-layout-accent) !important;
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 6px;
                    transform: translateY(-1px);
                }

                .resident-navbar .nav-link.active {
                    background: rgba(255, 255, 255, 0.2);
                    border-radius: 6px;
                }

        /* 主要內容背景 */
        .main-content {
            background: linear-gradient(135deg, var(--resident-layout-bg) 0%, #E8F4FD 100%);
            background-attachment: fixed;
            min-height: 100vh;
        }
    </style>

    <script>
        function handleResponsive() {
            const body = document.body;
            const width = window.innerWidth;

            body.classList.remove('mobile-responsive', 'small-responsive');

            if (width <= 576) {
                body.classList.add('small-responsive');
            } else if (width <= 768) {
                body.classList.add('mobile-responsive');
            }
        }

        window.addEventListener('load', handleResponsive);
        window.addEventListener('resize', handleResponsive);
    </script>


</head>
<body>
    <!-- 導覽列 -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-resident">
        <div class="container-fluid">
            <!-- Logo 和品牌名稱 -->
            <a class="navbar-brand" href="/Resident/Home">
                <i class="bi bi-house-heart"></i>
                住戶專區
            </a>

            <!-- 漢堡選單按鈕 (小螢幕) -->
            <button class="navbar-toggler d-lg-none"
                    type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#residentMenu" aria-controls="residentMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- 桌面版選單-->
            <div class="d-none d-lg-flex desktop-menu">
                <!-- 用戶資訊 -->
                <div class="user-info">
                    <i class="bi bi-person-circle"></i>
                    您好，@User.Identity.Name
                </div>

                <!-- 導航連結 -->
                <ul class="navbar-nav flex-row align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/Resident/Home" id="nav-home">
                            <i class="bi bi-house"></i>首頁
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Resident/MyPackages" id="nav-parcels">
                            <i class="bi bi-box-seam"></i>我的包裹
                        </a>
                    </li>
                </ul>

                <!-- 登出按鈕 -->
                <button id="btnLogoutLg" class="btn btn-logout">
                    <i class="bi bi-box-arrow-right"></i>登出
                </button>
            </div>
        </div>
    </nav>

    <!-- 行動側欄 -->
    <div class="offcanvas offcanvas-start offcanvas-resident d-lg-none"
         tabindex="-1" id="residentMenu" aria-labelledby="residentMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="residentMenuLabel">
                <i class="bi bi-list"></i>功能選單
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <!-- 用戶資訊 -->
            <div class="offcanvas-user-info">
                <i class="bi bi-person-circle"></i>
                您好，@User.Identity.Name
            </div>

            <!-- 導航選單 -->
            <ul class="nav nav-pills flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="/Resident/Home" id="mobile-nav-home">
                        <i class="bi bi-house"></i>住戶首頁
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Resident/MyPackages" id="mobile-nav-parcels">
                        <i class="bi bi-box-seam"></i>我的包裹
                    </a>
                </li>
            </ul>

            <!-- 登出按鈕 -->
            <button id="btnLogoutSm" class="btn btn-logout mt-3">
                <i class="bi bi-box-arrow-right"></i>登出
            </button>
        </div>
    </div>

    <!-- 主內容 -->
    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>

    @Html.AntiForgeryToken()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.8/dist/axios.min.js"></script>
    <script src="~/Scripts/common-jwt.js"></script>

    <script>
        // 登出
        function doLogout(){
            if(confirm('確定要登出嗎？')){
                axios.post('/Account/Logout').finally(()=>{
                    localStorage.removeItem('jwt');
                    delete axios.defaults.headers.common.Authorization;
                    location.href='/Account/Login';
                });
            }
        }
        document.getElementById('btnLogoutLg')?.addEventListener('click',doLogout);
        document.getElementById('btnLogoutSm')?.addEventListener('click',doLogout);
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
